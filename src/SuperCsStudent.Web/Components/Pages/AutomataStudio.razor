    private void BuildNfaFromSpec(bool updateSamples)
    {
        try
        {
            _nfaError = null;
            var alpha = ParseAlphabetInput(_nfaAlphabetText);
            if (_nfaSourceKind == "constraint")
            {
                var compiled = LanguageSpecCompiler.CompileConstraintToNfa(_nfaSpecText, alpha);
                _currentNfa = compiled.Nfa;
                _nfaRequiredDeterminization = compiled.RequiredDeterminization;
                _nfaDeterminizationReason = compiled.DeterminizationReason;
                if (updateSamples)
                {
                    var specRes = LanguageSpecCompiler.CompileConstraint(_nfaSpecText, alpha);
                    ApplyNfaSuggestedSamples(specRes.SuggestedTests);
                }
            }
            else if (_nfaSourceKind == "regex")
            {
                var compiled = RegexCompiler.Compile(_nfaSpecText, alpha);
                _currentNfa = compiled.Nfa.CompactLiteralChains();
                _nfaRequiredDeterminization = false;
                _nfaDeterminizationReason = null;
                if (updateSamples)
                {
                    var specRes = LanguageSpecCompiler.CompileRegex(_nfaSpecText, alpha);
                    ApplyNfaSuggestedSamples(specRes.SuggestedTests);
                }
            }
            else
            {
                var compiled = LanguageSpecCompiler.Compile(_nfaSpecText, LanguageSpecMode.Auto, alpha);
                if (compiled.Nfa is null)
                {
                    _nfaError = $"'{_nfaSpecText}' is {compiled.LanguageClass} (not regular). Switch to CFG, PDA, or Turing Machine to synthesize it.";
                    return;
                }
                _currentNfa = compiled.ResolvedMode == LanguageSpecMode.Regex
                    ? compiled.Nfa.CompactLiteralChains()
                    : compiled.Nfa;
                _nfaRequiredDeterminization = compiled.NfaRequiredDeterminization;
                _nfaDeterminizationReason = compiled.NfaDeterminizationReason;
                if (updateSamples)
                {
                    ApplyNfaSuggestedSamples(compiled.SuggestedTests);
                }
            }

            RefreshNfaSubsetAndTrace();
        }
        catch (Exception ex)
        {
            _nfaError = ex.Message;
        }
    }

    private void ApplyNfaSuggestedSamples(IReadOnlyList<LanguageTestCase>? tests)
    {
        var samples = ExtractSampleInputs(tests);
        if (samples is not null)
        {
            _nfaSampleInputs = samples;
        }
        if (_currentNfa is not null && !InputFitsAlphabet(_nfaInput, _currentNfa.Alphabet))
        {
            var preferred = PickPreferredInput(tests);
            if (preferred is not null)
            {
                _nfaInput = preferred;
            }
        }
    }

