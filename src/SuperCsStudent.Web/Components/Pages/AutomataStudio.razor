        if (ex is null) return;

        CancelDebounce(ref _tmDebounceCts);
        _tmExampleKey = ex.Key;
        _tmSynthError = null;
        _tmHeadStart = HeadStartMode.RightBlank;

        string title = $"TM: {ex.Label}";
        string desc = ex.Description ?? ex.Label;

        if (!string.IsNullOrWhiteSpace(ex.PresetKey) && AutomataPresets.ByKey.TryGetValue(ex.PresetKey, out var preset))
        {
            _tmDslText = preset.TmSchemaText ?? _tmDslText;
            _tmInput = preset.DefaultInput;
            _tmSampleInputs = preset.SampleInputs;
            _tmSynthSpec = string.Empty;
            title = preset.Title;
            desc = preset.Description;
        }
        else if (!string.IsNullOrWhiteSpace(ex.SynthSpec))
        {
            var compiled = LanguageSpecCompiler.Compile(ex.SynthSpec, LanguageSpecMode.Auto);
            _tmDslText = compiled.TmSchema.ToDslText();
            _tmHeadStart = compiled.TmSchema.HeadStart;
            _tmSynthSpec = ex.SynthSpec;
            _tmInput = ex.DefaultInput ?? PickPreferredInput(compiled.SuggestedTests) ?? "abba";
            _tmSampleInputs = ex.Samples ?? ExtractSampleInputs(compiled.SuggestedTests) ?? [_tmInput, "e"];
        }

        CompileAndRunTmDsl();

        if (recordRecent)
        {
            RecordExampleRecent(ex.Key, title, desc);
        }
    }

