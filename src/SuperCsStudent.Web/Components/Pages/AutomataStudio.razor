                            <div class="flex flex-wrap items-center gap-2">
                                <input type="text"
                                       class="bp-input !h-8 font-mono text-xs flex-1 min-w-[200px]"
                                       placeholder="e.g. a^n b^m c^k where n + m = k | invert 0 and 1 | XOR | does not contain abc"
                                       aria-label="Specification to synthesize Turing Machine"
                                       @bind="_tmSynthSpec"
                                       @bind:event="oninput"
                                       @onkeydown="OnTmSynthKeyDown" />
                                <input type="text"
                                       class="bp-input !h-8 font-mono text-xs w-40"
                                       placeholder="Σ auto (e.g. x,y,z)"
                                       title="Custom alphabet symbols (leave blank to auto-detect)"
                                       aria-label="Custom alphabet symbols"
                                       @bind="_tmSynthAlphabet"
                                       @bind:event="oninput"
                                       @onkeydown="OnTmSynthKeyDown" />
                                <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="SynthesizeCustomTm">Synthesize TM</button>

                                <label class="flex items-center gap-1.5 text-xs shrink-0" style="color: var(--muted);">
                                    <span>Head start</span>
                                    <select class="bp-input !h-8 text-xs"
                                            title="Initial tape head position on #w#"
                                            value="@_tmHeadStart"
                                            @onchange="OnTmHeadStartChanged">
                                        <option value="@HeadStartMode.RightBlank">Right # (#w[#])</option>
                                        <option value="@HeadStartMode.FirstSymbol">First Cell (#[w]#)</option>
                                        <option value="@HeadStartMode.LeftBlank">Left # ([#]w#)</option>
                                    </select>
                                </label>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_tmSynthError))
                            {
                                <div class="text-xs px-2.5 py-1.5 rounded-md" style="background: var(--pill-negative-bg); color: var(--pill-negative-ink);">
                                    @_tmSynthError
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Interactive Horizontal Semi-Infinite Tape Strip (with Macro/Micro toggle) *@
                @{
                    var tapeInfo = CurrentTmTapeSnapshot;
                }
                <div class="bp-card px-3 py-2.5 shrink-0 space-y-2">
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="bp-pill bp-pill-accent font-mono">@tapeInfo.StateLabel</span>
                            <span class="font-medium truncate">@tapeInfo.Summary</span>
                        </div>
                        <div class="flex items-center gap-2.5 shrink-0">
                            <span class="font-mono text-[11px] tnum" style="color: var(--muted);">Head cell: @tapeInfo.HeadIndex</span>
                            <div class="bp-seg" role="group" aria-label="Turing machine trace granularity">
                                <button type="button"
                                        class="bp-seg-btn !h-6 !text-[11px]"
                                        data-active="@(!_tmMicroMode ? "true" : "false")"
                                        @onclick="() => SwitchTmGranularity(false)">
                                    Macro (@(_tmTrace?.MacroTimeline.Steps.Count ?? 0))
                                </button>
                                <button type="button"
                                        class="bp-seg-btn !h-6 !text-[11px]"
                                        data-active="@(_tmMicroMode ? "true" : "false")"
                                        @onclick="() => SwitchTmGranularity(true)">
                                    Micro (@(_tmTrace?.MicroTrace.Count ?? 0))
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-end gap-1 overflow-x-auto pb-1">
                        @for (var c = 0; c < tapeInfo.Tape.Length; c++)
                        {
                            var isHead = c == tapeInfo.HeadIndex;
                            var ch = tapeInfo.Tape[c];
                            <div class="flex flex-col items-center shrink-0">
                                <span class="text-[9px] font-mono tnum mb-0.5"
                                      style="@(isHead ? "color: var(--accent); font-weight: 700;" : "color: var(--faint);")">
                                    @(isHead ? "▼" : c.ToString())
                                </span>
                                <div class="w-8 h-8 rounded flex items-center justify-center font-mono text-sm font-semibold transition-colors"
                                     style="@(isHead
                                         ? "background: var(--accent-soft); color: var(--accent); border: 2px solid var(--accent);"
                                         : ch == '#'
                                             ? "background: var(--raised); color: var(--faint); border: 1px solid var(--border);"
                                             : "background: var(--surface); color: var(--text); border: 1px solid var(--control);")">
                                    @ch
                                </div>
                                <span class="text-[9px] font-mono tnum mt-0.5" style="color: var(--faint);">@c</span>
                            </div>
                        }
                    </div>
                </div>

                @* Schema Diagram Canvas *@
                <div class="flex-1 min-h-[220px]">
                    <InteractiveSvgCanvas Scene="@CurrentTmScene"
                                          SnapMotion="@AppState.SnapMotion"
                                          ErrorBanner="@_tmError"
                                          ExportFileName="tm-schema.svg" />
                </div>

                <PlaybackBar CurrentStep="@_tmStepIndex"
                             TotalSteps="@CurrentTmTotalSteps"
                             CurrentStepChanged="i => _tmStepIndex = i"
                             SnapMotion="@AppState.SnapMotion"
                             SnapMotionChanged="v => { AppState.SnapMotion = v; AppState.Notify(); }" />
            </div>

            @* Right Inspector: Trace Table | Schema DSL Editor | Formal δ Quadruple Table *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[430px] xl:w-[470px] min-w-0 shrink-0 flex flex-col min-h-0")" style="border-left: 1px solid var(--border);">
                <div class="flex items-center px-3 shrink-0" style="border-bottom: 1px solid var(--border);">
                    <button type="button" class="bp-tab" data-active="@(_tmRightTab == "trace" ? "true" : "false")" @onclick='() => _tmRightTab = "trace"'>@(_tmMicroMode ? "Micro Trace" : "Macro Trace")</button>
                    <button type="button" class="bp-tab" data-active="@(_tmRightTab == "dsl" ? "true" : "false")" @onclick='() => _tmRightTab = "dsl"'>Schema DSL</button>
                    <button type="button" class="bp-tab" data-active="@(_tmRightTab == "table" ? "true" : "false")" @onclick='() => _tmRightTab = "table"'>Formal δ Table</button>
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3">
                    @if (_tmRightTab == "trace" && _tmTrace is not null)
                    {
                        @if (!_tmMicroMode)
                        {
                            <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                <table class="w-full text-[11px] text-left">
                                    <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                        <tr>
                                            <th class="px-2 py-1.5 font-semibold">#</th>
                                            <th class="px-2 py-1.5 font-semibold">Node</th>
                                            <th class="px-2 py-1.5 font-semibold">Tape</th>
                                            <th class="px-2 py-1.5 font-semibold">Head</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < _tmTrace.MacroTimeline.Steps.Count; i++)
                                        {
                                            var idx = i;
                                            var st = _tmTrace.MacroTimeline.Steps[idx];
                                            var isCur = idx == _tmStepIndex;
                                            <tr class="cursor-pointer transition-colors"
                                                style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "") border-bottom: 1px solid var(--rule);"
                                                @onclick="() => _tmStepIndex = idx">
                                                <td class="px-2 py-1.5 font-mono tnum">@idx</td>
                                                <td class="px-2 py-1.5 font-mono font-semibold">@st.State.CurrentNodeLabel</td>
                                                <td class="px-2 py-1.5 font-mono">@st.State.Tape</td>
                                                <td class="px-2 py-1.5 font-mono tnum">@st.State.HeadIndex</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                <table class="w-full text-[11px] text-left">
                                    <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                        <tr>
                                            <th class="px-2 py-1.5 font-semibold">#</th>
                                            <th class="px-2 py-1.5 font-semibold">Config (q, tape)</th>
                                            <th class="px-2 py-1.5 font-semibold">Transition</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < _tmTrace.MicroTrace.Count; i++)
                                        {
                                            var idx = i;
                                            var ms = _tmTrace.MicroTrace[idx];
                                            var isCur = idx == _tmStepIndex;
                                            <tr class="cursor-pointer transition-colors"
                                                style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "") border-bottom: 1px solid var(--rule);"
                                                @onclick="() => _tmStepIndex = idx">
                                                <td class="px-2 py-1.5 font-mono tnum">@ms.Step</td>
                                                <td class="px-2 py-1.5 font-mono whitespace-nowrap">@ms.ConfigString</td>
                                                <td class="px-2 py-1.5 font-mono whitespace-nowrap" style="color: var(--muted);">@ms.TransitionText</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (_tmRightTab == "dsl")
                    {
                        <div class="bp-card p-3 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold">Composable Machine-Schema DSL</span>
                                <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="ApplyCustomTmDsl">Compile &amp; Run</button>
                            </div>
                            <textarea class="bp-textarea w-full text-xs" rows="13" @bind="_tmDslText"></textarea>
                            <div class="text-[11px] space-y-1 pt-1" style="color: var(--muted);">
                                <div><strong>Primitives &amp; Macros:</strong> <code>L</code>, <code>R</code>, <code>L_#</code>, <code>R_#</code>, <code>S_L</code> (Shift Left), <code>S_R</code> (Shift Right), <code>E</code> (Erase left), <code>C</code> (Copy), <code>Y</code> (write y), <code>N</code> (write n), or any bare symbol like <code>#</code>, <code>a</code>, <code>X</code>.</div>
                                <div><strong>Routing Edges:</strong> <code>from -&gt; to : a, b</code>, <code>~#</code>, <code>other</code>, or unlabeled wildcard <code>from -&gt; to</code>.</div>
                            </div>
                        </div>
                    }
                    else if (_tmRightTab == "table" && _tmCompiled is not null)
                    {
                        var m = _tmCompiled.Machine;
                        <div class="bp-card p-2.5 flex flex-wrap items-center justify-between gap-2 text-xs">
                            <div class="font-mono text-[11px]" style="color: var(--muted);">
                                <strong>|K|</strong>=@m.States.Count · <strong>Σ</strong>={@string.Join(",", m.OrderedTapeAlphabet)} · <strong>s</strong>=@m.StartState · <strong>h</strong>=@m.HaltState
                            </div>
                            <button type="button" class="bp-btn-secondary !h-7 !px-2 text-xs" @onclick="ExportTmTable">Export TXT</button>
                        </div>

                        <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                            <table class="w-full text-[11px] text-left font-mono">
                                <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                    <tr>
                                        <th class="px-2 py-1.5">q</th>
                                        @foreach (var sym in m.OrderedTapeAlphabet)
                                        {
                                            <th class="px-2 py-1.5">@sym</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var q in m.OrderedStates)
                                    {
                                        if (q == m.HaltState) continue;
                                        var activeMicroState = _tmMicroMode && _tmTrace is not null && _tmStepIndex < _tmTrace.MicroTrace.Count
                                            ? _tmTrace.MicroTrace[_tmStepIndex].State
                                            : null;
                                        <tr style="@(activeMicroState == q ? "background: var(--accent-soft);" : "") border-bottom: 1px solid var(--rule);">
                                            <td class="px-2 py-1 font-semibold">@q</td>
                                            @foreach (var sym in m.OrderedTapeAlphabet)
                                            {
                                                var cell = m.Transitions.TryGetValue((q, sym), out var tr)
                                                    ? $"({tr.NextState}, {tr.Action})"
                                                    : "—";
                                                <td class="px-2 py-1 whitespace-nowrap">@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

