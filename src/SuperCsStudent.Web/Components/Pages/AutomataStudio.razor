    protected override void OnInitialized()
    {
        // Pre-initialize all 5 workbenches silently so tab switching is instant
        SelectNfaExample("nfa-starts-aba", recordRecent: false);
        SelectCfgExample("cfg-arith", recordRecent: false);
        SelectPdaExample("pda-anbn", recordRecent: false);
        SelectTmExample("tm-palindrome", recordRecent: false);
        SelectDfaExample("dfa-contains-aba", recordRecent: false);
        _activeMode = StudioMode.Dfa;

        // Consume any navigation target from Home or Command Palette; otherwise default to DFA
        if (!ConsumePendingNavigationState())
        {
            RecordExampleRecent("dfa-contains-aba", "DFA: Contains Substring 'aba'", "Minimal 4-state DFA accepting strings over {a, b} containing 'aba'.");
        }

        AppState.OnChange += OnAppStateChanged;
    }

    public void Dispose()
    {
        _disposed = true;
        AppState.OnChange -= OnAppStateChanged;
        CancelDebounce(ref _cfgDebounceCts);
        CancelDebounce(ref _pdaDebounceCts);
        CancelDebounce(ref _tmDebounceCts);
    }

    private void OnAppStateChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            ConsumePendingNavigationState();
            StateHasChanged();
        });
    }

    private bool ConsumePendingNavigationState()
    {
        var pendingSpec = AppState.PendingAutomataSpec;
        var pendingAlpha = AppState.PendingAutomataAlphabet;
        var pendingKey = AppState.PendingPresetKey;

        if (string.IsNullOrWhiteSpace(pendingSpec) && string.IsNullOrWhiteSpace(pendingKey))
        {
            return false;
        }

        AppState.PendingAutomataSpec = null;
        AppState.PendingAutomataAlphabet = null;
        AppState.PendingPresetKey = null;

        if (!string.IsNullOrWhiteSpace(pendingSpec))
        {
            RoutePendingSpec(pendingSpec, pendingAlpha);
            return true;
        }

        if (!string.IsNullOrWhiteSpace(pendingKey))
        {
            LoadPresetKey(pendingKey, recordRecent: true);
            return true;
        }

        return false;
    }

