    private static IEnumerable<char>? ParseAlphabetInput(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var chars = new List<char>();
        foreach (var token in raw.Split(new[] { ',', ' ', ';', '\t', '{', '}' }, StringSplitOptions.RemoveEmptyEntries))
        {
            foreach (var ch in token.Trim())
            {
                if (!chars.Contains(ch))
                {
                    chars.Add(ch);
                }
            }
        }
        return chars.Count > 0 ? chars : null;
    }

    private static IReadOnlyList<string>? ExtractSampleInputs(IReadOnlyList<LanguageTestCase>? tests)
    {
        if (tests is not { Count: > 0 }) return null;
        var list = tests.Select(t => t.Input).Distinct(StringComparer.Ordinal).Take(6).ToArray();
        return list.Length > 0 ? list : null;
    }

    private static string? PickPreferredInput(IReadOnlyList<LanguageTestCase>? tests)
    {
        if (tests is not { Count: > 0 }) return null;
        var preferred = tests.FirstOrDefault(t => t.ExpectedAccept && t.Input != "e" && t.Input.Length >= 2)
            ?? tests.FirstOrDefault(t => t.ExpectedAccept)
            ?? tests[0];
        return preferred.Input;
    }

    private static bool InputFitsAlphabet(string? input, IReadOnlySet<char> alphabet)
    {
        var normalized = AutomataSymbols.NormalizeWord(input, alphabet);
        return normalized.All(alphabet.Contains);
    }

    private static void CancelDebounce(ref CancellationTokenSource? slot)
    {
        var existing = Interlocked.Exchange(ref slot, null);
        if (existing is not null)
        {
            try { existing.Cancel(); } catch { }
            existing.Dispose();
        }
    }

    private void ScheduleDebounced(ref CancellationTokenSource? slot, Action work)
    {
        CancelDebounce(ref slot);
        var cts = new CancellationTokenSource();
        slot = cts;
        var token = cts.Token;
        _ = RunDebouncedAsync(token, work);
    }

    private async Task RunDebouncedAsync(CancellationToken token, Action work)
    {
        try
        {
            await Task.Delay(120, token);
            if (token.IsCancellationRequested || _disposed) return;
            await InvokeAsync(() =>
            {
                if (token.IsCancellationRequested || _disposed) return;
                work();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

