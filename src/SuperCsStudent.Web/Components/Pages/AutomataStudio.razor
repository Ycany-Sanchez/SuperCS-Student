@page "/automata"
@inject AppStateService AppState
@inject IJSRuntime JS

@using System.Text.Json
@using SuperCsStudent.Automata
@using SuperCsStudent.Automata.FiniteAutomata
@using SuperCsStudent.Automata.Grammars
@using SuperCsStudent.Automata.Pda
@using SuperCsStudent.Automata.Presets
@using SuperCsStudent.Automata.Synthesis
@using SuperCsStudent.Automata.Turing

<div class="flex flex-col h-full min-h-0 min-w-0 w-full overflow-hidden">
    @* Studio Header Bar *@
    <div class="px-4 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0" style="border-bottom: 1px solid var(--border);">
        <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-[15px] font-semibold tracking-tight whitespace-nowrap">Automata &amp; Formal Languages</h1>

            <div class="bp-seg flex-wrap" role="tablist" aria-label="Automata studio mode">
                @foreach (var tab in StudioTabs)
                {
                    var active = _activeMode == tab.Mode;
                    <button type="button"
                            class="bp-seg-btn"
                            data-active="@(active ? "true" : "false")"
                            @onclick="() => SwitchMode(tab.Mode)">
                        @tab.Label
                    </button>
                }
            </div>
        </div>

        <div class="flex items-center gap-2">
            <select class="bp-input !h-8 text-xs max-w-[240px]"
                    aria-label="Select automata preset"
                    value="@_selectedPresetKey"
                    @onchange="OnPresetChanged">
                @foreach (var grp in AutomataPresets.All.GroupBy(p => p.Kind))
                {
                    <optgroup label="@FormatPresetGroup(grp.Key)">
                        @foreach (var p in grp)
                        {
                            <option value="@p.Key">@p.Title</option>
                        }
                    </optgroup>
                }
            </select>

            <button type="button"
                    class="bp-btn-ghost !h-8 !px-2 text-xs hidden lg:inline-flex"
                    title="@(_inspectorCollapsed ? "Show inspector panel" : "Hide inspector for full-bleed canvas")"
                    aria-label="@(_inspectorCollapsed ? "Show inspector panel" : "Hide inspector panel")"
                    @onclick="() => _inspectorCollapsed = !_inspectorCollapsed">
                @(_inspectorCollapsed ? "Show panel" : "Full canvas")
            </button>
        </div>
    </div>

    @* ===================================================================== *@
    @* MODE 1: DETERMINISTIC FORMAL LANGUAGE SPECIFICATION COMPILER          *@
    @* ===================================================================== *@
    @if (_activeMode == StudioMode.Compiler)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left: Spec Input + Compiled Diagram Preview *@
            <div class="shrink-0 lg:shrink lg:flex-1 min-w-0 lg:min-h-0 flex flex-col p-3 gap-2.5 lg:overflow-hidden">
                <div class="bp-card p-3 space-y-2.5 shrink-0">
                    <div class="flex flex-wrap items-center gap-2">
                        <select class="bp-input !h-8 text-xs"
                                value="@_specMode"
                                @onchange="e => _specMode = Enum.Parse<LanguageSpecMode>(e.Value!.ToString()!)">
                            <option value="@LanguageSpecMode.Auto">Auto-Detect</option>
                            <option value="@LanguageSpecMode.Regex">Regex</option>
                            <option value="@LanguageSpecMode.Constraint">Boolean Constraint</option>
                            <option value="@LanguageSpecMode.Parametric">Parametric CFL / TM</option>
                        </select>

                        <input type="text"
                               class="bp-input !h-8 font-mono text-xs flex-1 min-w-[220px]"
                               placeholder="e.g. a^n b^m where n > m | a^n b^m c^k where n + m = k | does not contain abc | (x|y)*z+"
                               @bind="_specText"
                               @bind:event="oninput"
                               @onkeydown="OnSpecKeyDown" />

                        <input type="text"
                               class="bp-input !h-8 font-mono text-xs w-36"
                               placeholder="Σ auto (e.g. x,y,z)"
                               title="Custom alphabet symbols (e.g. x,y,z or 0,1 — leave blank to auto-detect)"
                               @bind="_specAlphabetText" />

                        <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="CompileSpec">
                            Compile
                        </button>

                        <button type="button"
                                class="bp-btn-secondary !h-8 text-xs"
                                aria-expanded="@_showCustomBuilder"
                                @onclick="() => _showCustomBuilder = !_showCustomBuilder">
                            @(_showCustomBuilder ? "Hide Builder" : "+ Custom Builder")
                        </button>
                    </div>

                    @if (_showCustomBuilder)
                    {
                        <div class="p-2.5 rounded-lg space-y-2" style="background: var(--raised); border: 1px solid var(--border);">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-[11px] font-semibold" style="color: var(--muted);">Pattern</span>
                                    <div class="bp-seg">
                                        <button type="button" class="bp-seg-btn" data-active="@(_builderTemplate == "2block" ? "true" : "false")" @onclick='() => SetBuilderTemplate("2block")'>s₁ⁿ s₂ᵐ</button>
                                        <button type="button" class="bp-seg-btn" data-active="@(_builderTemplate == "3block" ? "true" : "false")" @onclick='() => SetBuilderTemplate("3block")'>s₁ⁿ s₂ᵐ s₃ᵏ</button>
                                        <button type="button" class="bp-seg-btn" data-active="@(_builderTemplate == "count" ? "true" : "false")" @onclick='() => SetBuilderTemplate("count")'>#s₁ vs #s₂</button>
                                    </div>

                                    <label class="flex items-center gap-1 text-[11px]" style="color: var(--muted);">
                                        <span>Symbols</span>
                                        <input type="text"
                                               class="bp-input !h-7 font-mono text-xs w-24"
                                               placeholder="a,b"
                                               @bind="_builderSymbols"
                                               @bind:event="oninput" />
                                    </label>
                                </div>

                                <div class="flex items-center gap-1.5">
                                    <code class="px-2 py-1 rounded text-[11px] font-mono" style="background: var(--surface); border: 1px solid var(--border); color: var(--accent);">
                                        @BuildCustomSpecPreview()
                                    </code>
                                    <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="ApplyCustomBuilder">
                                        Build &amp; Compile
                                    </button>
                                </div>
                            </div>

                            @if (_builderTemplate == "3block")
                            {
                                <div class="flex flex-wrap items-center gap-1.5">
                                    <span class="text-[11px] font-medium" style="color: var(--faint);">Condition:</span>
                                    @foreach (var rel in ThreeBlockBuilderRelations)
                                    {
                                        <button type="button"
                                                class="bp-chip font-mono"
                                                style="@(_builderThreeRel == rel.Expr ? "background: var(--accent-soft); color: var(--accent); border-color: var(--accent);" : "")"
                                                @onclick="() => _builderThreeRel = rel.Expr">
                                            @rel.Label
                                        </button>
                                    }
                                    <div class="bp-seg ml-1">
                                        <button type="button" class="bp-seg-btn" data-active="@(_builderMinBound == 0 ? "true" : "false")" @onclick="() => _builderMinBound = 0">≥ 0</button>
                                        <button type="button" class="bp-seg-btn" data-active="@(_builderMinBound == 1 ? "true" : "false")" @onclick="() => _builderMinBound = 1">≥ 1</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="flex flex-wrap items-center gap-2">
                                    <span class="text-[11px] font-medium" style="color: var(--faint);">Relation:</span>
                                    <div class="bp-seg">
                                        @foreach (var op in BuilderOps)
                                        {
                                            <button type="button"
                                                    class="bp-seg-btn font-mono"
                                                    data-active="@(_builderOp == op ? "true" : "false")"
                                                    @onclick="() => _builderOp = op">@op</button>
                                        }
                                    </div>

                                    <span class="text-[11px] font-medium" style="color: var(--faint);">Scale:</span>
                                    <div class="bp-seg">
                                        @foreach (var mult in new[] { 1, 2, 3 })
                                        {
                                            <button type="button"
                                                    class="bp-seg-btn font-mono"
                                                    data-active="@(_builderMultiplier == mult ? "true" : "false")"
                                                    @onclick="() => _builderMultiplier = mult">@($"{mult}×")</button>
                                        }
                                    </div>

                                    <span class="text-[11px] font-medium" style="color: var(--faint);">Offset:</span>
                                    <div class="bp-seg">
                                        @foreach (var off in new[] { -1, 0, 1 })
                                        {
                                            <button type="button"
                                                    class="bp-seg-btn font-mono"
                                                    data-active="@(_builderOffset == off ? "true" : "false")"
                                                    @onclick="() => _builderOffset = off">@(off > 0 ? $"+{off}" : off.ToString())</button>
                                        }
                                    </div>

                                    @if (_builderTemplate == "2block")
                                    {
                                        <span class="text-[11px] font-medium" style="color: var(--faint);">Min:</span>
                                        <div class="bp-seg">
                                            <button type="button" class="bp-seg-btn" data-active="@(_builderMinBound == 0 ? "true" : "false")" @onclick="() => _builderMinBound = 0">≥ 0</button>
                                            <button type="button" class="bp-seg-btn" data-active="@(_builderMinBound == 1 ? "true" : "false")" @onclick="() => _builderMinBound = 1">≥ 1</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] font-medium" style="color: var(--faint);">Examples:</span>
                        @foreach (var ex in CompilerExamples)
                        {
                            <button type="button"
                                    class="px-2 h-6 rounded text-[11px] font-mono cursor-pointer transition-colors"
                                    style="background: var(--raised); color: var(--muted); border: 1px solid var(--border);"
                                    @onclick="() => RunCompilerExample(ex.Spec, ex.SampleInput)">
                                @ex.Label
                            </button>
                        }
                    </div>
                </div>

                @if (_compiledSpec is not null)
                {
                    <div class="flex flex-wrap items-center justify-between gap-2 shrink-0 px-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="bp-pill bp-pill-accent text-[11px]">@_compiledSpec.LanguageClass</span>
                            <span class="text-xs font-semibold">@_compiledSpec.Title</span>
                            <span class="text-xs hidden xl:inline" style="color: var(--muted);">— @_compiledSpec.Description</span>
                        </div>

                        <div class="flex items-center gap-1.5 flex-wrap">
                            <div class="flex items-center rounded-md p-0.5" style="background: var(--raised); border: 1px solid var(--border);">
                                @if (_compiledSpec.MinimalDfa is not null)
                                {
                                    <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                            style="@(_compilerPreviewKind == "dfa" ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                            @onclick='() => _compilerPreviewKind = "dfa"'>Min DFA (@_compiledSpec.MinimalDfa.States.Count)</button>
                                }
                                @if (_compiledSpec.Nfa is not null)
                                {
                                    <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                            style="@(_compilerPreviewKind == "nfa" ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                            @onclick='() => _compilerPreviewKind = "nfa"'>
                                        @(_compiledSpec.NfaRequiredDeterminization ? $"NFA → DFA ({_compiledSpec.Nfa.States.Count})" : $"NFA ({_compiledSpec.Nfa.States.Count})")
                                    </button>
                                }
                                @if (_compiledSpec.Grammar is not null)
                                {
                                    <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                            style="@(_compilerPreviewKind == "cfg-queue" ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                            @onclick='() => _compilerPreviewKind = "cfg-queue"'>CFG Queue</button>
                                }
                                @if (_compiledSpec.Pda is not null)
                                {
                                    <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                            style="@(_compilerPreviewKind == "pda-stack" ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                            @onclick='() => _compilerPreviewKind = "pda-stack"'>PDA Stack</button>
                                }
                                <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                        style="@(_compilerPreviewKind == "tm" ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                        @onclick='() => _compilerPreviewKind = "tm"'>TM Schema (@_compiledSpec.TmSchema.Nodes.Count)</button>
                            </div>
                        </div>
                    </div>
                }

                <div class="flex-1 min-h-[280px] min-w-0 flex flex-col gap-2 overflow-hidden">
                    @if (_compilerPreviewKind == "nfa" && _compiledSpec?.NfaRequiredDeterminization == true)
                    {
                        <div class="px-3 py-2 rounded-lg text-xs shrink-0 flex flex-wrap items-center justify-between gap-2"
                             style="background: var(--pill-warning-bg); color: var(--pill-warning-ink); border: 1px solid var(--warning);">
                            <span><strong>Determinized to DFA:</strong> @_compiledSpec.NfaDeterminizationReason</span>
                            <button type="button" class="bp-btn-secondary !h-6 text-[11px]" @onclick="OpenCompiledInDfa">Open in DFA Studio →</button>
                        </div>
                    }

                    @if (_compilerPreviewKind == "pda-stack" && _compilerPdaTrace is not null)
                    {
                        <div class="flex-1 min-h-0 bp-card p-3 overflow-hidden">
                            <PdaStackVisualizer Trace="@_compilerPdaTrace"
                                                @bind-CurrentStepIndex="_compilerPdaStepIndex"
                                                ShowCompactStepControls="true"
                                                SnapMotion="@AppState.SnapMotion" />
                        </div>
                    }
                    else if (_compilerPreviewKind == "cfg-queue" && _compilerCfgResult is not null)
                    {
                        <div class="flex-1 min-h-0 bp-card p-3 overflow-hidden">
                            <CfgQueueVisualizer Result="@_compilerCfgResult"
                                                @bind-CurrentStepIndex="_compilerCfgStepIndex"
                                                ShowCompactStepControls="true"
                                                SnapMotion="@AppState.SnapMotion" />
                        </div>
                    }
                    else
                    {
                        <div class="flex-1 min-h-0">
                            <InteractiveSvgCanvas Scene="@GetCompilerPreviewScene()"
                                                  SnapMotion="@AppState.SnapMotion"
                                                  ErrorBanner="@_compilerError"
                                                  ExportFileName="compiled-automaton.svg" />
                        </div>
                    }
                </div>
            </div>

            @* Right: Open-In-Studio Actions + Live Batch Tester + Generated Grammar/Schema Summary *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[390px] xl:w-[420px] min-w-0 shrink-0 flex flex-col min-h-0 overflow-y-auto p-3 space-y-3")"
                 style="border-left: 1px solid var(--border);">
                @if (_compiledSpec is not null)
                {
                    <div class="bp-card p-3 space-y-2">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-semibold">Open Generated Artifact in Workbench</span>
                            <button type="button"
                                    class="bp-btn-ghost !h-7 !px-2 text-[11px]"
                                    title="Save this custom problem to your local workspace history"
                                    @onclick="SaveCustomProblemToWorkspace">
                                @(_savedProblemNotice ? "Saved ✓" : "Save Problem")
                            </button>
                        </div>
                        <div class="grid grid-cols-2 gap-1.5">
                            @if (_compiledSpec.MinimalDfa is not null)
                            {
                                <button type="button" class="bp-btn-secondary !h-8 text-xs" @onclick="OpenCompiledInDfa">
                                    Open in DFA Studio →
                                </button>
                            }
                            @if (_compiledSpec.Nfa is not null)
                            {
                                <button type="button" class="bp-btn-secondary !h-8 text-xs" @onclick="OpenCompiledInNfa">
                                    Open in NFA Studio →
                                </button>
                            }
                            @if (_compiledSpec.Grammar is not null)
                            {
                                <button type="button" class="bp-btn-secondary !h-8 text-xs" @onclick="OpenCompiledInCfg">
                                    Open in CFG Studio →
                                </button>
                            }
                            @if (_compiledSpec.Pda is not null)
                            {
                                <button type="button" class="bp-btn-secondary !h-8 text-xs" @onclick="OpenCompiledInPda">
                                    Open in PDA Studio →
                                </button>
                            }
                            <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="OpenCompiledInTm">
                                Open in TM Studio →
                            </button>
                        </div>
                    </div>

                    <div class="bp-card p-3 space-y-2.5">
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs font-semibold">Test Input Against Spec</span>
                            <span class="text-[11px] font-mono" style="color: var(--faint);">Empty string = e</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <input type="text"
                                   class="bp-input !h-8 font-mono text-xs flex-1"
                                   placeholder="Enter string (e for empty)"
                                   @bind="_compilerTestInput"
                                   @bind:event="oninput" />
                            <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="RunCompilerTest">
                                Test
                            </button>
                            @if (_compiledSpec.SuggestedTests is { Count: > 0 })
                            {
                                <button type="button"
                                        class="bp-btn-secondary !h-8 text-xs shrink-0"
                                        title="Run auto-generated positive & negative boundary tests"
                                        @onclick="RunAutoTestSuite">
                                    Auto Suite (@_compiledSpec.SuggestedTests.Count)
                                </button>
                            }
                        </div>

                        @if (_compilerTestRows.Count > 0)
                        {
                            <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                <table class="w-full text-xs text-left">
                                    <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                        <tr>
                                            <th class="px-2.5 py-1.5 font-medium">Input</th>
                                            <th class="px-2.5 py-1.5 font-medium">Result</th>
                                            <th class="px-2.5 py-1.5 font-medium">Detail</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in _compilerTestRows)
                                        {
                                            var rowInput = row.Input;
                                            var isSelectedPreview = (_compilerPreviewKind is "pda-stack" or "cfg-queue") && string.Equals(_compilerTestInput, rowInput, StringComparison.Ordinal);
                                            <tr class="cursor-pointer transition-colors"
                                                style="@(isSelectedPreview ? "background: var(--accent-soft);" : "") border-bottom: 1px solid var(--rule);"
                                                title="Click to inspect this input in the preview"
                                                @onclick="() => InspectCompilerRow(rowInput)">
                                                <td class="px-2.5 py-1.5 font-mono">@row.Input</td>
                                                <td class="px-2.5 py-1.5">
                                                    <div class="flex items-center gap-1">
                                                        @if (row.Accepted is true)
                                                        {
                                                            <span class="bp-pill bp-pill-positive text-[11px]">Accept</span>
                                                        }
                                                        else if (row.Accepted is false)
                                                        {
                                                            <span class="bp-pill bp-pill-negative text-[11px]">Reject</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="bp-pill bp-pill-accent text-[11px]">Halted</span>
                                                        }
                                                        @if (row.Expected.HasValue)
                                                        {
                                                            <span class="text-[10px] font-mono"
                                                                  style="color: @(row.Accepted == row.Expected ? "var(--positive)" : "var(--negative)");"
                                                                  title="@(row.Reason ?? "")">
                                                                @(row.Accepted == row.Expected ? "✓" : "✗")
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                                <td class="px-2.5 py-1.5 font-mono text-[11px]" style="color: var(--muted);">
                                                    @if (!string.IsNullOrEmpty(row.Reason))
                                                    {
                                                        <span>@row.Reason · </span>
                                                    }
                                                    @row.Detail
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>

                    @if (_compiledSpec.Grammar is not null)
                    {
                        <div class="bp-card p-3 space-y-1.5">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold">Synthesized Grammar</span>
                                <span class="bp-pill bp-pill-neutral text-[10px]">
                                    @(_compiledSpec.Grammar.IsRegularGrammar() ? "Right-Linear Regular" : "Context-Free")
                                </span>
                            </div>
                            <pre class="text-xs font-mono p-2 rounded overflow-x-auto" style="background: var(--raised);">@_compiledSpec.Grammar.ToGrammarText()</pre>
                        </div>
                    }

                    <div class="bp-card p-3 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold">Compiled Formal TM Stats</span>
                            <span class="font-mono text-[11px] tnum" style="color: var(--muted);">
                                @_compiledSpec.CompiledTm.Machine.States.Count states · @_compiledSpec.CompiledTm.Machine.Transitions.Count δ rules
                            </span>
                        </div>
                        <pre class="text-[11px] font-mono p-2 rounded overflow-x-auto max-h-52" style="background: var(--raised);">@_compiledSpec.TmSchema.ToDslText()</pre>
                    </div>
                }
            </div>
        </div>
    }

    @* ===================================================================== *@
    @* MODE 2: DFA STUDIO (TOTAL DETERMINISTIC + CLOSURES + DECISIONS)       *@
    @* ===================================================================== *@
    else if (_activeMode == StudioMode.Dfa)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left: Source Bar + Interactive DFA SVG + Playback *@
            <div class="shrink-0 lg:shrink lg:flex-1 min-w-0 lg:min-h-0 flex flex-col p-3 gap-2.5 lg:overflow-hidden">
                <div class="flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-1.5 flex-wrap flex-1 min-w-[260px]">
                        <select class="bp-input !h-8 text-xs"
                                value="@_faSourceKind"
                                @onchange="e => _faSourceKind = e.Value!.ToString()!">
                            <option value="constraint">Constraint</option>
                            <option value="regex">Regex</option>
                        </select>
                        <input type="text"
                               class="bp-input !h-8 font-mono text-xs flex-1 min-w-[160px]"
                               placeholder="e.g. starts with aba | does not contain aba | (a|b)*aba(a|b)*"
                               @bind="_faSpecText" />
                        <input type="text"
                               class="bp-input !h-8 font-mono text-xs w-32"
                               placeholder="Σ auto (x,y,z)"
                               title="Custom alphabet symbols (e.g. x,y,z or 0,1 — leave blank to auto-detect)"
                               @bind="_faAlphabetText" />
                        <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="BuildFaFromSpec">Build DFA</button>
                    </div>

                    <div class="flex items-center gap-1.5 flex-wrap">
                        <div class="bp-seg">
                            <button type="button" class="bp-seg-btn" data-active="@(_faViewKind == "min" ? "true" : "false")" @onclick='() => SwitchFaView("min")'>Min DFA</button>
                            <button type="button" class="bp-seg-btn" data-active="@(_faViewKind == "dfa" ? "true" : "false")" @onclick='() => SwitchFaView("dfa")'>Subset DFA</button>
                        </div>
                        <button type="button" class="bp-btn-secondary !h-7 !px-2 text-xs" title="Complement current minimal DFA" @onclick="ApplyFaComplement">Complement</button>
                        <button type="button" class="bp-btn-secondary !h-7 !px-2 text-xs" title="Kleene Star of current minimal DFA" @onclick="ApplyFaStar">Star (*)</button>
                        <button type="button" class="bp-btn-secondary !h-7 !px-2 text-xs" title="Convert current DFA to Decidable Turing Machine" @onclick="SendDfaToTm">To TM →</button>
                    </div>
                </div>

                @* Input Tape & Verdict Strip *@
                <div class="bp-card px-3 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-medium" style="color: var(--muted);">Input w:</span>
                        <input type="text"
                               class="bp-input !h-7 font-mono text-xs w-36"
                               @bind="_faInput"
                               @bind:event="oninput" />
                        <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="TraceFa">Trace</button>

                        @foreach (var sample in _faSampleInputs)
                        {
                            <button type="button"
                                    class="bp-chip font-mono"
                                    @onclick="() => { _faInput = sample; TraceFa(); }">
                                @sample
                            </button>
                        }
                    </div>

                    @if (_faTimeline is not null)
                    {
                        var curStep = CurrentFaStep;
                        <div class="flex items-center gap-2">
                            @if (curStep is not null)
                            {
                                <span class="font-mono text-xs px-2 py-0.5 rounded" style="background: var(--raised); border: 1px solid var(--border);">
                                    @curStep.State.Configuration
                                </span>
                            }
                            <span class="bp-pill @(_faTimeline.IsSuccess ? "bp-pill-positive" : "bp-pill-negative")">
                                @(_faTimeline.IsSuccess ? "Accepted" : "Rejected")
                            </span>
                        </div>
                    }
                </div>

                <div class="flex-1 min-h-[260px]">
                    <InteractiveSvgCanvas Scene="@CurrentFaScene"
                                          SnapMotion="@AppState.SnapMotion"
                                          ErrorBanner="@_faError"
                                          ExportFileName="finite-automaton.svg" />
                </div>

                <PlaybackBar CurrentStep="@_faStepIndex"
                             TotalSteps="@(_faTimeline?.Steps.Count ?? 0)"
                             CurrentStepChanged="i => _faStepIndex = i"
                             SnapMotion="@AppState.SnapMotion"
                             SnapMotionChanged="v => { AppState.SnapMotion = v; AppState.Notify(); }" />
            </div>

            @* Right Inspector *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[400px] xl:w-[430px] min-w-0 shrink-0 flex flex-col min-h-0")" style="border-left: 1px solid var(--border);">
                <div class="flex items-center px-3 shrink-0" style="border-bottom: 1px solid var(--border);">
                    <button type="button" class="bp-tab" data-active="@(_faRightTab == "trace" ? "true" : "false")" @onclick='() => _faRightTab = "trace"'>Trace &amp; Table</button>
                    <button type="button" class="bp-tab" data-active="@(_faRightTab == "rg" ? "true" : "false")" @onclick='() => _faRightTab = "rg"'>Regular Grammar</button>
                    <button type="button" class="bp-tab" data-active="@(_faRightTab == "decide" ? "true" : "false")" @onclick='() => _faRightTab = "decide"'>Decisions &amp; Compare</button>
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3">
                    @if (_faRightTab == "trace")
                    {
                        @if (CurrentFaStep is not null)
                        {
                            <div class="bp-card p-2.5 space-y-1">
                                <div class="text-xs font-semibold">@CurrentFaStep.Title</div>
                                <div class="text-xs" style="color: var(--muted);">@CurrentFaStep.Explanation</div>
                            </div>
                        }

                        @if (_faTimeline is not null)
                        {
                            <div class="space-y-1">
                                <div class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--faint);">Execution Steps</div>
                                <div class="rounded-md overflow-hidden" style="border: 1px solid var(--border);">
                                    @for (var i = 0; i < _faTimeline.Steps.Count; i++)
                                    {
                                        var idx = i;
                                        var st = _faTimeline.Steps[idx];
                                        var isCur = idx == _faStepIndex;
                                        <button type="button"
                                                class="w-full text-left px-2.5 py-1.5 text-xs flex items-center justify-between gap-2 cursor-pointer transition-colors"
                                                style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "background: var(--surface); color: var(--muted);") border-bottom: 1px solid var(--rule);"
                                                @onclick="() => _faStepIndex = idx">
                                            <span class="font-mono tnum">@idx. @st.Title</span>
                                            <span class="font-mono text-[11px]">@st.BadgeLabel</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (ActiveDfa is not null)
                        {
                            <div class="space-y-1.5">
                                <div class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--faint);">Transition Matrix δ(q, σ)</div>
                                <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                    <table class="w-full text-xs text-left font-mono">
                                        <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                            <tr>
                                                <th class="px-2.5 py-1.5">State</th>
                                                @foreach (var sym in ActiveDfa.OrderedAlphabet)
                                                {
                                                    <th class="px-2.5 py-1.5">@sym</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var q in ActiveDfa.OrderedStates)
                                            {
                                                var isCurState = CurrentFaStep?.State.CurrentState == q;
                                                <tr style="@(isCurState ? "background: var(--accent-soft);" : "") border-bottom: 1px solid var(--rule);">
                                                    <td class="px-2.5 py-1.5 font-semibold">
                                                        @(q == ActiveDfa.StartState ? "→ " : "")@q@(ActiveDfa.AcceptStates.Contains(q) ? " *" : "")
                                                    </td>
                                                    @foreach (var sym in ActiveDfa.OrderedAlphabet)
                                                    {
                                                        <td class="px-2.5 py-1.5">@(ActiveDfa.Step(q, sym) ?? "—")</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="bp-card p-2.5 space-y-1">
                                <div class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--faint);">Formal Quintuple</div>
                                <pre class="text-[11px] font-mono whitespace-pre-wrap" style="color: var(--muted);">@ActiveDfa.ToFormalString()</pre>
                            </div>
                        }
                    }
                    else if (_faRightTab == "rg" && _faMinDfa is not null)
                    {
                        var rg = RegularGrammarConverter.DfaToRegularGrammar(_faMinDfa);
                        <div class="bp-card p-3 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold">Right-Linear Regular Grammar</span>
                                <button type="button" class="bp-btn-secondary !h-7 !px-2 text-xs" @onclick="() => SendGrammarToCfg(rg)">
                                    Open in CFG Studio →
                                </button>
                            </div>
                            <p class="text-xs" style="color: var(--muted);">
                                Generated deterministically from minimal DFA: <code>δ(q, a) = p ⇒ q → a p</code> and <code>q ∈ F ⇒ q → e</code>.
                            </p>
                            <pre class="text-xs font-mono p-2.5 rounded overflow-x-auto" style="background: var(--raised);">@rg.ToGrammarText()</pre>
                        </div>
                    }
                    else if (_faRightTab == "decide" && _faMinDfa is not null)
                    {
                        var emptyRes = FaOperations.IsEmpty(_faMinDfa);
                        var univRes = FaOperations.IsUniversal(_faMinDfa);
                        <div class="bp-card p-3 space-y-2">
                            <div class="text-xs font-semibold">Single-Language Decisions</div>
                            <div class="space-y-1.5 text-xs">
                                <div class="flex items-start justify-between gap-2 p-2 rounded" style="background: var(--raised);">
                                    <div>
                                        <div class="font-medium">Emptiness: L(M₁) = ∅?</div>
                                        <div class="text-[11px]" style="color: var(--muted);">@emptyRes.Explanation</div>
                                    </div>
                                    <span class="bp-pill @(emptyRes.Result ? "bp-pill-positive" : "bp-pill-neutral")">@(emptyRes.Result ? "Yes" : "No")</span>
                                </div>
                                <div class="flex items-start justify-between gap-2 p-2 rounded" style="background: var(--raised);">
                                    <div>
                                        <div class="font-medium">Universality: L(M₁) = Σ*?</div>
                                        <div class="text-[11px]" style="color: var(--muted);">@univRes.Explanation</div>
                                    </div>
                                    <span class="bp-pill @(univRes.Result ? "bp-pill-positive" : "bp-pill-neutral")">@(univRes.Result ? "Yes" : "No")</span>
                                </div>
                            </div>
                        </div>

                        <div class="bp-card p-3 space-y-2.5">
                            <div class="text-xs font-semibold">Compare &amp; Combine with Second Language M₂</div>
                            <div class="flex items-center gap-1.5">
                                <input type="text"
                                       class="bp-input !h-8 font-mono text-xs flex-1"
                                       placeholder="Regex or constraint for M₂ (e.g. a*b*)"
                                       @bind="_faCompareSpec" />
                                <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="CompareWithSecondFa">Compare</button>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(_faCompareError))
                            {
                                <div class="text-xs p-2 rounded" style="background: var(--pill-negative-bg); color: var(--pill-negative-ink);">@_faCompareError</div>
                            }

                            @if (_faCompareEquiv is not null && _faCompareSub12 is not null && _faCompareSub21 is not null)
                            {
                                <div class="space-y-1.5 text-xs">
                                    <div class="flex items-start justify-between gap-2 p-2 rounded" style="background: var(--raised);">
                                        <div>
                                            <div class="font-medium">Equivalence: L(M₁) = L(M₂)?</div>
                                            <div class="text-[11px]" style="color: var(--muted);">@_faCompareEquiv.Explanation</div>
                                        </div>
                                        <span class="bp-pill @(_faCompareEquiv.Result ? "bp-pill-positive" : "bp-pill-negative")">@(_faCompareEquiv.Result ? "Equal" : "Different")</span>
                                    </div>
                                    <div class="flex items-start justify-between gap-2 p-2 rounded" style="background: var(--raised);">
                                        <div>
                                            <div class="font-medium">Subset: L(M₁) ⊆ L(M₂)?</div>
                                            <div class="text-[11px]" style="color: var(--muted);">@_faCompareSub12.Explanation</div>
                                        </div>
                                        <span class="bp-pill @(_faCompareSub12.Result ? "bp-pill-positive" : "bp-pill-neutral")">@(_faCompareSub12.Result ? "Yes" : "No")</span>
                                    </div>
                                    <div class="flex items-start justify-between gap-2 p-2 rounded" style="background: var(--raised);">
                                        <div>
                                            <div class="font-medium">Superset: L(M₂) ⊆ L(M₁)?</div>
                                            <div class="text-[11px]" style="color: var(--muted);">@_faCompareSub21.Explanation</div>
                                        </div>
                                        <span class="bp-pill @(_faCompareSub21.Result ? "bp-pill-positive" : "bp-pill-neutral")">@(_faCompareSub21.Result ? "Yes" : "No")</span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-1.5 pt-1">
                                    <button type="button" class="bp-btn-secondary !h-7 text-xs" @onclick='() => CombineFa("union")'>Load M₁ ∪ M₂</button>
                                    <button type="button" class="bp-btn-secondary !h-7 text-xs" @onclick='() => CombineFa("intersect")'>Load M₁ ∩ M₂</button>
                                    <button type="button" class="bp-btn-secondary !h-7 text-xs" @onclick='() => CombineFa("diff")'>Load M₁ \ M₂</button>
                                    <button type="button" class="bp-btn-secondary !h-7 text-xs" @onclick='() => CombineFa("concat")'>Load M₁ · M₂</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ===================================================================== *@
    @* MODE 3: DEDICATED NFA STUDIO (COMPACT STRING-EDGE NFAs + SUBSET MAP)  *@
    @* ===================================================================== *@
    else if (_activeMode == StudioMode.Nfa)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left: NFA Source Bar + Negation Banner + Compact NFA Canvas + Playback *@
            <div class="shrink-0 lg:shrink lg:flex-1 min-w-0 lg:min-h-0 flex flex-col p-3 gap-2.5 lg:overflow-hidden">
                <div class="bp-card p-2.5 space-y-2 shrink-0">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 flex-wrap flex-1 min-w-[260px]">
                            <select class="bp-input !h-8 text-xs"
                                    value="@_nfaSourceKind"
                                    @onchange="e => _nfaSourceKind = e.Value!.ToString()!">
                                <option value="constraint">Constraint</option>
                                <option value="regex">Regex</option>
                            </select>
                            <input type="text"
                                   class="bp-input !h-8 font-mono text-xs flex-1 min-w-[160px]"
                                   placeholder="e.g. starts with aba | ends with aba | contains aba | starts with aba OR ends with bab"
                                   @bind="_nfaSpecText" />
                            <input type="text"
                                   class="bp-input !h-8 font-mono text-xs w-32"
                                   placeholder="Σ auto (x,y,z)"
                                   title="Custom alphabet symbols (leave blank to auto-detect)"
                                   @bind="_nfaAlphabetText" />
                            <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="BuildNfaFromSpec">Build NFA</button>
                        </div>

                        <button type="button"
                                class="bp-btn-secondary !h-8 text-xs"
                                title="Convert this NFA into a complete minimized DFA via Subset Construction"
                                @onclick="ConvertCurrentNfaToDfa">
                            Convert to DFA →
                        </button>
                    </div>

                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] font-medium" style="color: var(--faint);">Try NFA vs Negated DFA:</span>
                        @foreach (var ex in NfaExamples)
                        {
                            <button type="button"
                                    class="bp-chip font-mono"
                                    @onclick="() => RunNfaExample(ex.Spec, ex.SampleInput)">
                                @ex.Label
                            </button>
                        }
                    </div>
                </div>

                @if (_nfaRequiredDeterminization)
                {
                    <div class="px-3 py-2 rounded-lg text-xs shrink-0 flex flex-wrap items-center justify-between gap-2"
                         style="background: var(--pill-warning-bg); color: var(--pill-warning-ink); border: 1px solid var(--warning);">
                        <span>
                            <strong>Determinized to DFA (Negation Rule):</strong>
                            @(_nfaDeterminizationReason ?? "Negation requires converting the NFA into a complete DFA before complementing accept states.")
                        </span>
                        <button type="button" class="bp-btn-secondary !h-6 text-[11px]" @onclick="ConvertCurrentNfaToDfa">
                            Open in DFA Studio →
                        </button>
                    </div>
                }

                @* Input Strip & Active Set Verdict *@
                <div class="bp-card px-3 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-medium" style="color: var(--muted);">Input w:</span>
                        <input type="text"
                               class="bp-input !h-7 font-mono text-xs w-36"
                               @bind="_nfaInput"
                               @bind:event="oninput" />
                        <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="TraceNfa">Trace</button>

                        @foreach (var sample in _nfaSampleInputs)
                        {
                            <button type="button"
                                    class="bp-chip font-mono"
                                    @onclick="() => { _nfaInput = sample; TraceNfa(); }">
                                @sample
                            </button>
                        }
                    </div>

                    @if (_nfaTimeline is not null)
                    {
                        var curStep = CurrentNfaStep;
                        <div class="flex items-center gap-2">
                            @if (curStep is not null)
                            {
                                <span class="font-mono text-xs px-2 py-0.5 rounded" style="background: var(--raised); border: 1px solid var(--border);">
                                    @curStep.State.Configuration
                                </span>
                            }
                            <span class="bp-pill @(_nfaTimeline.IsSuccess ? "bp-pill-positive" : "bp-pill-negative")">
                                @(_nfaTimeline.IsSuccess ? "Accepted" : "Rejected")
                            </span>
                        </div>
                    }
                </div>

                <div class="flex-1 min-h-[260px]">
                    <InteractiveSvgCanvas Scene="@CurrentNfaScene"
                                          SnapMotion="@AppState.SnapMotion"
                                          ErrorBanner="@_nfaError"
                                          ExportFileName="nfa-diagram.svg" />
                </div>

                <PlaybackBar CurrentStep="@_nfaStepIndex"
                             TotalSteps="@(_nfaTimeline?.Steps.Count ?? 0)"
                             CurrentStepChanged="i => _nfaStepIndex = i"
                             SnapMotion="@AppState.SnapMotion"
                             SnapMotionChanged="v => { AppState.SnapMotion = v; AppState.Notify(); }" />
            </div>

            @* Right Inspector: NFA Trace & Transitions + Subset Construction Map *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[400px] xl:w-[430px] min-w-0 shrink-0 flex flex-col min-h-0")" style="border-left: 1px solid var(--border);">
                <div class="flex items-center px-3 shrink-0" style="border-bottom: 1px solid var(--border);">
                    <button type="button" class="bp-tab" data-active="@(_nfaRightTab == "trace" ? "true" : "false")" @onclick='() => _nfaRightTab = "trace"'>Trace &amp; Transitions</button>
                    <button type="button" class="bp-tab" data-active="@(_nfaRightTab == "subset" ? "true" : "false")" @onclick='() => _nfaRightTab = "subset"'>Subset → DFA</button>
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3">
                    @if (_nfaRightTab == "trace")
                    {
                        @if (CurrentNfaStep is not null)
                        {
                            <div class="bp-card p-2.5 space-y-1">
                                <div class="text-xs font-semibold">@CurrentNfaStep.Title</div>
                                <div class="text-xs" style="color: var(--muted);">@CurrentNfaStep.Explanation</div>
                            </div>
                        }

                        @if (_nfaTimeline is not null)
                        {
                            <div class="space-y-1">
                                <div class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--faint);">Nondeterministic Steps</div>
                                <div class="rounded-md overflow-hidden" style="border: 1px solid var(--border);">
                                    @for (var i = 0; i < _nfaTimeline.Steps.Count; i++)
                                    {
                                        var idx = i;
                                        var st = _nfaTimeline.Steps[idx];
                                        var isCur = idx == _nfaStepIndex;
                                        <button type="button"
                                                class="w-full text-left px-2.5 py-1.5 text-xs flex items-center justify-between gap-2 cursor-pointer transition-colors"
                                                style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "background: var(--surface); color: var(--muted);") border-bottom: 1px solid var(--rule);"
                                                @onclick="() => _nfaStepIndex = idx">
                                            <span class="font-mono tnum truncate">@idx. @st.Title</span>
                                            <span class="font-mono text-[11px] shrink-0">@st.BadgeLabel</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (_currentNfa is not null)
                        {
                            <div class="space-y-1.5">
                                <div class="flex items-center justify-between">
                                    <span class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--faint);">Transition Relation Δ</span>
                                    <span class="text-[11px] font-mono tnum" style="color: var(--muted);">
                                        @_currentNfa.States.Count states · @_currentNfa.Transitions.Count edges
                                    </span>
                                </div>
                                <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                    <table class="w-full text-xs text-left font-mono">
                                        <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                            <tr>
                                                <th class="px-2.5 py-1.5">From</th>
                                                <th class="px-2.5 py-1.5">Read</th>
                                                <th class="px-2.5 py-1.5">To</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var tr in _currentNfa.Transitions)
                                            {
                                                <tr style="border-bottom: 1px solid var(--rule);">
                                                    <td class="px-2.5 py-1">@(tr.FromState == _currentNfa.StartState ? "→ " : "")@tr.FromState</td>
                                                    <td class="px-2.5 py-1 font-semibold" style="color: @(tr.Symbol.Length > 1 ? "var(--accent)" : tr.IsEpsilon ? "var(--warning)" : "var(--text)");">@tr.Symbol</td>
                                                    <td class="px-2.5 py-1">@tr.ToState@(_currentNfa.AcceptStates.Contains(tr.ToState) ? " *" : "")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <div class="bp-card p-2.5 space-y-1">
                                <div class="text-[11px] font-semibold uppercase tracking-wide" style="color: var(--faint);">NFA Formal Quintuple</div>
                                <pre class="text-[11px] font-mono whitespace-pre-wrap max-h-52 overflow-y-auto" style="color: var(--muted);">@_currentNfa.ToFormalString()</pre>
                            </div>
                        }
                    }
                    else if (_currentNfa is not null && _nfaSubsetMap is not null)
                    {
                        <div class="bp-card p-3 space-y-2.5">
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-xs font-semibold">Subset Construction (NFA → DFA)</span>
                                <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="ConvertCurrentNfaToDfa">
                                    Open DFA →
                                </button>
                            </div>
                            <div class="text-xs" style="color: var(--muted);">
                                Compact NFA has <strong>@_currentNfa.States.Count states</strong>; subset construction yields <strong>@_nfaSubsetMap.Count DFA states</strong> (including total transitions and any dead trap state).
                            </div>
                            <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                <table class="w-full text-xs text-left font-mono">
                                    <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                        <tr>
                                            <th class="px-2.5 py-1.5">DFA State</th>
                                            <th class="px-2.5 py-1.5">Active NFA Subset</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kv in _nfaSubsetMap)
                                        {
                                            <tr style="border-bottom: 1px solid var(--rule);">
                                                <td class="px-2.5 py-1.5 font-semibold">@kv.Key</td>
                                                <td class="px-2.5 py-1.5" style="color: var(--muted);">
                                                    @(kv.Value.Count == 0 ? "∅ (dead trap)" : "{" + string.Join(", ", kv.Value) + "}")
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ===================================================================== *@
    @* MODE 4: CONTEXT-FREE GRAMMAR + FIFO DERIVATION QUEUE                  *@
    @* ===================================================================== *@
    else if (_activeMode == StudioMode.Cfg)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left: Input Tester + Horizontal FIFO Derivation Queue + Playback *@
            <div class="shrink-0 lg:shrink lg:flex-1 min-w-0 lg:min-h-0 flex flex-col p-3 gap-2.5 lg:overflow-hidden">
                <div class="bp-card px-3 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-medium" style="color: var(--muted);">String w:</span>
                        <input type="text"
                               class="bp-input !h-7 font-mono text-xs w-44"
                               @bind="_cfgInput"
                               @bind:event="oninput" />
                        <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="ParseCfgAndInput">Derive</button>

                        @foreach (var sample in _cfgSampleInputs)
                        {
                            <button type="button"
                                    class="bp-chip font-mono"
                                    @onclick="() => { _cfgInput = sample; ParseCfgAndInput(); }">
                                @sample
                            </button>
                        }
                    </div>

                    @if (_cfgParseResult is not null)
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-xs hidden xl:inline" style="color: var(--muted);">@_cfgParseResult.Summary</span>
                            <span class="bp-pill @(_cfgParseResult.Accepted ? "bp-pill-positive" : "bp-pill-negative")">
                                @(_cfgParseResult.Accepted ? "Accepted" : "Rejected")
                            </span>
                        </div>
                    }
                </div>

                <div class="flex-1 min-h-[280px] bp-card p-3 overflow-hidden">
                    @if (!string.IsNullOrEmpty(_cfgError))
                    {
                        <div class="mb-2 px-3 py-2 rounded-md text-xs font-mono" style="background: var(--pill-negative-bg); color: var(--pill-negative-ink); border: 1px solid var(--negative);">
                            @_cfgError
                        </div>
                    }
                    <CfgQueueVisualizer Result="@_cfgParseResult"
                                        @bind-CurrentStepIndex="_cfgStepIndex"
                                        SnapMotion="@AppState.SnapMotion" />
                </div>

                <PlaybackBar CurrentStep="@_cfgStepIndex"
                             TotalSteps="@(_cfgParseResult?.QueueSteps?.Count ?? 0)"
                             CurrentStepChanged="i => _cfgStepIndex = i"
                             SnapMotion="@AppState.SnapMotion"
                             SnapMotionChanged="v => { AppState.SnapMotion = v; AppState.Notify(); }" />
            </div>

            @* Right: Grammar Editor + Conversions + Clickable Leftmost Derivation *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[400px] xl:w-[430px] min-w-0 shrink-0 flex flex-col min-h-0 overflow-y-auto p-3 space-y-3")"
                 style="border-left: 1px solid var(--border);">
                <div class="bp-card p-3 space-y-2">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-semibold">Production Rules (G = (V, Σ, R, S))</span>
                        @if (_currentCfg is not null)
                        {
                            <span class="bp-pill @(_currentCfg.IsRegularGrammar() ? "bp-pill-accent" : "bp-pill-neutral") text-[10px]">
                                @(_currentCfg.IsRegularGrammar() ? "Right-Linear Regular" : "Context-Free")
                            </span>
                        }
                    </div>

                    <textarea class="bp-textarea w-full text-xs" rows="6" @bind="_cfgText"></textarea>

                    <div class="flex flex-wrap items-center gap-1.5">
                        <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="ParseCfgAndInput">Apply Grammar</button>
                        @if (_currentCfg is not null)
                        {
                            <button type="button" class="bp-btn-secondary !h-7 text-xs" @onclick="ConvertCurrentCfgToPda">
                                Convert to PDA →
                            </button>
                            @if (_currentCfg.IsRegularGrammar())
                            {
                                <button type="button" class="bp-btn-secondary !h-7 text-xs" @onclick="ConvertCurrentCfgToNfa">
                                    Convert to NFA →
                                </button>
                            }
                        }
                    </div>
                </div>

                @if (_cfgParseResult is { Accepted: true } && _cfgParseResult.QueueSteps is { Count: > 0 } qSteps)
                {
                    <div class="bp-card p-3 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold">Leftmost Derivation</span>
                            <span class="font-mono text-[11px] tnum" style="color: var(--muted);">@(qSteps.Count - 1) steps · click to jump</span>
                        </div>
                        <div class="rounded-md overflow-hidden" style="border: 1px solid var(--border);">
                            @for (var i = 0; i < qSteps.Count; i++)
                            {
                                var idx = i;
                                var qStep = qSteps[idx];
                                var isCur = idx == _cfgStepIndex;
                                <button type="button"
                                        class="w-full text-left px-2.5 py-1.5 text-xs font-mono flex items-center justify-between gap-2 cursor-pointer transition-colors"
                                        style="border-bottom: 1px solid var(--rule); @(isCur ? "background: var(--accent-soft); color: var(--text);" : qStep.IsComplete ? "background: var(--pill-positive-bg); color: var(--pill-positive-ink);" : "background: var(--surface); color: var(--muted);")"
                                        @onclick="() => _cfgStepIndex = idx">
                                    <span class="flex items-center gap-2 min-w-0">
                                        <span class="tnum text-[11px] w-5 shrink-0 opacity-70">@idx</span>
                                        <span class="opacity-60">@(idx == 0 ? " " : "⇒")</span>
                                        <span class="break-all font-semibold">@qStep.SententialForm</span>
                                    </span>
                                    @if (!string.IsNullOrEmpty(qStep.AppliedRule))
                                    {
                                        <span class="text-[10.5px] shrink-0 opacity-80">@qStep.AppliedRule</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (_currentCfg is not null)
                {
                    <div class="bp-card p-3 space-y-1.5 text-xs">
                        <div class="font-semibold">Formal Quadruple</div>
                        <div class="font-mono text-[11px] space-y-1" style="color: var(--muted);">
                            <div><strong>Start S:</strong> @_currentCfg.StartSymbol</div>
                            <div><strong>Non-Terminals (V - Σ):</strong> { @string.Join(", ", _currentCfg.NonTerminals.OrderBy(x => x)) }</div>
                            <div><strong>Terminals Σ:</strong> { @string.Join(", ", _currentCfg.Terminals.OrderBy(x => x)) }</div>
                            <div><strong>Rules |R|:</strong> @_currentCfg.Rules.Count</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ===================================================================== *@
    @* MODE 4: GENERALIZED 6-TUPLE PUSHDOWN AUTOMATON (EMPTY-STACK + FINAL)  *@
    @* ===================================================================== *@
    else if (_activeMode == StudioMode.Pda)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left: Input Strip + Canvas + Live LIFO Stack + Playback *@
            <div class="shrink-0 lg:shrink lg:flex-1 min-w-0 lg:min-h-0 flex flex-col p-3 gap-2.5 lg:overflow-hidden">
                <div class="bp-card px-3 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-medium" style="color: var(--muted);">Input w:</span>
                        <input type="text"
                               class="bp-input !h-7 font-mono text-xs w-36"
                               @bind="_pdaInput"
                               @bind:event="oninput" />
                        <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="TracePda">Trace</button>

                        @foreach (var sample in _pdaSampleInputs)
                        {
                            <button type="button"
                                    class="bp-chip font-mono"
                                    @onclick="() => { _pdaInput = sample; TracePda(); }">
                                @sample
                            </button>
                        }
                    </div>

                    @if (_pdaResult is not null)
                    {
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-[11px] font-mono tnum" style="color: var(--muted);">@_pdaResult.ExploredConfigurations configs</span>
                            <span class="bp-pill @(_pdaResult.Accepted ? "bp-pill-positive" : "bp-pill-negative")">
                                @(_pdaResult.Accepted ? "Accepted (q ∈ F, e, e)" : "Rejected")
                            </span>
                        </div>
                    }
                </div>

                @* Center: Spacious LIFO Stack Machine (Stack-Only) *@
                <div class="flex-1 min-h-[280px] bp-card p-3 overflow-hidden">
                    @if (!string.IsNullOrEmpty(_pdaError))
                    {
                        <div class="mb-2 px-3 py-2 rounded-md text-xs font-mono" style="background: var(--pill-negative-bg); color: var(--pill-negative-ink); border: 1px solid var(--negative);">
                            @_pdaError
                        </div>
                    }
                    <PdaStackVisualizer Trace="@_pdaResult"
                                        @bind-CurrentStepIndex="_pdaStepIndex"
                                        SnapMotion="@AppState.SnapMotion" />
                </div>

                <PlaybackBar CurrentStep="@_pdaStepIndex"
                             TotalSteps="@(_pdaResult?.Timeline.Steps.Count ?? 0)"
                             CurrentStepChanged="i => _pdaStepIndex = i"
                             SnapMotion="@AppState.SnapMotion"
                             SnapMotionChanged="v => { AppState.SnapMotion = v; AppState.Notify(); }" />
            </div>

            @* Right Inspector: 5-Column Trace Table + Transitions Editor *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[440px] xl:w-[480px] min-w-0 shrink-0 flex flex-col min-h-0")" style="border-left: 1px solid var(--border);">
                <div class="flex items-center px-3 shrink-0" style="border-bottom: 1px solid var(--border);">
                    <button type="button" class="bp-tab" data-active="@(_pdaRightTab == "table" ? "true" : "false")" @onclick='() => _pdaRightTab = "table"'>5-Column Trace</button>
                    <button type="button" class="bp-tab" data-active="@(_pdaRightTab == "editor" ? "true" : "false")" @onclick='() => _pdaRightTab = "editor"'>Transitions Editor</button>
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3">
                    @if (_pdaRightTab == "table" && _pdaResult is not null)
                    {
                        <div class="text-[11px]" style="color: var(--muted);">
                            Acceptance requires final state <code>p ∈ F</code>, empty input <code>e</code>, and empty stack <code>e</code>. Click any row to jump.
                        </div>
                        <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                            <table class="w-full text-[11px] text-left">
                                <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                    <tr>
                                        <th class="px-2 py-1.5 font-semibold">State</th>
                                        <th class="px-2 py-1.5 font-semibold">Input</th>
                                        <th class="px-2 py-1.5 font-semibold">Stack</th>
                                        <th class="px-2 py-1.5 font-semibold">Transition Used</th>
                                        <th class="px-2 py-1.5 font-semibold">Remarks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < _pdaResult.Rows.Count; i++)
                                    {
                                        var idx = i;
                                        var row = _pdaResult.Rows[idx];
                                        var isCur = idx == _pdaStepIndex;
                                        <tr class="cursor-pointer transition-colors"
                                            style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "") border-bottom: 1px solid var(--rule);"
                                            @onclick="() => _pdaStepIndex = System.Math.Min(idx, _pdaResult.Timeline.Steps.Count - 1)">
                                            <td class="px-2 py-1.5 font-mono font-semibold">@row.State</td>
                                            <td class="px-2 py-1.5 font-mono">@row.RemainingInput</td>
                                            <td class="px-2 py-1.5 font-mono">@row.Stack</td>
                                            <td class="px-2 py-1.5 font-mono whitespace-nowrap">@row.TransitionUsed</td>
                                            <td class="px-2 py-1.5" style="color: var(--muted);">@row.Remarks</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="bp-card p-3 space-y-2">
                            <div class="text-xs font-semibold">PDA Transitions ((from, read, pop), (to, push))</div>
                            <textarea class="bp-textarea w-full text-xs" rows="10" @bind="_pdaTransitionsText"></textarea>
                            <div class="flex items-center justify-between gap-2">
                                <span class="text-[11px]" style="color: var(--faint);">Use <code>e</code> for empty string; optional <code>start:</code> and <code>accept:</code> headers.</span>
                                <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="ParseAndTracePda">Apply &amp; Trace</button>
                            </div>
                        </div>

                        @if (_currentPda is not null)
                        {
                            <div class="bp-card p-3 text-xs font-mono space-y-1" style="color: var(--muted);">
                                <div><strong>K:</strong> { @string.Join(", ", _currentPda.OrderedStates) }</div>
                                <div><strong>Σ:</strong> { @string.Join(", ", _currentPda.InputAlphabet.OrderBy(c => c)) }</div>
                                <div><strong>Γ:</strong> { @string.Join(", ", _currentPda.StackAlphabet.OrderBy(s => s)) }</div>
                                <div><strong>s:</strong> @_currentPda.StartState · <strong>F:</strong> { @string.Join(", ", _currentPda.AcceptStates) }</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @* ===================================================================== *@
    @* MODE 5: TURING MACHINE SCHEMA COMPILER + MACRO/MICRO TAPE TRACER      *@
    @* ===================================================================== *@
    else if (_activeMode == StudioMode.TuringMachine)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left: Input/Head/Granularity Bar + Horizontal Tape Strip + Schema Canvas + Playback *@
            <div class="shrink-0 lg:shrink lg:flex-1 min-w-0 lg:min-h-0 flex flex-col p-3 gap-2.5 lg:overflow-hidden">
                <div class="bp-card px-3 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs font-medium" style="color: var(--muted);">Input w:</span>
                        <input type="text"
                               class="bp-input !h-7 font-mono text-xs w-32"
                               @bind="_tmInput"
                               @bind:event="oninput" />
                        <select class="bp-input !h-7 text-xs"
                                title="Initial tape head position on #w#"
                                value="@_tmHeadStart"
                                @onchange="OnTmHeadStartChanged">
                            <option value="@HeadStartMode.RightBlank">Head: Right # (#w[#])</option>
                            <option value="@HeadStartMode.FirstSymbol">Head: First Cell (#[w]#)</option>
                            <option value="@HeadStartMode.LeftBlank">Head: Left # ([ # ]w#)</option>
                        </select>
                        <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="RunTmTrace">Run</button>

                        @foreach (var sample in _tmSampleInputs)
                        {
                            <button type="button"
                                    class="bp-chip font-mono"
                                    @onclick="() => { _tmInput = sample; RunTmTrace(); }">
                                @sample
                            </button>
                        }
                    </div>

                    <div class="flex items-center gap-2 flex-wrap">
                        <div class="flex items-center rounded-md p-0.5" style="background: var(--raised); border: 1px solid var(--border);">
                            <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                    style="@(!_tmMicroMode ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                    @onclick="() => SwitchTmGranularity(false)">Macro (@(_tmTrace?.MacroTimeline.Steps.Count ?? 0))</button>
                            <button type="button" class="px-2 h-6 rounded text-[11px] font-medium cursor-pointer"
                                    style="@(_tmMicroMode ? "background: var(--surface); color: var(--text);" : "color: var(--muted);")"
                                    @onclick="() => SwitchTmGranularity(true)">Micro (@(_tmTrace?.MicroTrace.Count ?? 0))</button>
                        </div>

                        @if (_tmTrace is not null)
                        {
                            @if (_tmTrace.AcceptedDecision is true)
                            {
                                <span class="bp-pill bp-pill-positive">Accepted (#y#)</span>
                            }
                            else if (_tmTrace.AcceptedDecision is false)
                            {
                                <span class="bp-pill bp-pill-negative">Rejected (#n#)</span>
                            }
                            else if (_tmTrace.HaltedNormally)
                            {
                                <span class="bp-pill bp-pill-accent font-mono">Output: @_tmTrace.TrimmedTape</span>
                            }
                            else
                            {
                                <span class="bp-pill bp-pill-warning">@_tmTrace.HaltReason</span>
                            }
                        }
                    </div>
                </div>

                @* Interactive Horizontal Semi-Infinite Tape Strip *@
                @{
                    var tapeInfo = CurrentTmTapeSnapshot;
                }
                <div class="bp-card px-3 py-2.5 shrink-0 space-y-2">
                    <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-2">
                            <span class="bp-pill bp-pill-accent font-mono">@tapeInfo.StateLabel</span>
                            <span class="font-medium">@tapeInfo.Summary</span>
                        </div>
                        <span class="font-mono text-[11px] tnum" style="color: var(--muted);">Head cell: @tapeInfo.HeadIndex</span>
                    </div>

                    <div class="flex items-end gap-1 overflow-x-auto pb-1">
                        @for (var c = 0; c < tapeInfo.Tape.Length; c++)
                        {
                            var isHead = c == tapeInfo.HeadIndex;
                            var ch = tapeInfo.Tape[c];
                            <div class="flex flex-col items-center shrink-0">
                                <span class="text-[9px] font-mono tnum mb-0.5"
                                      style="@(isHead ? "color: var(--accent); font-weight: 700;" : "color: var(--faint);")">
                                    @(isHead ? "▼" : c.ToString())
                                </span>
                                <div class="w-8 h-8 rounded flex items-center justify-center font-mono text-sm font-semibold transition-colors"
                                     style="@(isHead
                                         ? "background: var(--accent-soft); color: var(--accent); border: 2px solid var(--accent);"
                                         : ch == '#'
                                             ? "background: var(--raised); color: var(--faint); border: 1px solid var(--border);"
                                             : "background: var(--surface); color: var(--text); border: 1px solid var(--control);")">
                                    @ch
                                </div>
                                <span class="text-[9px] font-mono tnum mt-0.5" style="color: var(--faint);">@c</span>
                            </div>
                        }
                    </div>
                </div>

                @* Schema Diagram Canvas *@
                <div class="flex-1 min-h-[220px]">
                    <InteractiveSvgCanvas Scene="@CurrentTmScene"
                                          SnapMotion="@AppState.SnapMotion"
                                          ErrorBanner="@_tmError"
                                          ExportFileName="tm-schema.svg" />
                </div>

                <PlaybackBar CurrentStep="@_tmStepIndex"
                             TotalSteps="@CurrentTmTotalSteps"
                             CurrentStepChanged="i => _tmStepIndex = i"
                             SnapMotion="@AppState.SnapMotion"
                             SnapMotionChanged="v => { AppState.SnapMotion = v; AppState.Notify(); }" />
            </div>

            @* Right Inspector: Trace Table | Schema DSL Editor | Formal δ Quadruple Table *@
            <div class="@(_inspectorCollapsed ? "hidden" : "w-full lg:w-[430px] xl:w-[470px] min-w-0 shrink-0 flex flex-col min-h-0")" style="border-left: 1px solid var(--border);">
                <div class="flex items-center px-3 shrink-0" style="border-bottom: 1px solid var(--border);">
                    <button type="button" class="bp-tab" data-active="@(_tmRightTab == "trace" ? "true" : "false")" @onclick='() => _tmRightTab = "trace"'>@(_tmMicroMode ? "Micro Trace" : "Macro Trace")</button>
                    <button type="button" class="bp-tab" data-active="@(_tmRightTab == "dsl" ? "true" : "false")" @onclick='() => _tmRightTab = "dsl"'>Schema DSL</button>
                    <button type="button" class="bp-tab" data-active="@(_tmRightTab == "table" ? "true" : "false")" @onclick='() => _tmRightTab = "table"'>Formal δ Table</button>
                </div>

                <div class="flex-1 min-h-0 overflow-y-auto p-3 space-y-3">
                    @if (_tmRightTab == "trace" && _tmTrace is not null)
                    {
                        @if (!_tmMicroMode)
                        {
                            <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                <table class="w-full text-[11px] text-left">
                                    <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                        <tr>
                                            <th class="px-2 py-1.5 font-semibold">#</th>
                                            <th class="px-2 py-1.5 font-semibold">Node</th>
                                            <th class="px-2 py-1.5 font-semibold">Tape</th>
                                            <th class="px-2 py-1.5 font-semibold">Head</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < _tmTrace.MacroTimeline.Steps.Count; i++)
                                        {
                                            var idx = i;
                                            var st = _tmTrace.MacroTimeline.Steps[idx];
                                            var isCur = idx == _tmStepIndex;
                                            <tr class="cursor-pointer transition-colors"
                                                style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "") border-bottom: 1px solid var(--rule);"
                                                @onclick="() => _tmStepIndex = idx">
                                                <td class="px-2 py-1.5 font-mono tnum">@idx</td>
                                                <td class="px-2 py-1.5 font-mono font-semibold">@st.State.CurrentNodeLabel</td>
                                                <td class="px-2 py-1.5 font-mono">@st.State.Tape</td>
                                                <td class="px-2 py-1.5 font-mono tnum">@st.State.HeadIndex</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="overflow-x-auto rounded-md" style="border: 1px solid var(--border);">
                                <table class="w-full text-[11px] text-left">
                                    <thead style="background: var(--raised); border-bottom: 1px solid var(--border);">
                                        <tr>
                                            <th class="px-2 py-1.5 font-semibold">#</th>
                                            <th class="px-2 py-1.5 font-semibold">Config (q, tape)</th>
                                            <th class="px-2 py-1.5 font-semibold">Transition</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < _tmTrace.MicroTrace.Count; i++)
                                        {
                                            var idx = i;
                                            var ms = _tmTrace.MicroTrace[idx];
                                            var isCur = idx == _tmStepIndex;
                                            <tr class="cursor-pointer transition-colors"
                                                style="@(isCur ? "background: var(--accent-soft); color: var(--text);" : "") border-bottom: 1px solid var(--rule);"
                                                @onclick="() => _tmStepIndex = idx">
                                                <td class="px-2 py-1.5 font-mono tnum">@ms.Step</td>
                                                <td class="px-2 py-1.5 font-mono whitespace-nowrap">@ms.ConfigString</td>
                                                <td class="px-2 py-1.5 font-mono whitespace-nowrap" style="color: var(--muted);">@ms.TransitionText</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else if (_tmRightTab == "dsl")
                    {
                        <div class="bp-card p-3 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold">Composable Machine-Schema DSL</span>
                                <button type="button" class="bp-btn-primary !h-7 text-xs" @onclick="CompileAndRunTmDsl">Compile &amp; Run</button>
                            </div>
                            <textarea class="bp-textarea w-full text-xs" rows="13" @bind="_tmDslText"></textarea>
