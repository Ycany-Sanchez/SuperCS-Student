    private void LoadPresetKey(string key, bool recordRecent)
    {
        if (DfaExamples.Any(e => e.Key == key))
        {
            SelectDfaExample(key, recordRecent);
            _activeMode = StudioMode.Dfa;
            return;
        }

        if (NfaExamples.Any(e => e.Key == key))
        {
            SelectNfaExample(key, recordRecent);
            _activeMode = StudioMode.Nfa;
            return;
        }

        if (CfgExamples.Any(e => e.Key == key))
        {
            SelectCfgExample(key, recordRecent);
            _activeMode = StudioMode.Cfg;
            return;
        }

        if (PdaExamples.Any(e => e.Key == key))
        {
            SelectPdaExample(key, recordRecent);
            _activeMode = StudioMode.Pda;
            return;
        }

        if (TmExamples.Any(e => e.Key == key))
        {
            SelectTmExample(key, recordRecent);
            _activeMode = StudioMode.TuringMachine;
            return;
        }

        if (!AutomataPresets.ByKey.TryGetValue(key, out var preset)) return;

        switch (preset.Kind)
        {
            case AutomataPresetKind.FiniteAutomaton:
                _dfaExampleKey = CustomKey;
                _faInput = preset.DefaultInput;
                _faSampleInputs = preset.SampleInputs;
                if (!string.IsNullOrWhiteSpace(preset.ConstraintSpec))
                {
                    _faSourceKind = "constraint";
                    _faSpecText = preset.ConstraintSpec;
                }
                else if (!string.IsNullOrWhiteSpace(preset.RegexPattern))
                {
                    _faSourceKind = "regex";
                    _faSpecText = preset.RegexPattern;
                }
                _faAlphabetText = string.Empty;
                BuildFaFromSpec(updateSamples: false);
                _activeMode = StudioMode.Dfa;
                break;

            case AutomataPresetKind.ContextFreeGrammar:
                _cfgExampleKey = CustomKey;
                _cfgText = preset.GrammarText ?? _cfgText;
                _cfgInput = preset.DefaultInput;
                _cfgSampleInputs = preset.SampleInputs;
                ParseCfgAndInput();
                _activeMode = StudioMode.Cfg;
                break;

            case AutomataPresetKind.PushdownAutomaton:
                _pdaExampleKey = CustomKey;
                _pdaTransitionsText = preset.PdaTransitionsText ?? _pdaTransitionsText;
                _pdaInput = preset.DefaultInput;
                _pdaSampleInputs = preset.SampleInputs;
                ParseAndTracePda();
                _activeMode = StudioMode.Pda;
                break;

            case AutomataPresetKind.TuringMachine:
                _tmExampleKey = CustomKey;
                _tmDslText = preset.TmSchemaText ?? _tmDslText;
                _tmInput = preset.DefaultInput;
                _tmSampleInputs = preset.SampleInputs;
                _tmHeadStart = HeadStartMode.RightBlank;
                CompileAndRunTmDsl();
                _activeMode = StudioMode.TuringMachine;
                break;
        }

        if (recordRecent)
        {
            RecordExampleRecent(preset.Key, preset.Title, preset.Description);
        }
    }

    private void RoutePendingSpec(string spec, string? alphaRaw)
    {
        try
        {
            var alpha = ParseAlphabetInput(alphaRaw);
            var compiled = LanguageSpecCompiler.Compile(spec, LanguageSpecMode.Auto, alpha);
            var samples = ExtractSampleInputs(compiled.SuggestedTests);
            var preferredInput = PickPreferredInput(compiled.SuggestedTests);

            if (compiled.MinimalDfa is not null)
            {
                _faMinDfa = compiled.MinimalDfa;
                _faRawDfa = compiled.ResolvedMode == LanguageSpecMode.Regex && compiled.Nfa is not null
                    ? compiled.Nfa.ToDfa(renameStates: true)
                    : compiled.MinimalDfa;
                _faSpecText = spec;
                _faAlphabetText = alphaRaw ?? string.Empty;
                _faSourceKind = "auto";
                _faViewKind = "min";
                _dfaExampleKey = CustomKey;
                if (samples is not null) _faSampleInputs = samples;
                if (preferredInput is not null) _faInput = preferredInput;
                _faError = null;
                TraceFa();
                _activeMode = StudioMode.Dfa;
            }
            else if (compiled.Pda is not null)
            {
                _pdaTransitionsText = compiled.Pda.ToTransitionsText();
                _pdaSynthSpec = spec;
                _pdaSynthAlphabet = alphaRaw ?? string.Empty;
                _pdaExampleKey = CustomKey;
                if (samples is not null) _pdaSampleInputs = samples;
                if (preferredInput is not null) _pdaInput = preferredInput;
                _pdaSynthError = null;
                ParseAndTracePda();
                _activeMode = StudioMode.Pda;
            }
            else
            {
                _tmDslText = compiled.TmSchema.ToDslText();
                _tmSynthSpec = spec;
                _tmSynthAlphabet = alphaRaw ?? string.Empty;
                _tmHeadStart = compiled.TmSchema.HeadStart;
                _tmExampleKey = CustomKey;
                if (samples is not null) _tmSampleInputs = samples;
                if (preferredInput is not null) _tmInput = preferredInput;
                _tmSynthError = null;
                CompileAndRunTmDsl();
                _activeMode = StudioMode.TuringMachine;
            }
        }
        catch (Exception ex)
        {
            _faError = ex.Message;
            _activeMode = StudioMode.Dfa;
        }
    }

