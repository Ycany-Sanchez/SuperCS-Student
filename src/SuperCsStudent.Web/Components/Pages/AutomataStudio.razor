    private void BuildFaFromSpec(bool updateSamples)
    {
        try
        {
            _faError = null;
            var alpha = ParseAlphabetInput(_faAlphabetText);

            if (_faSourceKind == "constraint")
            {
                var compiled = LanguageSpecCompiler.CompileConstraint(_faSpecText, alpha);
                _faMinDfa = compiled.MinimalDfa;
                _faRawDfa = compiled.Nfa?.ToDfa(renameStates: true) ?? compiled.MinimalDfa;
                ApplyFaSuggestedSamples(compiled.SuggestedTests, updateSamples);
            }
            else if (_faSourceKind == "regex")
            {
                var compiled = RegexCompiler.Compile(_faSpecText, alpha);
                _faMinDfa = compiled.MinimalDfa;
                _faRawDfa = compiled.Dfa;
                if (updateSamples)
                {
                    var specRes = LanguageSpecCompiler.CompileRegex(_faSpecText, alpha);
                    ApplyFaSuggestedSamples(specRes.SuggestedTests, updateSamples: true);
                }
            }
            else
            {
                var compiled = LanguageSpecCompiler.Compile(_faSpecText, LanguageSpecMode.Auto, alpha);
                if (compiled.MinimalDfa is null)
                {
                    _faError = $"'{_faSpecText}' is {compiled.LanguageClass} (not regular). Switch to CFG, PDA, or Turing Machine to synthesize it.";
                    return;
                }
                _faMinDfa = compiled.MinimalDfa;
                _faRawDfa = compiled.ResolvedMode == LanguageSpecMode.Regex
                    ? RegexCompiler.Compile(_faSpecText, alpha).Dfa
                    : compiled.Nfa?.ToDfa(renameStates: true) ?? compiled.MinimalDfa;
                ApplyFaSuggestedSamples(compiled.SuggestedTests, updateSamples);
            }

            TraceFa();
        }
        catch (Exception ex)
        {
            _faError = ex.Message;
        }
    }

    private void ApplyFaSuggestedSamples(IReadOnlyList<LanguageTestCase>? tests, bool updateSamples)
    {
        if (!updateSamples) return;
        var samples = ExtractSampleInputs(tests);
        if (samples is not null)
        {
            _faSampleInputs = samples;
        }
        if (_faMinDfa is not null && !InputFitsAlphabet(_faInput, _faMinDfa.Alphabet))
        {
            var preferred = PickPreferredInput(tests);
            if (preferred is not null)
            {
                _faInput = preferred;
            }
        }
    }

