    protected override void OnInitialized()
    {
        // Pre-initialize all 6 workbenches so tab switching is instant
        CompileSpec();
        BuildFaFromSpec();
        BuildNfaFromSpec();
        ParseCfgAndInput();
        ParseAndTracePda();

        var pendingSpec = AppState.PendingAutomataSpec;
        var pendingAlpha = AppState.PendingAutomataAlphabet;
        AppState.PendingAutomataSpec = null;
        AppState.PendingAutomataAlphabet = null;

        var initialKey = !string.IsNullOrWhiteSpace(AppState.PendingPresetKey) && AutomataPresets.ByKey.ContainsKey(AppState.PendingPresetKey)
            ? AppState.PendingPresetKey
            : "tm-palindrome";
        AppState.PendingPresetKey = null;
        LoadPreset(initialKey);

        if (!string.IsNullOrWhiteSpace(pendingSpec))
        {
            _specMode = LanguageSpecMode.Auto;
            _specText = pendingSpec;
            _specAlphabetText = pendingAlpha ?? string.Empty;
            _activeMode = StudioMode.Compiler;
            CompileSpec();
        }
    }

    private void SwitchMode(StudioMode mode)
    {
        _activeMode = mode;
        var syncedKey = mode switch
        {
            StudioMode.Dfa or StudioMode.Nfa => "dfa-contains-aba",
            StudioMode.Cfg => "cfg-arith",
            StudioMode.Pda => "pda-anbn",
            StudioMode.TuringMachine => "tm-palindrome",
            _ => _selectedPresetKey
        };
        if (AutomataPresets.ByKey.ContainsKey(syncedKey))
        {
            _selectedPresetKey = syncedKey;
        }
    }

    private static string FormatPresetGroup(AutomataPresetKind kind) => kind switch
    {
        AutomataPresetKind.FiniteAutomaton => "Finite Automata (DFA / NFA)",
        AutomataPresetKind.ContextFreeGrammar => "Context-Free Grammars",
        AutomataPresetKind.PushdownAutomaton => "Pushdown Automata (PDA)",
        AutomataPresetKind.TuringMachine => "Turing Machines",
        _ => kind.ToString()
    };

    private void OnPresetChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(key))
        {
            LoadPreset(key);
        }
    }

    private void LoadPreset(string key)
    {
        if (!AutomataPresets.ByKey.TryGetValue(key, out var preset)) return;
        _selectedPresetKey = key;

        switch (preset.Kind)
        {
            case AutomataPresetKind.FiniteAutomaton:
                _activeMode = StudioMode.Dfa;
                _faInput = preset.DefaultInput;
                _faSampleInputs = preset.SampleInputs;
                if (!string.IsNullOrWhiteSpace(preset.ConstraintSpec))
                {
                    _faSourceKind = "constraint";
                    _faSpecText = preset.ConstraintSpec;
                }
                else if (!string.IsNullOrWhiteSpace(preset.RegexPattern))
                {
                    _faSourceKind = "regex";
                    _faSpecText = preset.RegexPattern;
                }
                _faAlphabetText = string.Empty;
                BuildFaFromSpec();
                break;

            case AutomataPresetKind.ContextFreeGrammar:
                _activeMode = StudioMode.Cfg;
                _cfgText = preset.GrammarText ?? _cfgText;
                _cfgInput = preset.DefaultInput;
                _cfgSampleInputs = preset.SampleInputs;
                ParseCfgAndInput();
                break;

            case AutomataPresetKind.PushdownAutomaton:
                _activeMode = StudioMode.Pda;
                _pdaTransitionsText = preset.PdaTransitionsText ?? _pdaTransitionsText;
                _pdaInput = preset.DefaultInput;
                _pdaSampleInputs = preset.SampleInputs;
                ParseAndTracePda();
                break;

            case AutomataPresetKind.TuringMachine:
                _activeMode = StudioMode.TuringMachine;
                _tmDslText = preset.TmSchemaText ?? _tmDslText;
                _tmInput = preset.DefaultInput;
                _tmSampleInputs = preset.SampleInputs;
                _tmHeadStart = HeadStartMode.RightBlank;
                CompileAndRunTmDsl();
                break;
        }

        AppState.RecordRecent(new WorkspaceDocument(
            $"auto-{preset.Key}",
            preset.Title,
            StudioKind.Automata,
            preset.Description,
            DateTimeOffset.UtcNow,
            JsonSerializer.SerializeToElement(new { preset = preset.Key })));
    }

    private static IEnumerable<char>? ParseAlphabetInput(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        var chars = new List<char>();
        foreach (var token in raw.Split(new[] { ',', ' ', ';', '\t', '{', '}' }, StringSplitOptions.RemoveEmptyEntries))
        {
            foreach (var ch in token.Trim())
            {
                if (!chars.Contains(ch))
                {
                    chars.Add(ch);
                }
            }
        }
        return chars.Count > 0 ? chars : null;
    }

    // ==================== COMPILER MODE ====================

    private void OnSpecKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            CompileSpec();
        }
    }

    private void SetBuilderTemplate(string template)
    {
        _builderTemplate = template;
        var curSyms = ParseAlphabetInput(_builderSymbols)?.ToList() ?? new List<char>();
        if (template == "3block" && curSyms.Count < 3)
        {
            _builderSymbols = curSyms.Count == 2 && curSyms[0] == 'x' && curSyms[1] == 'y'
                ? "x,y,z"
                : "a,b,c";
        }
        else if (template != "3block" && curSyms.Count >= 3)
        {
            _builderSymbols = $"{curSyms[0]},{curSyms[1]}";
        }
    }

    private string BuildCustomSpecPreview()
    {
        var syms = ParseAlphabetInput(_builderSymbols)?
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .Distinct()
            .ToList() ?? new List<char>();

        var s1 = syms.Count > 0 ? syms[0] : 'a';
        var s2 = syms.Count > 1 ? syms[1] : (s1 == 'a' ? 'b' : 'y');
        var s3 = syms.Count > 2 ? syms[2] : (s2 == 'b' ? 'c' : 'z');

        if (_builderTemplate == "3block")
        {
            var boundSuffix = _builderMinBound > 0 ? $", n, m, k >= {_builderMinBound}" : "";
            return $"{s1}^n {s2}^m {s3}^k where {_builderThreeRel}{boundSuffix}";
        }

        var rhsMul = _builderMultiplier == 1 ? "m" : $"{_builderMultiplier}m";
        var rhsOff = _builderOffset switch
        {
            > 0 => $" + {_builderOffset}",
            < 0 => $" - {System.Math.Abs(_builderOffset)}",
            _ => ""
        };

        if (_builderTemplate == "count")
        {
            var cRhs = _builderMultiplier == 1 ? $"#{s2}" : $"{_builderMultiplier}*#{s2}";
            var extraAlpha = syms.Count > 2 ? $"{{ w in {{{string.Join(",", syms)}}}* | #{s1}(w) {_builderOp} {cRhs}{rhsOff} }}" : $"#{s1} {_builderOp} {cRhs}{rhsOff}";
            return extraAlpha;
        }

        var minPart = _builderMinBound > 0 ? $", n, m >= {_builderMinBound}" : "";
        return $"{s1}^n {s2}^m where n {_builderOp} {rhsMul}{rhsOff}{minPart}";
    }

    private void ApplyCustomBuilder()
    {
        _specMode = LanguageSpecMode.Auto;
        _specText = BuildCustomSpecPreview();
        _specAlphabetText = string.Empty;
        CompileSpec();
        RunAutoTestSuite();
    }

    private void SaveCustomProblemToWorkspace()
    {
        if (_compiledSpec is null) return;
        var id = $"auto-custom-{Math.Abs(_compiledSpec.Specification.GetHashCode())}";
        AppState.RecordRecent(new WorkspaceDocument(
            id,
            _compiledSpec.Title,
            StudioKind.Automata,
            $"{_compiledSpec.LanguageClass} · {_compiledSpec.Specification}",
            DateTimeOffset.UtcNow,
            JsonSerializer.SerializeToElement(new
            {
                customSpec = _compiledSpec.Specification,
                alphabet = _specAlphabetText
            })));
        _savedProblemNotice = true;
    }

    private void CompileSpec()
    {
        try
        {
            _compilerError = null;
            _savedProblemNotice = false;
            var alpha = ParseAlphabetInput(_specAlphabetText);
            _compiledSpec = LanguageSpecCompiler.Compile(_specText, _specMode, alpha);
            _compilerPreviewKind = _compiledSpec.MinimalDfa is not null
                ? "dfa"
                : _compiledSpec.Pda is not null
                    ? "pda-stack"
                    : "tm";
            _lastValidCompilerScene = GetCompilerPreviewScene();
            if (_compiledSpec.SuggestedTests is { Count: > 0 } tests)
            {
                var preferredPos = tests.FirstOrDefault(t => t.ExpectedAccept && t.Input != "e" && t.Input.Length >= 2)
                    ?? tests.FirstOrDefault(t => t.ExpectedAccept)
                    ?? tests[0];
                _compilerTestInput = preferredPos.Input;
            }
            RefreshCompilerPdaTrace();
            _compilerTestRows.Clear();
            RunCompilerTest();
        }
        catch (Exception ex)
        {
            _compilerError = ex.Message;
        }
    }

    private void RefreshCompilerPdaTrace()
    {
        var input = string.IsNullOrEmpty(_compilerTestInput) ? "e" : _compilerTestInput;

        if (_compiledSpec?.Pda is null)
        {
            _compilerPdaTrace = null;
            _compilerPdaStepIndex = 0;
        }
        else
        {
            _compilerPdaTrace = PdaTracer.Trace(_compiledSpec.Pda, input);
            var firstStackIdx = -1;
            for (var i = 0; i < _compilerPdaTrace.Timeline.Steps.Count; i++)
            {
                if (_compilerPdaTrace.Timeline.Steps[i].State.StackFrames.Count >= 2)
                {
                    firstStackIdx = i;
                    break;
                }
            }
            if (firstStackIdx < 0)
            {
                firstStackIdx = _compilerPdaTrace.Timeline.Steps.Count > 1 ? 1 : 0;
            }
            _compilerPdaStepIndex = firstStackIdx;
        }

        if (_compiledSpec?.Grammar is null)
        {
            _compilerCfgResult = null;
            _compilerCfgStepIndex = 0;
        }
        else
        {
            _compilerCfgResult = CfgParser.Parse(_compiledSpec.Grammar, input);
            _compilerCfgStepIndex = _compilerCfgResult.QueueSteps is { Count: > 1 } ? 1 : 0;
        }
    }

    private void InspectCompilerRow(string input)
    {
        _compilerTestInput = input;
        RefreshCompilerPdaTrace();
    }

    private void RunCompilerExample(string spec, string sampleInput)
    {
        _specMode = LanguageSpecMode.Auto;
        _specText = spec;
        _specAlphabetText = string.Empty;
        _compilerTestInput = sampleInput;
        CompileSpec();
    }

    private DiagramScene? GetCompilerPreviewScene()
    {
        if (_compiledSpec is null) return _lastValidCompilerScene;
        var scene = _compilerPreviewKind switch
        {
            "dfa" when _compiledSpec.MinimalDfa is not null => _compiledSpec.MinimalDfa.ToDiagramScene(caption: _compiledSpec.Title),
            "nfa" when _compiledSpec.Nfa is not null => _compiledSpec.Nfa.ToDiagramScene(caption: _compiledSpec.Title),
            "pda" when _compiledSpec.Pda is not null => _compiledSpec.Pda.ToDiagramScene(caption: _compiledSpec.Title),
            _ => _compiledSpec.CompiledTm.SchemaScene
        };
        _lastValidCompilerScene = scene;
        return scene;
    }

    private void RunCompilerTest()
    {
        if (_compiledSpec is null) return;
        var input = string.IsNullOrEmpty(_compilerTestInput) ? "e" : _compilerTestInput;
        var tmRes = _compiledSpec.CompiledTm.Trace(input);
        bool? accepted = _compiledSpec.MinimalDfa is not null
            ? _compiledSpec.MinimalDfa.Accepts(input)
            : tmRes.AcceptedDecision;

        var detail = _compiledSpec.LanguageClass == LanguageClass.Transducer
            ? $"Tape: {tmRes.TrimmedTape} ({tmRes.MicroTrace.Count - 1} steps)"
            : $"TM: {tmRes.TrimmedTape} ({tmRes.MacroTrace.Count - 1} macro / {tmRes.MicroTrace.Count - 1} micro)";

        _compilerTestRows.Insert(0, new CompilerTestRow(input, accepted, detail));
        if (_compilerTestRows.Count > 10) _compilerTestRows.RemoveAt(_compilerTestRows.Count - 1);
        RefreshCompilerPdaTrace();
    }

    private void RunAutoTestSuite()
    {
        if (_compiledSpec?.SuggestedTests is null) return;
        _compilerTestRows.Clear();
        foreach (var tc in _compiledSpec.SuggestedTests)
        {
            var tmRes = _compiledSpec.CompiledTm.Trace(tc.Input);
            bool? accepted = _compiledSpec.MinimalDfa is not null
                ? _compiledSpec.MinimalDfa.Accepts(tc.Input)
                : tmRes.AcceptedDecision;
            var detail = $"{tmRes.MacroTrace.Count - 1} macro / {tmRes.MicroTrace.Count - 1} micro";
            _compilerTestRows.Add(new CompilerTestRow(tc.Input, accepted, detail, tc.ExpectedAccept, tc.Reason));
        }
    }

    private IReadOnlyList<string> BuildCompiledSampleInputs(IReadOnlyList<string> fallback)
    {
        if (_compiledSpec?.SuggestedTests is { Count: > 0 } tests)
        {
            return tests.Select(t => t.Input).Distinct().Take(6).ToArray();
        }
        return fallback;
    }

    private void OpenCompiledInDfa()
    {
        if (_compiledSpec?.MinimalDfa is null) return;
        _faMinDfa = _compiledSpec.MinimalDfa;
        _faRawDfa = _compiledSpec.MinimalDfa;
        _faSpecText = _compiledSpec.Specification;
        _faAlphabetText = _specAlphabetText;
        _faSourceKind = _compiledSpec.ResolvedMode == LanguageSpecMode.Constraint ? "constraint" : "regex";
        _faViewKind = "min";
        _faSampleInputs = BuildCompiledSampleInputs(_faSampleInputs);
        _faInput = _compilerTestInput;
        _faError = null;
        TraceFa();
        _activeMode = StudioMode.Dfa;
    }

    private void OpenCompiledInNfa()
    {
        if (_compiledSpec?.Nfa is null) return;
        _currentNfa = _compiledSpec.Nfa;
        _nfaRequiredDeterminization = _compiledSpec.NfaRequiredDeterminization;
        _nfaDeterminizationReason = _compiledSpec.NfaDeterminizationReason;
        _nfaSpecText = _compiledSpec.Specification;
        _nfaAlphabetText = _specAlphabetText;
        _nfaSourceKind = _compiledSpec.ResolvedMode == LanguageSpecMode.Constraint ? "constraint" : "regex";
        _nfaSampleInputs = BuildCompiledSampleInputs(_nfaSampleInputs);
        _nfaInput = _compilerTestInput;
        _nfaError = null;
        RefreshNfaSubsetAndTrace();
        _activeMode = StudioMode.Nfa;
    }

    private void OpenCompiledInCfg()
    {
        if (_compiledSpec?.Grammar is null) return;
        _cfgText = _compiledSpec.Grammar.ToGrammarText();
        _cfgSampleInputs = BuildCompiledSampleInputs(_cfgSampleInputs);
        _cfgInput = _compilerTestInput;
        ParseCfgAndInput();
        _activeMode = StudioMode.Cfg;
    }

    private void OpenCompiledInPda()
    {
        if (_compiledSpec?.Pda is null) return;
        _pdaTransitionsText = _compiledSpec.Pda.ToTransitionsText();
        _pdaSampleInputs = BuildCompiledSampleInputs(_pdaSampleInputs);
        _pdaInput = _compilerTestInput;
        ParseAndTracePda();
        _activeMode = StudioMode.Pda;
    }

    private void OpenCompiledInTm()
    {
        if (_compiledSpec is null) return;
        _tmDslText = _compiledSpec.TmSchema.ToDslText();
        _tmSampleInputs = BuildCompiledSampleInputs(_tmSampleInputs);
        _tmInput = _compilerTestInput;
        _tmHeadStart = _compiledSpec.TmSchema.HeadStart;
        CompileAndRunTmDsl();
        _activeMode = StudioMode.TuringMachine;
    }

    // ==================== DFA MODE ====================

    private Dfa? ActiveDfa => _faViewKind == "dfa" ? _faRawDfa : _faMinDfa;

    private TraceStep<FaStepState>? CurrentFaStep =>
        _faTimeline is { Steps.Count: > 0 }
            ? _faTimeline.Steps[System.Math.Clamp(_faStepIndex, 0, _faTimeline.Steps.Count - 1)]
            : null;

    private DiagramScene? CurrentFaScene => CurrentFaStep?.State.Scene ?? _lastValidFaScene;

    private void BuildFaFromSpec()
    {
        try
        {
            _faError = null;
            var alpha = ParseAlphabetInput(_faAlphabetText);
            if (_faSourceKind == "constraint")
            {
                var dfa = LanguageSpecCompiler.CompileConstraintToDfa(_faSpecText, alpha);
                _faMinDfa = dfa;
                _faRawDfa = dfa;
            }
            else
            {
                var compiled = RegexCompiler.Compile(_faSpecText, alpha);
                _faMinDfa = compiled.MinimalDfa;
                _faRawDfa = compiled.Dfa;
            }
            TraceFa();
        }
        catch (Exception ex)
        {
            _faError = ex.Message;
        }
    }

    private void SwitchFaView(string view)
    {
        _faViewKind = view;
        TraceFa();
    }

    private void TraceFa()
    {
        if (ActiveDfa is not null)
        {
            _faTimeline = FaTracer.Trace(ActiveDfa, _faInput);
        }
        _faStepIndex = 0;
        if (CurrentFaStep is not null)
        {
            _lastValidFaScene = CurrentFaStep.State.Scene;
        }
    }

    private void ApplyFaComplement()
    {
        if (_faMinDfa is null) return;
        _faMinDfa = FaOperations.Complement(_faMinDfa);
        _faRawDfa = _faMinDfa;
        _faViewKind = "min";
        TraceFa();
    }

    private void ApplyFaStar()
    {
        if (_faMinDfa is null) return;
        _faMinDfa = FaOperations.KleeneStar(_faMinDfa);
        _faRawDfa = _faMinDfa;
        _faViewKind = "min";
        TraceFa();
    }

    // ==================== NFA MODE ====================

    private TraceStep<FaStepState>? CurrentNfaStep =>
        _nfaTimeline is { Steps.Count: > 0 }
            ? _nfaTimeline.Steps[System.Math.Clamp(_nfaStepIndex, 0, _nfaTimeline.Steps.Count - 1)]
            : null;

    private DiagramScene? CurrentNfaScene => CurrentNfaStep?.State.Scene ?? _lastValidNfaScene;

    private void BuildNfaFromSpec()
    {
        try
        {
            _nfaError = null;
            var alpha = ParseAlphabetInput(_nfaAlphabetText);
            if (_nfaSourceKind == "constraint")
            {
                var compiled = LanguageSpecCompiler.CompileConstraintToNfa(_nfaSpecText, alpha);
                _currentNfa = compiled.Nfa;
                _nfaRequiredDeterminization = compiled.RequiredDeterminization;
                _nfaDeterminizationReason = compiled.DeterminizationReason;
            }
            else
            {
                var compiled = RegexCompiler.Compile(_nfaSpecText, alpha);
                _currentNfa = compiled.Nfa.CompactLiteralChains();
                _nfaRequiredDeterminization = false;
                _nfaDeterminizationReason = null;
            }
            RefreshNfaSubsetAndTrace();
        }
        catch (Exception ex)
        {
            _nfaError = ex.Message;
        }
    }

    private void RunNfaExample(string spec, string sampleInput)
    {
        _nfaSourceKind = "constraint";
        _nfaSpecText = spec;
        _nfaAlphabetText = string.Empty;
        _nfaInput = sampleInput;
        BuildNfaFromSpec();
    }

    private void RefreshNfaSubsetAndTrace()
    {
        if (_currentNfa is null) return;
        _currentNfa.ToDfaWithSubsetMap(out var subsetMap, renameStates: true);
        _nfaSubsetMap = subsetMap;
        TraceNfa();
    }

    private void TraceNfa()
    {
        if (_currentNfa is null) return;
        _nfaTimeline = FaTracer.Trace(_currentNfa, _nfaInput);
        _nfaStepIndex = 0;
        if (CurrentNfaStep is not null)
        {
            _lastValidNfaScene = CurrentNfaStep.State.Scene;
        }
    }

    private void ConvertCurrentNfaToDfa()
    {
        if (_currentNfa is null) return;
        var raw = _currentNfa.ToDfa(renameStates: true);
        _faRawDfa = raw;
        _faMinDfa = raw.Minimize();
        _faSpecText = _nfaSpecText;
        _faAlphabetText = _nfaAlphabetText;
        _faSourceKind = _nfaSourceKind;
        _faViewKind = "min";
        _faInput = _nfaInput;
        _faSampleInputs = _nfaSampleInputs;
        _faError = null;
        TraceFa();
        _activeMode = StudioMode.Dfa;
    }

    private void SendDfaToTm()
    {
        if (_faMinDfa is null) return;
        var schema = LanguageSpecCompiler.DfaToDecidableTmSchema(_faMinDfa, $"Decider ({_faSpecText})");
        _tmDslText = schema.ToDslText();
        _tmInput = _faInput;
        _tmHeadStart = HeadStartMode.RightBlank;
        CompileAndRunTmDsl();
        _activeMode = StudioMode.TuringMachine;
    }

    private void SendGrammarToCfg(Cfg grammar)
    {
        _cfgText = grammar.ToGrammarText();
        _cfgInput = _faInput;
        ParseCfgAndInput();
        _activeMode = StudioMode.Cfg;
    }

    private void CompareWithSecondFa()
    {
        if (_faMinDfa is null) return;
        try
        {
            _faCompareError = null;
            var compiled = LanguageSpecCompiler.Compile(_faCompareSpec, LanguageSpecMode.Auto, _faMinDfa.OrderedAlphabet);
            if (compiled.MinimalDfa is null)
            {
                _faCompareError = "Second specification must be a regular expression or Boolean regular constraint.";
                return;
            }
            _faCompareDfa = compiled.MinimalDfa;
            _faCompareEquiv = FaOperations.AreEquivalent(_faMinDfa, _faCompareDfa);
            _faCompareSub12 = FaOperations.IsSubsetOf(_faMinDfa, _faCompareDfa);
            _faCompareSub21 = FaOperations.IsSubsetOf(_faCompareDfa, _faMinDfa);
        }
        catch (Exception ex)
        {
            _faCompareError = ex.Message;
        }
    }

    private void CombineFa(string op)
    {
        if (_faMinDfa is null || _faCompareDfa is null) return;
        _faMinDfa = op switch
        {
            "union" => FaOperations.Union(_faMinDfa, _faCompareDfa),
            "intersect" => FaOperations.Intersection(_faMinDfa, _faCompareDfa),
            "diff" => FaOperations.Difference(_faMinDfa, _faCompareDfa),
            "concat" => FaOperations.Concatenation(_faMinDfa, _faCompareDfa),
            _ => _faMinDfa
        };
        _faRawDfa = _faMinDfa;
        _faViewKind = "min";
        TraceFa();
    }

    // ==================== CFG MODE ====================

    private void ParseCfgAndInput()
    {
        try
        {
            _cfgError = null;
            _currentCfg = Cfg.ParseFromText(_cfgText);
            _cfgParseResult = CfgParser.Parse(_currentCfg, _cfgInput);
            _cfgStepIndex = 0;
        }
        catch (Exception ex)
        {
            _cfgError = ex.Message;
        }
    }

    private void ConvertCurrentCfgToPda()
    {
        if (_currentCfg is null) return;
        var pda = CfgToPdaConverter.Convert(_currentCfg);
        _pdaTransitionsText = pda.ToTransitionsText();
        _pdaInput = _cfgInput;
        ParseAndTracePda();
        _activeMode = StudioMode.Pda;
    }

    private void ConvertCurrentCfgToNfa()
    {
        if (_currentCfg is null || !_currentCfg.IsRegularGrammar()) return;
        _currentNfa = RegularGrammarConverter.RegularGrammarToNfa(_currentCfg);
        _nfaRequiredDeterminization = false;
        _nfaDeterminizationReason = null;
        _nfaInput = _cfgInput;
        _nfaError = null;
        RefreshNfaSubsetAndTrace();
        _activeMode = StudioMode.Nfa;
    }

    // ==================== PDA MODE ====================

    private void ParseAndTracePda()
    {
        try
        {
            _pdaError = null;
            _currentPda = PushdownAutomaton.ParseTransitions(_pdaTransitionsText);
            TracePda();
        }
        catch (Exception ex)
        {
            _pdaError = ex.Message;
        }
    }

    private void TracePda()
    {
        if (_currentPda is null) return;
        _pdaResult = PdaTracer.Trace(_currentPda, _pdaInput);
        _pdaStepIndex = 0;
    }

    // ==================== TURING MACHINE MODE ====================

    private int CurrentTmTotalSteps => _tmTrace is null
        ? 0
        : _tmMicroMode ? _tmTrace.MicroTrace.Count : _tmTrace.MacroTimeline.Steps.Count;

    private TapeSnapshot CurrentTmTapeSnapshot
    {
        get
        {
            if (_tmTrace is null)
            {
                return new("—", "No trace available", "##", 1);
            }

            if (_tmMicroMode && _tmTrace.MicroTrace.Count > 0)
            {
                var idx = System.Math.Clamp(_tmStepIndex, 0, _tmTrace.MicroTrace.Count - 1);
                var ms = _tmTrace.MicroTrace[idx];
                return new(ms.State, ms.TransitionText, ms.Tape, ms.HeadIndex);
            }

            if (_tmTrace.MacroTimeline.Steps.Count > 0)
            {
                var idx = System.Math.Clamp(_tmStepIndex, 0, _tmTrace.MacroTimeline.Steps.Count - 1);
                var st = _tmTrace.MacroTimeline.Steps[idx];
                return new(st.State.CurrentNodeLabel, st.State.ActionSummary, st.State.Tape, st.State.HeadIndex);
            }

            return new(_tmTrace.FinalState, _tmTrace.HaltReason.ToString(), _tmTrace.FinalTape, _tmTrace.FinalHeadIndex);
        }
    }

    private DiagramScene? CurrentTmScene
    {
        get
        {
            if (_tmTrace is null) return _lastValidTmScene;
            if (!_tmMicroMode && _tmTrace.MacroTimeline.Steps.Count > 0)
            {
                var idx = System.Math.Clamp(_tmStepIndex, 0, _tmTrace.MacroTimeline.Steps.Count - 1);
                var scene = _tmTrace.MacroTimeline.Steps[idx].State.SchemaScene;
                _lastValidTmScene = scene;
                return scene;
            }
            return _tmTrace.SchemaDiagram;
        }
    }

    private void CompileAndRunTmDsl()
    {
        try
        {
            _tmError = null;
            var schema = TmSchemaParser.Parse(_tmDslText, "Turing Machine Schema");
            _tmCompiled = TmSchemaCompiler.Compile(schema);
            RunTmTrace();
        }
        catch (Exception ex)
        {
            _tmError = ex.Message;
        }
    }

    private void RunTmTrace()
    {
        if (_tmCompiled is null) return;
        _tmTrace = _tmCompiled.Trace(_tmInput, headStartOverride: _tmHeadStart);
        _tmStepIndex = 0;
        _lastValidTmScene = CurrentTmScene;
    }

    private void OnTmHeadStartChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<HeadStartMode>(e.Value?.ToString(), out var mode))
        {
            _tmHeadStart = mode;
            RunTmTrace();
        }
    }

    private void SwitchTmGranularity(bool micro)
    {
        _tmMicroMode = micro;
        _tmStepIndex = 0;
    }

    private async Task ExportTmTable()
    {
        if (_tmCompiled is null) return;
        await JS.InvokeVoidAsync("SuperCs.storage.downloadTextFile", "turing-machine-table.txt", _tmCompiled.Machine.ToTransitionTableText(), "text/plain;charset=utf-8");
    }
}
