@page "/daa"
@implements IAsyncDisposable
@inject AppStateService AppState
@inject IJSRuntime JS

@using System.Text.Json
@using SuperCsStudent.Algorithms.Analysis
@using SuperCsStudent.Algorithms.Ast
@using SuperCsStudent.Algorithms.Config
@using SuperCsStudent.Algorithms.Presets
@using SuperCsStudent.Algorithms.Symbolic

<div class="flex flex-col h-full min-h-0 min-w-0 w-full overflow-hidden">
    @* Slim Studio Header (2 groups only, matching Automata Studio) *@
    <div class="px-4 py-2 flex flex-wrap items-center justify-between gap-2 shrink-0" style="border-bottom: 1px solid var(--border);">
        <div class="flex items-center gap-2.5 min-w-0 flex-wrap">
            <h1 class="text-[15px] font-semibold tracking-tight whitespace-nowrap">Runtime Analyzer</h1>
            <div class="bp-seg" role="tablist" aria-label="Analyzer mode">
                <button type="button"
                        class="bp-seg-btn"
                        role="tab"
                        aria-selected="@(!_recurrenceDirectMode ? "true" : "false")"
                        data-active="@(!_recurrenceDirectMode ? "true" : "false")"
                        @onclick="SwitchToBlockBuilderMode">
                    Block Builder
                </button>
                <button type="button"
                        class="bp-seg-btn"
                        role="tab"
                        aria-selected="@(_recurrenceDirectMode ? "true" : "false")"
                        data-active="@(_recurrenceDirectMode ? "true" : "false")"
                        @onclick="SwitchToRecurrenceMode">
                    Recurrence Solver
                </button>
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (!_recurrenceDirectMode)
            {
                <button type="button"
                        class="bp-btn-ghost !h-8 text-xs hidden lg:inline-flex"
                        title="@(_fullCanvas ? "Show analysis inspector" : "Expand workspace to full canvas")"
                        @onclick="ToggleFullCanvas">
                    @(_fullCanvas ? "Show analysis" : "Full canvas")
                </button>
            }
        </div>
    </div>

    @* Main Workbench Body *@
    @if (!_recurrenceDirectMode)
    {
        <div class="flex-1 min-h-0 min-w-0 flex flex-col lg:flex-row overflow-y-auto lg:overflow-hidden">
            @* Left Stage: Single-Row Command Strip + Blockly Workspace *@
            <div class="flex-1 min-w-0 flex flex-col min-h-[380px] lg:min-h-0 relative"
                 style="@(!_fullCanvas ? "border-right: 1px solid var(--border);" : "")">
                @* Single-Row Command Strip *@
                <div class="px-3 py-2 shrink-0" style="background: var(--surface); border-bottom: 1px solid var(--border);">
                    <div class="bp-cmd-strip">
                        <div class="bp-cmd-row !py-2 !px-2.5 items-end">
                            <div class="bp-cmd-preset" style="flex: 0 1 310px;">
                                <label for="daa-preset-select" class="bp-field-label">Algorithm</label>
                                <div class="bp-select-wrap">
                                    <svg class="bp-select-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                        <path d="M5.5 4L2 8l3.5 4M10.5 4L14 8l-3.5 4M9 3l-2 10" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                    <select id="daa-preset-select"
                                            class="bp-select-prominent"
                                            aria-label="Select algorithm preset"
                                            value="@_selectedPresetKey"
                                            @onchange="OnPresetChanged">
                                        <option value="@AlgorithmPresets.Blank.Key">@AlgorithmPresets.Blank.Title</option>
                                        @foreach (var category in AlgorithmPresets.OrderedCategories)
                                        {
                                            var items = AlgorithmPresets.All
                                                .Where(p => p.Category == category && p.Key != AlgorithmPresets.Blank.Key)
                                                .ToList();
                                            if (items.Count > 0)
                                            {
                                                <optgroup label="@category">
                                                    @foreach (var p in items)
                                                    {
                                                        <option value="@p.Key">@p.Title</option>
                                                    }
                                                </optgroup>
                                            }
                                        }
                                    </select>
                                    <svg class="bp-select-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                        <path d="M4 6L8 10L12 6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 ml-auto">
                                <span class="hidden sm:inline-flex items-center h-8 px-2.5 rounded-md font-mono text-[11.5px] max-w-[200px] truncate"
                                      style="background: var(--surface); border: 1px solid var(--border); color: var(--muted);"
                                      title="@FunctionSignature">
                                    @FunctionSignature
                                </span>
                                <button type="button"
                                        class="bp-btn-secondary !h-8 text-xs"
                                        title="Fit blocks to workspace view"
                                        @onclick="FitBlocklyWorkspace">
                                    Fit
                                </button>
                                @if (_selectedPresetKey != AlgorithmPresets.Blank.Key || (_currentAst?.Body.Count ?? 0) > 0)
                                {
                                    <button type="button"
                                            class="bp-btn-ghost !h-8 text-xs"
                                            title="Reset to blank algorithm(n) template"
                                            @onclick="LoadBlankTemplate">
                                        Blank
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @* Blockly Workspace *@
                <div class="flex-1 min-h-[320px] w-full relative overflow-hidden">
                    <div @ref="_blocklyHost" class="w-full h-full"></div>

                    @* Bottom-Left Floating Cost Rules Button *@
                    <button type="button"
                            class="daa-cost-fab"
                            data-active="@(_rulesTabOpen && _activeAnalysisTab == "rules" ? "true" : "false")"
                            title="Configure operation cost rules"
                            @onclick="OpenCostRulesTab">
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                            <path d="M2.5 4.5h3m3 0h5M2.5 8h7m3 0h1M2.5 11.5h4.5m3 0h3.5" stroke-linecap="round" />
                            <circle cx="7" cy="4.5" r="1.5" />
                            <circle cx="11" cy="8" r="1.5" />
                            <circle cx="8.5" cy="11.5" r="1.5" />
                        </svg>
                        <span>Cost Rules</span>
                        <span class="daa-cost-fab-badge">@ProfileShortLabel</span>
                    </button>
                </div>
            </div>

            @* Right Analysis Inspector *@
            @if (!_fullCanvas)
            {
                <div class="w-full lg:w-[500px] xl:w-[560px] shrink-0 flex flex-col min-h-[420px] lg:min-h-0 overflow-hidden">
                    @* Pinned Verdict Strip (Always Visible Across All Tabs) *@
                    <div class="p-3 pb-2.5 shrink-0" style="border-bottom: 1px solid var(--border);">
                        <div class="bp-formal-top space-y-1.5">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <div class="flex items-center gap-1.5">
                                    <div class="bp-seg" role="group" aria-label="Runtime case">
                                        <button type="button"
                                                class="bp-seg-btn !h-6 !px-2 !text-[11.5px]"
                                                data-active="@(_selectedCase == "worst" ? "true" : "false")"
                                                @onclick='() => SetSelectedCase("worst")'>
                                            Worst
                                        </button>
                                        <button type="button"
                                                class="bp-seg-btn !h-6 !px-2 !text-[11.5px]"
                                                data-active="@(_selectedCase == "best" ? "true" : "false")"
                                                @onclick='() => SetSelectedCase("best")'>
                                            Best
                                        </button>
                                    </div>
                                    @if (_analysis is not null && _analysis.WorstCase.Plain == _analysis.BestCase.Plain)
                                    {
                                        <span class="bp-pill bp-pill-neutral !h-5 !px-1.5 !text-[10.5px] font-medium"
                                              title="Worst-case and best-case runtimes are identical">
                                            Same
                                        </span>
                                    }
                                </div>

                                @if (_analysis is not null)
                                {
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="bp-pill bp-pill-accent font-mono !h-6 !px-2 !text-[11px]">@_analysis.Asymptotic.BigO</span>
                                        <span class="bp-pill @(_analysis.Asymptotic.IsTight ? "bp-pill-positive" : "bp-pill-neutral") font-mono !h-6 !px-2 !text-[11px]">
                                            @(_analysis.Asymptotic.IsTight ? _analysis.Asymptotic.BigTheta : "Θ: Not tight")
                                        </span>
                                        <button type="button"
                                                class="bp-btn-ghost !h-6 !px-1.5 text-[11px] font-mono"
                                                title="Copy T(n) LaTeX"
                                                @onclick="CopyHeadlineLatex">
                                            @(_copiedLatex ? "Copied" : "LaTeX")
                                        </button>
                                        <button type="button"
                                                class="bp-btn-ghost !h-6 !px-1.5 text-[11px] font-mono"
                                                title="Export Markdown report"
                                                @onclick="ExportReportMarkdown">
                                            MD
                                        </button>
                                    </div>
                                }
                            </div>

                            @if (_analysis is not null)
                            {
                                <div class="overflow-x-auto py-0.5">
                                    <MathFormula DisplayMode="true" Latex="@($"T({_analysis.PrimaryVariable}) = {(ActiveCase?.Latex ?? "0")}")" />
                                </div>
                            }

                            @if ((_currentAst?.Body.Count ?? 0) == 0)
                            {
                                <div class="text-[11.5px]" style="color: var(--muted);">
                                    Drag blocks from the top bar into algorithm(n), or pick an example.
                                </div>
                            }
                        </div>
                    </div>

                    @* Underline Tabs *@
                    <div class="px-3 flex items-center gap-0.5 shrink-0 overflow-x-auto"
                         style="border-bottom: 1px solid var(--border);"
                         role="tablist"
                         aria-label="Analysis views">
                        <button type="button"
                                class="bp-tab !px-2.5 !text-xs"
                                role="tab"
                                aria-selected="@(_activeAnalysisTab == "code" ? "true" : "false")"
                                data-active="@(_activeAnalysisTab == "code" ? "true" : "false")"
                                @onclick='() => SetAnalysisTab("code")'>
                            Code
                        </button>
                        <button type="button"
                                class="bp-tab !px-2.5 !text-xs"
                                role="tab"
                                aria-selected="@(_activeAnalysisTab == "derivation" ? "true" : "false")"
                                data-active="@(_activeAnalysisTab == "derivation" ? "true" : "false")"
                                @onclick='() => SetAnalysisTab("derivation")'>
                            Derivation
                        </button>
                        <button type="button"
                                class="bp-tab !px-2.5 !text-xs"
                                role="tab"
                                aria-selected="@(_activeAnalysisTab == "asymptotic" ? "true" : "false")"
                                data-active="@(_activeAnalysisTab == "asymptotic" ? "true" : "false")"
                                @onclick='() => SetAnalysisTab("asymptotic")'>
                            O / Ω / Θ
                        </button>
                        <button type="button"
                                class="bp-tab !px-2.5 !text-xs"
                                role="tab"
                                aria-selected="@(_activeAnalysisTab == "chart" ? "true" : "false")"
                                data-active="@(_activeAnalysisTab == "chart" ? "true" : "false")"
                                @onclick='() => SetAnalysisTab("chart")'>
                            Chart
                        </button>
                        @if (_rulesTabOpen)
                        {
                            <div class="bp-tab !px-2 !text-xs"
                                 role="tab"
                                 tabindex="0"
                                 aria-selected="@(_activeAnalysisTab == "rules" ? "true" : "false")"
                                 data-active="@(_activeAnalysisTab == "rules" ? "true" : "false")"
                                 @onclick='() => SetAnalysisTab("rules")'
                                 @onkeydown='e => { if (e.Key is "Enter" or " ") SetAnalysisTab("rules"); }'>
                                <span>Cost Rules</span>
                                <button type="button"
                                        class="daa-tab-close"
                                        title="Close Cost Rules tab"
                                        aria-label="Close Cost Rules tab"
                                        @onclick="CloseCostRulesTab"
                                        @onclick:stopPropagation="true">
                                    ×
                                </button>
                            </div>
                        }
                    </div>

                    @* Tab Panels *@
                    <div class="flex-1 min-h-0 overflow-y-auto p-3.5 space-y-3.5">
                        @if (_activeAnalysisTab == "code")
                        {
                            <div class="flex items-center justify-between gap-2 text-xs">
                                <span class="font-medium" style="color: var(--muted);">
                                    Annotated Code (@(_selectedCase == "best" ? "Best" : "Worst"))
                                </span>
                                <label class="inline-flex items-center gap-1.5 cursor-pointer select-none" style="color: var(--muted);">
                                    <input type="checkbox" class="accent-[var(--accent)]" @bind="_showInlineBadges" />
                                    <span>Op details</span>
                                </label>
                            </div>

                            @if (ActiveCase is not null && ActiveCase.AnnotatedLines.Count > 0)
                            {
                                var loopColors = BuildLoopColorMap(ActiveCase);
                                var maxRailDepth = ActiveCase.AnnotatedLines.Max(l => GetLineChain(l).Count);
                                var lnColWidth = Math.Max(30, maxRailDepth * 6 + 24);
                                <div class="daa-code-grid" style="grid-template-columns: @(lnColWidth)px minmax(0, 1fr) minmax(96px, auto);">
                                    @foreach (var line in ActiveCase.AnnotatedLines)
                                    {
                                        var isHovered = !string.IsNullOrEmpty(_hoveredBlockId) && _hoveredBlockId == line.BlockId;
                                        var chain = GetLineChain(line);
                                        var inBox = chain.Count > 0;
                                        var loopVar = inBox ? LoopColorVar(loopColors, chain[^1]) : null;
                                        var railShadow = inBox ? BuildStackedRailShadow(chain, loopColors) : null;
                                        var rowStyle = inBox
                                            ? $"--loop-accent: {loopVar}; box-shadow: {railShadow};"
                                            : null;

                                        @if (!string.IsNullOrEmpty(line.BoxHeaderLabel))
                                        {
                                            var boxInfo = !string.IsNullOrEmpty(line.BoxGroupId)
                                                ? ActiveCase.InnerBoxes.FirstOrDefault(b => b.BoxGroupId == line.BoxGroupId)
                                                : null;
                                            var headColor = !string.IsNullOrEmpty(line.BoxGroupId)
                                                ? LoopColorVar(loopColors, line.BoxGroupId)
                                                : "var(--warning)";
                                            var headPadLeft = chain.Count > 0 ? chain.Count * 6 + 8 : 10;
                                            var headStyle = $"--loop-accent: {headColor}; padding-left: {headPadLeft}px;{(railShadow is not null ? $" box-shadow: {railShadow};" : "")}";
                                            <div class="daa-code-box-head"
                                                 style="@headStyle"
                                                 @onmouseenter="() => OnHoverBlock(line.BlockId)"
                                                 @onmouseleave="() => OnHoverBlock(null)">
                                                @if (boxInfo is not null)
                                                {
                                                    <span class="font-mono font-semibold" style="color: @headColor;">@boxInfo.Label</span>
                                                    <span class="tnum overflow-x-auto" style="color: var(--text);">
                                                        <MathFormula Latex="@boxInfo.Latex" />
                                                    </span>
                                                }
                                                else
                                                {
                                                    var eqIdx = line.BoxHeaderLabel.IndexOf(" = ", StringComparison.Ordinal);
                                                    if (eqIdx > 0)
                                                    {
                                                        <span class="font-mono font-semibold" style="color: @headColor;">@(line.BoxHeaderLabel.Substring(0, eqIdx))</span>
                                                        <span class="font-mono tnum" style="color: var(--text);">@(line.BoxHeaderLabel.Substring(eqIdx + 3))</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="font-mono font-semibold" style="color: @headColor;">@line.BoxHeaderLabel</span>
                                                    }
                                                }
                                            </div>
                                        }

                                        <div class="daa-code-row @(inBox ? "daa-code-inbox" : "")"
                                             style="@rowStyle"
                                             data-hovered="@(isHovered ? "true" : "false")"
                                             @onmouseenter="() => OnHoverBlock(line.BlockId)"
                                             @onmouseleave="() => OnHoverBlock(null)">
                                            <span class="daa-code-ln" style="@(inBox ? $"padding-left: {chain.Count * 6 + 4}px;" : null)">@line.LineNumber</span>
                                            <div class="daa-code-cell">
                                                <div class="daa-code-line" style="padding-left: @(line.IndentLevel * 12)px;">@line.CodeText</div>
                                                @if (_showInlineBadges && line.InlineBadges.Count > 0)
                                                {
                                                    <div class="daa-code-ops" style="padding-left: @(line.IndentLevel * 12)px;">
                                                        @(string.Join(" · ", line.InlineBadges.Select(b => $"{b.Token} ×{b.Frequency}")))
                                                    </div>
                                                }
                                            </div>
                                            <div class="daa-cost-gutter">
                                                @if (line.LineCostLatex == "0")
                                                {
                                                    <span style="color: var(--faint);">—</span>
                                                }
                                                else
                                                {
                                                    <MathFormula Latex="@line.LineCostLatex" />
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (_activeAnalysisTab == "derivation" && _analysis is not null)
                        {
                            var derivLoopColors = ActiveCase is not null ? BuildLoopColorMap(ActiveCase) : new Dictionary<string, int>(StringComparer.Ordinal);
                            var derivBlockColors = ActiveCase is not null ? BuildBlockLoopColorMap(ActiveCase, derivLoopColors) : new Dictionary<string, int>(StringComparer.Ordinal);

                            @if (ActiveCase is not null && ActiveCase.InnerBoxes.Count > 0)
                            {
                                <div class="space-y-1.5">
                                    <div class="text-xs font-semibold">Inner Loop Boxes</div>
                                    <div class="bp-card overflow-hidden">
                                        @foreach (var box in ActiveCase.InnerBoxes.OrderBy(b => derivLoopColors.GetValueOrDefault(b.BoxGroupId, 99)))
                                        {
                                            var boxHovered = !string.IsNullOrEmpty(box.BlockId) && _hoveredBlockId == box.BlockId;
                                            var boxColor = LoopColorVar(derivLoopColors, box.BoxGroupId);
                                            <div class="px-3 py-2 flex items-center justify-between gap-2 cursor-pointer transition-colors"
                                                 style="border-bottom: 1px solid var(--rule); border-left: 3px solid @boxColor; @(boxHovered ? "background: var(--accent-soft);" : $"background: color-mix(in srgb, {boxColor} 7%, var(--canvas-well));")"
                                                 @onmouseenter="() => OnHoverBlock(box.BlockId)"
                                                 @onmouseleave="() => OnHoverBlock(null)">
                                                <span class="font-mono text-xs font-semibold" style="color: @boxColor;">@box.Label</span>
                                                <div class="overflow-x-auto text-xs"><MathFormula Latex="@box.Latex" /></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (ActiveCase is not null)
                            {
                                <div class="space-y-1.5">
                                    <div class="text-xs font-semibold">Step-by-Step Summation Derivation</div>
                                    @if (ActiveCase.DerivationSteps.Count == 0)
                                    {
                                        <div class="bp-well px-3 py-2.5 text-xs" style="color: var(--muted);">
                                            No operations counted yet. Add statements to the function to derive T(@_analysis.PrimaryVariable).
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bp-card overflow-hidden">
                                            <ol class="daa-step-list">
                                                @for (var i = 0; i < ActiveCase.DerivationSteps.Count; i++)
                                                {
                                                    var step = ActiveCase.DerivationSteps[i];
                                                    var stepHovered = !string.IsNullOrEmpty(step.BlockId) && step.BlockId == _hoveredBlockId;
                                                    var stepColorIdx = 0;
                                                    var hasLoopColor = !string.IsNullOrEmpty(step.BlockId) && derivBlockColors.TryGetValue(step.BlockId, out stepColorIdx);
                                                    var stepAccent = hasLoopColor ? $"var(--loop-c{stepColorIdx % LoopPaletteSize})" : null;
                                                    <li class="daa-step-item"
                                                        style="@(hasLoopColor ? $"border-left: 3px solid {stepAccent};" : null)"
                                                        data-hovered="@(stepHovered ? "true" : "false")"
                                                        @onmouseenter="() => OnHoverBlock(step.BlockId)"
                                                        @onmouseleave="() => OnHoverBlock(null)">
                                                        <div class="flex items-center justify-between gap-2">
                                                            <span class="text-[11px] font-medium" style="color: @(hasLoopColor ? stepAccent : "var(--muted)");">@step.Label</span>
                                                            <span class="text-[10.5px] font-mono tnum" style="color: var(--faint);">@(i + 1)</span>
                                                        </div>
                                                        <div class="overflow-x-auto text-sm">
                                                            <MathFormula Latex="@step.Latex" />
                                                        </div>
                                                    </li>
                                                }
                                            </ol>
                                        </div>
                                    }
                                </div>
                            }

                            @if (_analysis.Recurrence is not null)
                            {
                                @RenderRecurrenceSummary(_analysis.Recurrence)
                            }
                        }
                        else if (_activeAnalysisTab == "asymptotic" && _analysis is not null)
                        {
                            <div class="space-y-3">
                                <div class="grid grid-cols-3 gap-2">
                                    <div class="bp-well p-2.5">
                                        <div class="text-[11px]" style="color: var(--muted);">Upper (Big-O)</div>
                                        <div class="mt-1 font-mono text-sm font-semibold"><MathFormula Latex="@_analysis.Asymptotic.BigOLatex" /></div>
                                    </div>
                                    <div class="bp-well p-2.5">
                                        <div class="text-[11px]" style="color: var(--muted);">Lower (Big-Ω)</div>
                                        <div class="mt-1 font-mono text-sm font-semibold"><MathFormula Latex="@_analysis.Asymptotic.BigOmegaLatex" /></div>
                                    </div>
                                    <div class="bp-well p-2.5">
                                        <div class="text-[11px]" style="color: var(--muted);">Tight (Big-Θ)</div>
                                        <div class="mt-1 font-mono text-sm font-semibold">
                                            @if (_analysis.Asymptotic.IsTight)
                                            {
                                                <MathFormula Latex="@_analysis.Asymptotic.BigThetaLatex" />
                                            }
                                            else
                                            {
                                                <span style="color: var(--muted);">Not tight</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="bp-card p-3 space-y-2">
                                    <div class="flex items-center justify-between text-xs font-semibold">
                                        <span>Big-O Witness Proof</span>
                                        <span class="font-mono tnum" style="color: var(--accent);">c = @_analysis.Asymptotic.BigOProof.C, n₀ = @_analysis.Asymptotic.BigOProof.N0</span>
                                    </div>
                                    <div class="space-y-1.5 overflow-x-auto">
                                        @foreach (var line in _analysis.Asymptotic.BigOProof.StepsLatex)
                                        {
                                            <div><MathFormula Latex="@line" /></div>
                                        }
                                    </div>
                                </div>

                                <div class="bp-card p-3 space-y-2">
                                    <div class="flex items-center justify-between text-xs font-semibold">
                                        <span>Big-Ω Witness Proof</span>
                                        <span class="font-mono tnum" style="color: var(--positive);">c = @_analysis.Asymptotic.BigOmegaProof.C, n₀ = @_analysis.Asymptotic.BigOmegaProof.N0</span>
                                    </div>
                                    <div class="space-y-1.5 overflow-x-auto">
                                        @foreach (var line in _analysis.Asymptotic.BigOmegaProof.StepsLatex)
                                        {
                                            <div><MathFormula Latex="@line" /></div>
                                        }
                                    </div>
                                </div>

                                <div class="bp-well p-3 text-xs" style="color: var(--muted);">
                                    @_analysis.Asymptotic.BigThetaSummary
                                </div>
                            </div>
                        }
                        else if (_activeAnalysisTab == "chart" && _analysis is not null)
                        {
                            <div class="space-y-3">
                                <div class="flex flex-wrap items-center gap-3 text-xs">
                                    @foreach (var s in _analysis.GrowthChartSeries)
                                    {
                                        <span class="inline-flex items-center gap-1.5">
                                            <span class="w-2.5 h-2.5 rounded-full inline-block"
                                                  style="background: @(s.IsPrimary ? "var(--accent)" : (s.Stroke ?? "var(--muted)"));"></span>
                                            <span>@s.Label</span>
                                        </span>
                                    }
                                </div>
                                <div @ref="_chartHost" class="bp-well p-3 min-h-[240px]"></div>
                            </div>
                        }
                        else if (_activeAnalysisTab == "rules")
                        {
                            <div class="space-y-3">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="text-xs font-semibold">Operation Cost Profile</span>
                                    <span class="text-[11px]" style="color: var(--muted);">Updates T(n) live</span>
