                                    </button>

                                    <button type="button"
                                            class="daa-preset-card"
                                            data-active="@(_profile.Preset == CostProfilePreset.StrictSeparateOp ? "true" : "false")"
                                            @onclick="() => ApplyProfilePreset(CostProfilePreset.StrictSeparateOp)">
                                        <div class="flex items-center justify-between gap-2">
                                            <span class="text-xs font-semibold">Strict Separate-Op</span>
                                            @if (_profile.Preset == CostProfilePreset.StrictSeparateOp)
                                            {
                                                <span class="bp-pill bp-pill-accent !h-5 !px-1.5 !text-[10px]">Active</span>
                                            }
                                        </div>
                                        <p class="mt-1 text-[11px] leading-snug" style="color: var(--muted);">
                                            2 for ++/+=, counts return/declare/logical ops
                                        </p>
                                    </button>
                                </div>

                                <details class="bp-card p-3" open="@(_profile.Preset == CostProfilePreset.Custom)">
                                    <summary class="text-xs font-semibold cursor-pointer select-none">
                                        Customize individual rules (10)
                                    </summary>

                                    <div class="mt-3 space-y-3 text-xs">
                                        <div>
                                            <div class="text-[10.5px] font-semibold uppercase tracking-wider mb-1" style="color: var(--faint);">Operators</div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">++ / -- cost</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.UnaryIncrementCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, UnaryIncrementCost = 1 })">1</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.UnaryIncrementCost == 2 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, UnaryIncrementCost = 2 })">2</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">+= / *= cost</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.CompoundAssignCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, CompoundAssignCost = 1 })">1</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.CompoundAssignCost == 2 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, CompoundAssignCost = 2 })">2</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">Logical &amp;&amp; / ||</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.LogicalOperatorCost == 0 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, LogicalOperatorCost = 0 })">0</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.LogicalOperatorCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, LogicalOperatorCost = 1 })">1</button>
                                                </div>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="text-[10.5px] font-semibold uppercase tracking-wider mb-1" style="color: var(--faint);">Statements &amp; Access</div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">array[i] access</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.ArrayIndexingCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, ArrayIndexingCost = 1 })">1</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.ArrayIndexingCost == 0 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, ArrayIndexingCost = 0 })">0</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">Var declare</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.DeclarationCost == 0 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, DeclarationCost = 0 })">0</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.DeclarationCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, DeclarationCost = 1 })">1</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">return keyword</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.ReturnKeywordCost == 0 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, ReturnKeywordCost = 0 })">0</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.ReturnKeywordCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, ReturnKeywordCost = 1 })">1</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">Function call</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.FunctionCallCost == 1 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, FunctionCallCost = 1 })">1</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.FunctionCallCost == 0 ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, FunctionCallCost = 0 })">0</button>
                                                </div>
                                            </div>
                                        </div>

                                        <div>
                                            <div class="text-[10.5px] font-semibold uppercase tracking-wider mb-1" style="color: var(--faint);">Loop Conventions</div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">Bound arith</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 !text-[11px]" data-active="@(!_profile.CountLoopBoundArithmetic ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, CountLoopBoundArithmetic = false })">Off</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 !text-[11px]" data-active="@(_profile.CountLoopBoundArithmetic ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, CountLoopBoundArithmetic = true })">Count</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">Log loop (i*=b)</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.LogLoopConvention == LogLoopConvention.ExactLogBase ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, LogLoopConvention = LogLoopConvention.ExactLogBase })">log_b n</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.LogLoopConvention == LogLoopConvention.FloorLogPlusOne ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, LogLoopConvention = LogLoopConvention.FloorLogPlusOne })">+1</button>
                                                </div>
                                            </div>
                                            <div class="bp-rule-row">
                                                <span style="color: var(--muted);">Stride (i+=s)</span>
                                                <div class="bp-seg">
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.StepLoopConvention == StepLoopConvention.AlgebraicRatio ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, StepLoopConvention = StepLoopConvention.AlgebraicRatio })">n / s</button>
                                                    <button type="button" class="bp-seg-btn !h-6 !px-2 font-mono !text-[11px]" data-active="@(_profile.StepLoopConvention == StepLoopConvention.CeilingOffset ? "true" : "false")" @onclick="() => UpdateProfile(_profile with { Preset = CostProfilePreset.Custom, StepLoopConvention = StepLoopConvention.CeilingOffset })">ceil</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @* Direct Recurrence & Master Theorem Solver View *@
        <div class="flex-1 min-h-0 overflow-y-auto p-6">
            <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6">
                <div class="lg:col-span-5 bp-card p-4 space-y-4 self-start">
                    <div class="space-y-2">
                        <h2 class="text-sm font-semibold">Recurrence Specification</h2>
                        <div class="bp-well px-3 py-2 overflow-x-auto">
                            <MathFormula DisplayMode="true" Latex="@LiveRecurrencePreviewLatex" />
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <label for="daa-quick-rec-select" class="bp-field-label">Quick Recurrence</label>
                        <div class="bp-select-wrap">
                            <svg class="bp-select-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M3 4.5h10M3 8h6.5M3 11.5h10" stroke-linecap="round" />
                            </svg>
                            <select id="daa-quick-rec-select"
                                    class="bp-select-prominent"
                                    aria-label="Select quick recurrence"
                                    value="@_selectedQuickRecKey"
                                    @onchange="OnQuickRecurrenceChanged">
                                @if (_selectedQuickRecKey == "custom")
                                {
                                    <option value="custom">Custom recurrence</option>
                                }
                                @foreach (var qr in QuickRecurrences)
                                {
                                    <option value="@qr.Key">@qr.Label</option>
                                }
                            </select>
                            <svg class="bp-select-chevron" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                <path d="M4 6L8 10L12 6" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <div class="bp-field-label">Recurrence kind</div>
                        <div class="bp-seg w-full" role="group" aria-label="Recurrence kind">
                            <button type="button"
                                    class="bp-seg-btn flex-1"
                                    data-active="@(_recKind == "divide" ? "true" : "false")"
                                    @onclick='() => SetRecKind("divide")'>
                                Divide: a·T(n/b)
                            </button>
                            <button type="button"
                                    class="bp-seg-btn flex-1"
                                    data-active="@(_recKind == "subtract" ? "true" : "false")"
                                    @onclick='() => SetRecKind("subtract")'>
                                Subtract: a·T(n-c)
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 text-xs">
                        <label class="space-y-1">
                            <span style="color: var(--muted);">Branches (a)</span>
                            <input type="number" min="1" max="16" class="bp-input w-full font-mono" @bind="_recA" @bind:after="SolveDirectRecurrence" />
                        </label>

                        @if (_recKind == "divide")
                        {
                            <label class="space-y-1">
                                <span style="color: var(--muted);">Divisor (b &gt; 1)</span>
                                <input type="number" min="2" max="16" class="bp-input w-full font-mono" @bind="_recB" @bind:after="SolveDirectRecurrence" />
                            </label>
                        }
                        else
                        {
                            <label class="space-y-1">
                                <span style="color: var(--muted);">Step decrement (c)</span>
                                <input type="number" min="1" max="10" class="bp-input w-full font-mono" @bind="_recC" @bind:after="SolveDirectRecurrence" />
                            </label>
                        }

                        <label class="space-y-1">
                            <span style="color: var(--muted);">Work degree k in n^k</span>
                            <input type="number" min="0" max="4" class="bp-input w-full font-mono" @bind="_recK" @bind:after="SolveDirectRecurrence" />
                        </label>

                        <label class="space-y-1">
                            <span style="color: var(--muted);">Log power p in (log n)^p</span>
                            <input type="number" min="-1" max="3" class="bp-input w-full font-mono" @bind="_recP" @bind:after="SolveDirectRecurrence" />
                        </label>

                        <label class="space-y-1 col-span-2">
                            <span style="color: var(--muted);">Base case T(base) = 1</span>
                            <input type="number" min="0" max="1" class="bp-input w-full font-mono" @bind="_recBaseN" @bind:after="SolveDirectRecurrence" />
                        </label>
                    </div>
                </div>

                <div class="lg:col-span-7 space-y-4">
                    @if (_directRecurrence is not null)
                    {
                        @RenderRecurrenceSummary(_directRecurrence)
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record QuickRecurrencePreset(string Key, string Label, int A, int B, int C, int K, int P, int BaseN);

    private static readonly QuickRecurrencePreset[] QuickRecurrences =
    {
        new("div-2-2-n", "2T(n/2) + n — Divide-and-Conquer Linear", 2, 2, 0, 1, 0, 1),
        new("div-2-3-1", "2T(n/3) + 1 — Sublinear Branching", 2, 3, 0, 0, 0, 1),
        new("sub-1-1-1", "T(n-1) + 1 — Linear Step", 1, 0, 1, 0, 0, 0),
        new("sub-1-1-n", "T(n-1) + n — Triangular Sum", 1, 0, 1, 1, 0, 0),
        new("sub-1-1-logn", "T(n-1) + log n — Logarithmic Step", 1, 0, 1, 0, 1, 0),
        new("sub-3-1-1", "3T(n-1) + 1 — Exponential Branching", 3, 0, 1, 0, 0, 0)
    };

    private ElementReference _blocklyHost;
    private ElementReference _chartHost;
    private DotNetObjectReference<DaaAnalyzer>? _selfRef;
    private bool _blocklyMounted;
    private bool? _lastBlocklyDark;
    private bool _chartRendered;

    private string _selectedPresetKey = AlgorithmPresets.Blank.Key;
    private CostRulesProfile _profile = CostRulesProfile.StandardUnitCost;
    private AlgorithmFunction? _currentAst;
    private string? _pendingBlocklyJson;
    private RuntimeAnalysisResult? _analysis;

    private string _selectedCase = "worst";
    private string _activeAnalysisTab = "code";
    private string _lastNonRulesTab = "code";
    private bool _rulesTabOpen;
    private bool _fullCanvas;
    private bool _copiedLatex;
    private bool _showInlineBadges;
    private string? _hoveredBlockId;
    private bool _needsChartRender;

    private bool _recurrenceDirectMode;
    private string _recKind = "divide";
    private int _recA = 2;
    private int _recB = 2;
    private int _recC = 1;
    private int _recK = 1;
    private int _recP = 0;
    private int _recBaseN = 1;
    private string _selectedQuickRecKey = "div-2-2-n";
    private RecurrenceAnalysisResult? _directRecurrence;

    private CaseAnalysis? ActiveCase => _analysis is null
        ? null
        : (_selectedCase == "best" ? _analysis.BestCase : _analysis.WorstCase);

    private string FunctionSignature
    {
        get
        {
            var name = _currentAst?.Name ?? "algorithm";
            var parameters = _currentAst?.Parameters is { Count: > 0 } p ? string.Join(", ", p) : "n";
            return $"{name}({parameters})";
        }
    }

    private string ProfileShortLabel => _profile.Preset switch
    {
        CostProfilePreset.StandardUnitCost => "Unit-Cost",
        CostProfilePreset.StrictSeparateOp => "Strict",
        _ => "Custom"
    };

    private string ProfileDisplayLabel => _profile.Preset switch
    {
        CostProfilePreset.StandardUnitCost => "Standard Unit-Cost",
        CostProfilePreset.StrictSeparateOp => "Strict Separate-Op",
        _ => "Custom"
    };

    private string LiveRecurrencePreviewLatex =>
        !string.IsNullOrWhiteSpace(_directRecurrence?.RecurrenceLatex)
            ? _directRecurrence.RecurrenceLatex
            : BuildFallbackRecurrenceLatex();

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChanged;
        var key = !string.IsNullOrEmpty(AppState.PendingPresetKey) && AlgorithmPresets.TryGet(AppState.PendingPresetKey, out _)
            ? AppState.PendingPresetKey!
            : AlgorithmPresets.Blank.Key;
        AppState.PendingPresetKey = null;
        LoadPreset(key);
        if (_directRecurrence is null)
        {
            SolveDirectRecurrence();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_recurrenceDirectMode && !_blocklyMounted)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            var darkAtMount = AppState.IsDark;
            await JS.InvokeVoidAsync("SuperCs.blockly.mountBlockly", _blocklyHost, _selfRef, _pendingBlocklyJson, darkAtMount);
            _blocklyMounted = true;
            _lastBlocklyDark = darkAtMount;
            _pendingBlocklyJson = null;
        }
        else if (_recurrenceDirectMode && _blocklyMounted)
        {
            try
            {
                await JS.InvokeVoidAsync("SuperCs.blockly.disposeBlockly", _blocklyHost);
            }
            catch { }
            _blocklyMounted = false;
            _lastBlocklyDark = null;
        }
        else if (!_recurrenceDirectMode && _blocklyMounted && _pendingBlocklyJson is not null)
        {
            var json = _pendingBlocklyJson;
            _pendingBlocklyJson = null;
            await JS.InvokeVoidAsync("SuperCs.blockly.loadWorkspaceState", _blocklyHost, json);
        }

        if (!_recurrenceDirectMode && _blocklyMounted && _lastBlocklyDark != AppState.IsDark)
        {
            var dark = AppState.IsDark;
            _lastBlocklyDark = dark;
            await JS.InvokeVoidAsync("SuperCs.blockly.setBlocklyTheme", _blocklyHost, dark);
        }

        if (!_recurrenceDirectMode && !_fullCanvas && _activeAnalysisTab == "chart" && _analysis is not null && (_needsChartRender || firstRender))
        {
            _needsChartRender = false;
            await RenderGrowthChartAsync();
        }
    }

    [JSInvokable]
    public void OnWorkspaceChanged(string astJson)
    {
        try
        {
            _currentAst = AlgorithmAstSerializer.Deserialize(astJson);
            Recompute();
            StateHasChanged();
        }
        catch
        {
            // Keep last valid analysis on incomplete block drag
        }
    }

    private void LoadPreset(string key)
    {
        AlgorithmPreset? preset;
        if (string.Equals(key, AlgorithmPresets.Blank.Key, StringComparison.OrdinalIgnoreCase))
        {
            preset = AlgorithmPresets.Blank;
        }
        else if (!AlgorithmPresets.TryGet(key, out preset) || preset is null)
        {
            return;
        }

        _selectedPresetKey = preset.Key;
        _currentAst = preset.Ast;
        _pendingBlocklyJson = preset.BlocklyStateJson;

        if (preset.RecurrenceSpec is not null)
        {
            var spec = preset.RecurrenceSpec;
            _recKind = spec.DivideByB.HasValue ? "divide" : "subtract";
            _recA = spec.BranchesA;
            _recB = spec.DivideByB ?? 2;
            _recC = spec.SubtractC ?? 1;
            _recK = spec.WorkPolyDegreeK;
            _recP = spec.WorkLogPowerP;
            _recBaseN = spec.BaseN;
            _selectedQuickRecKey = MatchQuickRecurrenceKey();
            _directRecurrence = RecurrenceAnalyzer.Solve(spec);
        }

        Recompute();

        if (!string.Equals(preset.Key, AlgorithmPresets.Blank.Key, StringComparison.OrdinalIgnoreCase))
        {
            AppState.RecordRecent(new WorkspaceDocument(
                $"daa-{preset.Key}",
                preset.Title,
                StudioKind.Algorithms,
                $"T(n) = {_analysis?.WorstCase.Plain ?? ""}",
                DateTimeOffset.UtcNow,
                JsonSerializer.SerializeToElement(new { preset = preset.Key })));
        }
    }

    private void LoadBlankTemplate() => LoadPreset(AlgorithmPresets.Blank.Key);

    private void OnPresetChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (!string.IsNullOrEmpty(key)) LoadPreset(key);
    }

    private async Task FitBlocklyWorkspace()
    {
        if (!_blocklyMounted) return;
        try
        {
            await JS.InvokeVoidAsync("SuperCs.blockly.fitWorkspace", _blocklyHost);
        }
        catch { }
    }

    private void ToggleFullCanvas()
    {
        _fullCanvas = !_fullCanvas;
        if (!_fullCanvas && _activeAnalysisTab == "chart")
        {
            _needsChartRender = true;
        }
    }

    private void SetSelectedCase(string caseName)
    {
        _selectedCase = caseName;
    }

    private void SetAnalysisTab(string tab)
    {
        _activeAnalysisTab = tab;
        if (tab != "rules")
        {
            _lastNonRulesTab = tab;
        }
        if (tab == "chart")
        {
            _needsChartRender = true;
        }
    }

    private void OpenCostRulesTab()
    {
        if (_activeAnalysisTab != "rules")
        {
            _lastNonRulesTab = _activeAnalysisTab;
        }
        _rulesTabOpen = true;
        _activeAnalysisTab = "rules";
        _fullCanvas = false;
    }

    private void CloseCostRulesTab()
    {
        _rulesTabOpen = false;
        if (_activeAnalysisTab == "rules")
        {
            _activeAnalysisTab = _lastNonRulesTab;
            if (_activeAnalysisTab == "chart")
            {
                _needsChartRender = true;
            }
        }
    }

    private void ApplyProfilePreset(CostProfilePreset preset) => UpdateProfile(CostRulesProfile.FromPreset(preset));

    private void UpdateProfile(CostRulesProfile next)
    {
        _profile = next;
        Recompute();
    }

    private void Recompute()
    {
        if (_currentAst is null) return;
        _analysis = IterativeAnalyzer.Analyze(_currentAst, _profile);
        _needsChartRender = true;
    }

    private async Task SwitchToRecurrenceMode()
    {
        if (_recurrenceDirectMode) return;
        if (_blocklyMounted)
        {
            try
            {
                var saved = await JS.InvokeAsync<string?>("SuperCs.blockly.getWorkspaceState", _blocklyHost);
                _pendingBlocklyJson = !string.IsNullOrWhiteSpace(saved)
                    ? saved
                    : (_currentAst is not null ? AlgorithmAstSerializer.ToBlocklyWorkspaceJson(_currentAst) : null);
            }
            catch
            {
                _pendingBlocklyJson = _currentAst is not null ? AlgorithmAstSerializer.ToBlocklyWorkspaceJson(_currentAst) : null;
            }

            try
            {
                await JS.InvokeVoidAsync("SuperCs.blockly.disposeBlockly", _blocklyHost);
            }
            catch { }
            _blocklyMounted = false;
            _lastBlocklyDark = null;
        }
        else if (_pendingBlocklyJson is null && _currentAst is not null)
        {
            _pendingBlocklyJson = AlgorithmAstSerializer.ToBlocklyWorkspaceJson(_currentAst);
        }

        _recurrenceDirectMode = true;
        SolveDirectRecurrence();
    }

    private void SwitchToBlockBuilderMode()
    {
        if (!_recurrenceDirectMode) return;
        if (_pendingBlocklyJson is null && _currentAst is not null)
        {
            _pendingBlocklyJson = AlgorithmAstSerializer.ToBlocklyWorkspaceJson(_currentAst);
        }
        _recurrenceDirectMode = false;
        if (_activeAnalysisTab == "chart")
        {
            _needsChartRender = true;
        }
    }

    private void SetRecKind(string kind)
    {
        _recKind = kind;
        SolveDirectRecurrence();
    }

    private void OnQuickRecurrenceChanged(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        var match = QuickRecurrences.FirstOrDefault(q => q.Key == key);
        if (match is null) return;
        _recKind = match.B >= 2 ? "divide" : "subtract";
        _recA = match.A;
        _recB = match.B >= 2 ? match.B : 2;
        _recC = match.C >= 1 ? match.C : 1;
        _recK = match.K;
        _recP = match.P;
        _recBaseN = match.BaseN;
        _selectedQuickRecKey = match.Key;
        SolveDirectRecurrence();
    }

    private string MatchQuickRecurrenceKey()
    {
        foreach (var q in QuickRecurrences)
        {
            var isDiv = q.B >= 2;
            if ((_recKind == "divide") != isDiv) continue;
            if (_recA != q.A || _recK != q.K || _recP != q.P || _recBaseN != q.BaseN) continue;
            if (isDiv && _recB == q.B) return q.Key;
            if (!isDiv && _recC == q.C) return q.Key;
        }
        return "custom";
    }

    private string BuildWorkLatex() => (_recK, _recP) switch
    {
        (0, 0) => "1",
        (1, 0) => "n",
        (var k, 0) => $"n^{k}",
        (0, 1) => @"\log_2 n",
        (1, 1) => @"n \log_2 n",
        (var k, 1) => $@"n^{k} \log_2 n",
        (0, var p) => $@"\log_2^{{{p}}} n",
        (var k, var p) => $@"n^{k} \log_2^{{{p}}} n"
    };

    private string BuildFallbackRecurrenceLatex()
    {
        var a = System.Math.Max(1, _recA);
        var aPrefix = a == 1 ? "" : $"{a}";
        var sub = _recKind == "divide"
            ? $@"T\!\left(\frac{{n}}{{{System.Math.Max(2, _recB)}}}\right)"
            : $"T(n - {System.Math.Max(1, _recC)})";
        return $"T(n) = {aPrefix}{sub} + {BuildWorkLatex()}";
    }

    private void SolveDirectRecurrence()
    {
        var spec = new RecurrenceSpec(
            BaseN: _recBaseN,
            BaseCost: 1,
            BranchesA: System.Math.Max(1, _recA),
            DivideByB: _recKind == "divide" ? System.Math.Max(2, _recB) : null,
            SubtractC: _recKind == "subtract" ? System.Math.Max(1, _recC) : null,
            NonRecursiveWorkLatex: BuildWorkLatex(),
            WorkPolyDegreeK: _recK,
            WorkLogPowerP: _recP);

        _selectedQuickRecKey = MatchQuickRecurrenceKey();
        _directRecurrence = RecurrenceAnalyzer.Solve(spec);
    }

    private async Task OnHoverBlock(string? blockId)
    {
        if (_hoveredBlockId == blockId) return;
        _hoveredBlockId = blockId;
        if (_blocklyMounted)
        {
            try
            {
                await JS.InvokeVoidAsync("SuperCs.blockly.highlightBlock", _blocklyHost, blockId);
            }
            catch { }
        }
    }

    private async Task RenderGrowthChartAsync()
    {
        if (_analysis is null) return;
        var payload = new
        {
            series = _analysis.GrowthChartSeries.Select(s => new
            {
                label = s.Label,
                isPrimary = s.IsPrimary,
                stroke = s.Stroke,
                points = s.Points.Select(p => new { n = p.N, value = p.Value }).ToArray()
            }).ToArray()
        };
        await JS.InvokeVoidAsync("SuperCs.charts.renderGrowthChart", _chartHost, payload);
        _chartRendered = true;
    }

    private async Task CopyHeadlineLatex()
    {
        if (_analysis is null || ActiveCase is null) return;
        var latex = $"T({_analysis.PrimaryVariable}) = {ActiveCase.Latex}";
        await JS.InvokeAsync<bool>("SuperCs.storage.copyText", latex);
        _copiedLatex = true;
        StateHasChanged();
        await Task.Delay(1400);
        _copiedLatex = false;
        StateHasChanged();
    }

    private async Task ExportReportMarkdown()
    {
        if (_analysis is null) return;
        var lines = new List<string>
        {
            $"# Runtime Analysis: `{_analysis.FunctionName}`",
            "",
            $"- **Cost Profile**: `{ProfileDisplayLabel}`",
            $"- **Worst Case**: `T({_analysis.PrimaryVariable}) = {_analysis.WorstCase.Plain}`",
            $"- **Best Case**: `T({_analysis.PrimaryVariable}) = {_analysis.BestCase.Plain}`",
            $"- **Asymptotic**: `{_analysis.Asymptotic.BigO}`, `{_analysis.Asymptotic.BigOmega}`, `Θ: {_analysis.Asymptotic.BigThetaDisplay}`",
            "",
            "## Derivation Steps"
        };
        foreach (var s in _analysis.WorstCase.DerivationSteps)
        {
            lines.Add($"- **{s.Label}**: `$${s.Latex}$$`");
        }
        await JS.InvokeVoidAsync("SuperCs.storage.downloadTextFile", $"{_analysis.FunctionName}-analysis.md", string.Join('\n', lines), "text/markdown;charset=utf-8");
    }

