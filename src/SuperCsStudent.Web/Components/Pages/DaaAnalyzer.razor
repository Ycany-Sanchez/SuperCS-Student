    private const int LoopPaletteSize = 6;

    private static IReadOnlyList<string> GetLineChain(AnnotatedCodeLine line)
    {
        if (line.BoxGroupChain is { Count: > 0 }) return line.BoxGroupChain;
        if (!string.IsNullOrEmpty(line.BoxGroupId)) return new[] { line.BoxGroupId };
        return Array.Empty<string>();
    }

    private static Dictionary<string, int> BuildLoopColorMap(CaseAnalysis analysis)
    {
        var map = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var line in analysis.AnnotatedLines)
        {
            foreach (var boxId in GetLineChain(line))
            {
                if (!map.ContainsKey(boxId))
                {
                    map[boxId] = map.Count;
                }
            }
        }
        foreach (var box in analysis.InnerBoxes)
        {
            if (!map.ContainsKey(box.BoxGroupId))
            {
                map[box.BoxGroupId] = map.Count;
            }
        }
        return map;
    }

    private static Dictionary<string, int> BuildBlockLoopColorMap(
        CaseAnalysis analysis,
        Dictionary<string, int> loopColors)
    {
        var map = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var box in analysis.InnerBoxes)
        {
            if (!string.IsNullOrEmpty(box.BlockId) && loopColors.TryGetValue(box.BoxGroupId, out var idx))
            {
                map[box.BlockId] = idx;
            }
        }
        return map;
    }

    private static string LoopColorVar(Dictionary<string, int> loopColors, string boxGroupId)
    {
        var idx = loopColors.TryGetValue(boxGroupId, out var found) ? found : 0;
        return $"var(--loop-c{idx % LoopPaletteSize})";
    }

    private static string BuildStackedRailShadow(
        IReadOnlyList<string> chain,
        Dictionary<string, int> loopColors)
    {
        var layers = new List<string>(chain.Count * 2);
        for (var i = 0; i < chain.Count; i++)
        {
            var railEdge = i * 6 + 3;
            layers.Add($"inset {railEdge}px 0 0 {LoopColorVar(loopColors, chain[i])}");
            if (i < chain.Count - 1)
            {
                layers.Add($"inset {railEdge + 3}px 0 0 var(--surface)");
            }
        }
        return string.Join(", ", layers);
    }

    private async void OnAppStateChanged()
    {
        if (_blocklyMounted && _lastBlocklyDark != AppState.IsDark)
        {
            try
            {
                var dark = AppState.IsDark;
                _lastBlocklyDark = dark;
                await JS.InvokeVoidAsync("SuperCs.blockly.setBlocklyTheme", _blocklyHost, dark);
            }
            catch { }
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        AppState.OnChange -= OnAppStateChanged;
        if (_blocklyMounted)
        {
            try { await JS.InvokeVoidAsync("SuperCs.blockly.disposeBlockly", _blocklyHost); } catch { }
            _blocklyMounted = false;
            _lastBlocklyDark = null;
        }
        if (_chartRendered)
        {
            try { await JS.InvokeVoidAsync("SuperCs.charts.disposeGrowthChart", _chartHost); } catch { }
        }
        _selfRef?.Dispose();
    }
}
