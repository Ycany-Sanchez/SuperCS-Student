@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AppStateService AppState
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="h-dvh w-full max-w-full overflow-hidden flex flex-col md:flex-row bp-frame">
    @* Desktop L-Frame Sidebar (no dividing border against top bar) *@
    <aside class="hidden md:flex flex-col shrink-0 transition-[width] duration-150 select-none @(AppState.SidebarCollapsed ? "w-14" : "w-56")">
        <div class="h-12 px-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5 min-w-0">
                <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="var(--accent)" stroke-width="1.75" />
                    <circle cx="8" cy="9" r="2.2" fill="var(--accent)" />
                    <circle cx="16" cy="9" r="2.2" stroke="var(--accent)" stroke-width="1.6" />
                    <circle cx="12" cy="16" r="2.2" fill="var(--text)" />
                    <path d="M10.2 9h3.6M9.1 10.9l2 3.3M14.9 10.9l-2 3.3" stroke="var(--accent)" stroke-width="1.35" />
                </svg>
                @if (!AppState.SidebarCollapsed)
                {
                    <span class="text-sm font-semibold tracking-tight truncate" style="color: var(--text);">Super CS Student</span>
                }
            </a>
            <button type="button"
                    class="bp-btn-ghost !h-7 !w-7 !p-0"
                    title="@(AppState.SidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                    @onclick="AppState.ToggleSidebar">
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="2" y="2.5" width="12" height="11" rx="2" />
                    <path d="M6 2.5v11" />
                </svg>
            </button>
        </div>

        <nav class="flex-1 px-2 py-2 space-y-0.5 overflow-y-auto" aria-label="Studios">
            @RenderNavLink("/", "Studio Hub", "hub")
            <div class="pt-4 pb-1 px-2.5 text-xs @(AppState.SidebarCollapsed ? "hidden" : "")" style="color: var(--muted);">Workbenches</div>
            @RenderNavLink("/automata", "Automata & Languages", "automata")
            @RenderNavLink("/daa", "Runtime Analyzer", "daa")
            @RenderNavLink("/structures", "Trees & Graphs", "structures")
        </nav>

        <div class="p-2 space-y-1">
            <button type="button"
                    class="w-full h-8 px-2.5 rounded-md flex items-center gap-2.5 text-xs transition-colors cursor-pointer hover:bg-[var(--active)]"
                    style="color: var(--muted);"
                    title="Toggle theme"
                    @onclick="ToggleTheme">
                @if (AppState.IsDark)
                {
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="3.2" /><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M12.6 3.4l-1.1 1.1M4.5 11.5l-1.1 1.1" stroke-linecap="round" /></svg>
                }
                else
                {
                    <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 9.7A5.2 5.2 0 0 1 6.3 3a5.3 5.3 0 1 0 6.7 6.7Z" /></svg>
                }
                @if (!AppState.SidebarCollapsed)
                {
                    <span>@(AppState.IsDark ? "Light sheet" : "True black")</span>
                }
            </button>

            <button type="button"
                    class="w-full h-8 px-2.5 rounded-md flex items-center gap-2.5 text-xs transition-colors cursor-pointer hover:bg-[var(--active)]"
                    style="color: var(--muted);"
                    title="Workspace settings"
                    @onclick="() => AppState.SetSettingsOpen(true)">
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.2" /><path d="M8 2v1.4M8 12.6V14M2 8h1.4M12.6 8H14M3.8 3.8l1 1M11.2 11.2l1 1M12.2 3.8l-1 1M4.8 11.2l-1 1" stroke-linecap="round" /></svg>
                @if (!AppState.SidebarCollapsed)
                {
                    <span>Settings</span>
                }
            </button>
        </div>
    </aside>

    @* Right Column: Seamless 48px Top Bar + Inset White Blueprint Sheet *@
    <div class="flex-1 flex flex-col min-w-0 min-h-0">
        <header class="h-12 px-3 md:px-4 flex items-center justify-between gap-3 shrink-0">
            <div class="flex items-center gap-2.5 min-w-0">
                <button type="button" class="md:hidden bp-btn-ghost !h-8 !w-8 !p-0" @onclick="() => _mobileMenuOpen = !_mobileMenuOpen" aria-label="Menu">
                    <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round" /></svg>
                </button>
                <span class="text-sm font-medium truncate" style="color: var(--muted);">@CurrentBreadcrumb</span>
            </div>

            <div class="flex items-center gap-2">
                <button type="button"
                        class="h-8 px-2.5 rounded-md flex items-center gap-2 text-xs transition-colors cursor-pointer"
                        style="background: var(--surface); border: 1px solid var(--border); color: var(--muted);"
                        @onclick="() => AppState.SetCommandPalette(true)">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="4.5" /><path d="M10.5 10.5L13.5 13.5" stroke-linecap="round" /></svg>
                    <span class="hidden sm:inline">Search presets & studios</span>
                    <span class="bp-kbd">⌘K</span>
                </button>
            </div>
        </header>

        @* Mobile Drawer *@
        @if (_mobileMenuOpen)
        {
            <div class="md:hidden px-3 pb-3 space-y-1">
                @RenderNavLink("/", "Studio Hub", "hub")
                @RenderNavLink("/automata", "Automata & Languages", "automata")
                @RenderNavLink("/daa", "Runtime Analyzer", "daa")
                @RenderNavLink("/structures", "Trees & Graphs", "structures")
            </div>
        }

        <main class="flex-1 min-w-0 min-h-0 md:mr-2 md:mb-2 overflow-hidden bp-sheet flex flex-col">
            @Body
        </main>
    </div>
</div>

<CommandPalette />
<SettingsDrawer />

@code {
    private bool _mobileMenuOpen;
    private DotNetObjectReference<MainLayout>? _selfRef;
    private IJSObjectReference? _shortcutHandle;

    private string CurrentPath => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/') switch
    {
        "" => "/",
        var p => p
    };

    private string CurrentBreadcrumb => CurrentPath switch
    {
        "/automata" => "Automata & Formal Languages",
        "/daa" => "Algorithm Runtime Analyzer",
        "/structures" => "Tree & Graph Tracer",
        _ => "Studio Hub"
    };

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedJson = await JS.InvokeAsync<string?>("SuperCs.storage.getItem", AppStateService.StorageKey);
            if (!string.IsNullOrWhiteSpace(savedJson) && AppState.TryImportSnapshotJson(savedJson, out _, out _, mergeExistingRecents: true))
            {
                await JS.InvokeVoidAsync("SuperCs.storage.applyTheme", AppState.Theme);
                await JS.InvokeVoidAsync("SuperCs.storage.setItem", AppStateService.StorageKey, AppState.ExportSnapshotJson());
            }
            else
            {
                var initial = await JS.InvokeAsync<string>("SuperCs.storage.getInitialTheme");
                AppState.SetTheme(initial);
                AppState.MarkHydrated();
                await JS.InvokeVoidAsync("SuperCs.storage.setItem", AppStateService.StorageKey, AppState.ExportSnapshotJson());
            }

            _selfRef = DotNetObjectReference.Create(this);
            _shortcutHandle = await JS.InvokeAsync<IJSObjectReference>("SuperCs.storage.registerGlobalShortcuts", _selfRef);
        }
    }

    [JSInvokable]
    public void OnCommandPaletteShortcut()
    {
        AppState.SetCommandPalette(!AppState.CommandPaletteOpen);
    }

    private async Task ToggleTheme()
    {
        var next = AppState.IsDark ? "light" : "dark";
        AppState.SetTheme(next);
        await JS.InvokeVoidAsync("SuperCs.storage.applyTheme", next);
    }

    private RenderFragment RenderNavLink(string href, string label, string icon) => builder =>
    {
        var active = string.Equals(CurrentPath, href, StringComparison.OrdinalIgnoreCase);
        builder.OpenElement(0, "a");
        builder.AddAttribute(1, "href", href);
        builder.AddAttribute(2, "title", label);
        builder.AddAttribute(3, "class", "h-8 px-2.5 rounded-md flex items-center gap-2.5 text-[13px] transition-colors");
        builder.AddAttribute(4, "style", active
            ? "background: var(--active); color: var(--text); font-weight: 500;"
            : "color: var(--muted);");
        builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => _mobileMenuOpen = false));

        builder.AddMarkupContent(6, icon switch
        {
            "hub" => """<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>""",
            "automata" => """<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="4" cy="8" r="2.2"/><circle cx="12" cy="8" r="2.5"/><circle cx="12" cy="8" r="1.2"/><path d="M6.2 8h3.3"/></svg>""",
            "daa" => """<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 12.5h11M4 10.5l2.8-3.2 2.4 1.6L13 4"/></svg>""",
            _ => """<svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="3.5" r="1.8"/><circle cx="3.8" cy="12" r="1.8"/><circle cx="12.2" cy="12" r="1.8"/><path d="M7.1 5.1L4.6 10.3M8.9 5.1l2.5 5.2"/></svg>"""
        });

        if (!AppState.SidebarCollapsed || _mobileMenuOpen)
        {
            builder.OpenElement(7, "span");
            builder.AddAttribute(8, "class", "truncate");
            builder.AddContent(9, label);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private void OnAppStateChanged() => _ = PersistAndRefreshAsync();

    private async Task PersistAndRefreshAsync()
    {
        if (AppState.HasHydratedStorage)
        {
            try
            {
                var json = AppState.ExportSnapshotJson();
                await JS.InvokeVoidAsync("SuperCs.storage.setItem", AppStateService.StorageKey, json);
            }
            catch { }
        }
        await InvokeAsync(StateHasChanged);
    }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        AppState.OnChange -= OnAppStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_shortcutHandle is not null)
        {
            try
            {
                await _shortcutHandle.InvokeVoidAsync("dispose");
                await _shortcutHandle.DisposeAsync();
            }
            catch { }
        }
        _selfRef?.Dispose();
    }
}
