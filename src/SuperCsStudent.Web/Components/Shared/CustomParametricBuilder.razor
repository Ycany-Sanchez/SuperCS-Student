@namespace SuperCsStudent.Web.Components.Shared

<div class="space-y-2.5">
    <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="bp-seg" role="group" aria-label="@($"{TargetLabel} custom rule mode")">
            <button type="button"
                    class="bp-seg-btn"
                    data-active="@(_mode == "visual" ? "true" : "false")"
                    @onclick='() => SwitchMode("visual")'>
                Visual Builder
            </button>
            <button type="button"
                    class="bp-seg-btn"
                    data-active="@(_mode == "text" ? "true" : "false")"
                    @onclick='() => SwitchMode("text")'>
                Text Spec
            </button>
        </div>

        <div class="flex flex-wrap items-center gap-1.5">
            <span class="text-[11px] font-semibold" style="color: var(--muted);">Σ</span>
            <input type="text"
                   class="bp-input !h-7 font-mono text-xs w-32"
                   placeholder="Σ auto (e.g. x,y,z)"
                   title="Custom alphabet symbols (leave blank to auto-detect)"
                   aria-label="Custom alphabet symbols"
                   value="@AlphabetText"
                   @oninput="OnAlphabetInput"
                   @onkeydown="OnInputKeyDown" />
        </div>
    </div>

    @if (_mode == "visual")
    {
        <div class="bp-builder-row justify-between">
            <div class="flex flex-wrap items-center gap-2">
                <div class="bp-seg" role="group" aria-label="Parametric pattern template">
                    <button type="button" class="bp-seg-btn" data-active="@(_template == "2block" ? "true" : "false")" @onclick='() => SetTemplate("2block")'>s₁ⁿ s₂ᵐ</button>
                    <button type="button" class="bp-seg-btn" data-active="@(_template == "3block" ? "true" : "false")" @onclick='() => SetTemplate("3block")'>s₁ⁿ s₂ᵐ s₃ᵏ</button>
                    <button type="button" class="bp-seg-btn" data-active="@(_template == "count" ? "true" : "false")" @onclick='() => SetTemplate("count")'>#s₁ vs #s₂</button>
                </div>

                <label class="flex items-center gap-1 text-[11px]" style="color: var(--muted);">
                    <span>Symbols</span>
                    <input type="text"
                           class="bp-input !h-7 font-mono text-xs w-20"
                           placeholder="a,b"
                           aria-label="Pattern symbols"
                           @bind="_symbols"
                           @bind:event="oninput"
                           @onkeydown="OnInputKeyDown" />
                </label>

                @if (_template == "3block")
                {
                    <select class="bp-input !h-7 font-mono text-xs"
                            aria-label="3-block condition"
                            @bind="_threeRel">
                        <option value="n + m = k">n + m = k</option>
                        <option value="n + m > k">n + m &gt; k</option>
                        <option value="n = m or m = k">n = m or m = k</option>
                        <option value="n > m">n &gt; m</option>
                        <option value="n = k">n = k</option>
                        @if (AllowContextSensitive)
                        {
                            <option value="n = m and m = k">n = m and m = k (CSL)</option>
                            <option value="n > m > k">n &gt; m &gt; k (CSL)</option>
                            <option value="n >= m >= k">n &gt;= m &gt;= k (CSL)</option>
                        }
                    </select>
                }
                else
                {
                    <select class="bp-input !h-7 font-mono text-xs w-16"
                            aria-label="Comparison operator"
                            @bind="_op">
                        <option value=">">&gt;</option>
                        <option value=">=">&gt;=</option>
                        <option value="<">&lt;</option>
                        <option value="<=">&lt;=</option>
                        <option value="=">=</option>
                        <option value="!=">!=</option>
                    </select>

                    <div class="bp-seg" role="group" aria-label="Multiplier">
                        @foreach (var mult in new[] { 1, 2, 3 })
                        {
                            <button type="button"
                                    class="bp-seg-btn font-mono"
                                    data-active="@(_multiplier == mult ? "true" : "false")"
                                    @onclick="() => _multiplier = mult">@($"{mult}×")</button>
                        }
                    </div>

                    <div class="bp-seg" role="group" aria-label="Offset">
                        @foreach (var off in new[] { -1, 0, 1 })
                        {
                            <button type="button"
                                    class="bp-seg-btn font-mono"
                                    data-active="@(_offset == off ? "true" : "false")"
                                    @onclick="() => _offset = off">@(off > 0 ? $"+{off}" : off.ToString())</button>
                        }
                    </div>
                }

                @if (_template != "count")
                {
                    <div class="bp-seg" role="group" aria-label="Minimum bound">
                        <button type="button" class="bp-seg-btn" data-active="@(_minBound == 0 ? "true" : "false")" @onclick="() => _minBound = 0">≥ 0</button>
                        <button type="button" class="bp-seg-btn" data-active="@(_minBound == 1 ? "true" : "false")" @onclick="() => _minBound = 1">≥ 1</button>
                    </div>
                }
            </div>
        </div>

        <div class="bp-builder-preview w-full">
            <span class="text-[10.5px] font-sans font-semibold mr-1.5" style="color: var(--faint);">Spec:</span>
            <span>@ComposedSpec</span>
        </div>
    }
    else
    {
        <input type="text"
               class="bp-input !h-8 font-mono text-xs w-full"
               placeholder="@Placeholder"
               aria-label="@($"Specification to synthesize {TargetLabel}")"
               value="@SpecText"
               @oninput="OnSpecInput"
               @onkeydown="OnInputKeyDown" />
    }

    <div class="flex flex-wrap items-center justify-between gap-2 pt-0.5">
        <div class="flex flex-wrap items-center gap-1.5">
            <button type="button" class="bp-btn-primary !h-8 text-xs" @onclick="TriggerSynthesizeAsync">
                Synthesize @TargetLabel
            </button>

            <input type="text"
                   class="bp-input !h-8 text-xs w-40"
                   placeholder="Name to save…"
                   aria-label="Name for saved rule"
                   @bind="_saveName"
                   @bind:event="oninput" />
            <button type="button" class="bp-btn-secondary !h-8 text-xs" @onclick="TriggerSaveAsync">
                @(_justSaved ? "Saved ✓" : "Save to Examples")
            </button>

            @if (!string.IsNullOrWhiteSpace(ActiveSavedId))
            {
                <button type="button"
                        class="bp-btn-ghost !h-8 !px-2 text-xs"
                        style="color: var(--negative);"
                        title="Delete currently selected saved rule"
                        @onclick="TriggerDeleteSavedAsync">
                    Delete saved
                </button>
            }
        </div>

        @if (ExtraFooter is not null)
        {
            <div class="flex flex-wrap items-center gap-1.5">
                @ExtraFooter
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(ErrorText))
    {
        <div class="text-xs px-2.5 py-1.5 rounded-md" style="background: var(--pill-negative-bg); color: var(--pill-negative-ink);">
            @ErrorText
        </div>
    }
</div>

@code {
    [Parameter] public string TargetLabel { get; set; } = "CFG";
    [Parameter] public bool AllowContextSensitive { get; set; }
    [Parameter] public string Placeholder { get; set; } = "e.g. a^n b^m where n > m | x^n y^n | palindromes";
    [Parameter] public string SpecText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SpecTextChanged { get; set; }
    [Parameter] public string AlphabetText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> AlphabetTextChanged { get; set; }
    [Parameter] public string? ErrorText { get; set; }
    [Parameter] public string? ActiveSavedId { get; set; }
    [Parameter] public string? ActiveSavedName { get; set; }
    [Parameter] public EventCallback OnSynthesize { get; set; }
    [Parameter] public EventCallback<string> OnSave { get; set; }
    [Parameter] public EventCallback<string> OnDeleteSaved { get; set; }
    [Parameter] public RenderFragment? ExtraFooter { get; set; }

    private string _mode = "visual";
    private string _template = "2block";
    private string _symbols = "a,b";
    private string _op = ">";
    private int _multiplier = 1;
    private int _offset;
    private int _minBound;
    private string _threeRel = "n + m = k";
    private string _saveName = string.Empty;
    private string? _lastSyncedSavedId;
    private bool _justSaved;

    private string ComposedSpec
    {
        get
        {
            var syms = (_symbols ?? string.Empty)
                .Where(char.IsLetterOrDigit)
                .Select(char.ToLowerInvariant)
                .Distinct()
                .ToList();

            var s1 = syms.Count > 0 ? syms[0] : 'a';
            var s2 = syms.Count > 1 ? syms[1] : (s1 == 'a' ? 'b' : 'y');
            var s3 = syms.Count > 2 ? syms[2] : (s2 == 'b' ? 'c' : 'z');

            if (_template == "3block")
            {
                var boundSuffix = _minBound > 0 ? $", n, m, k >= {_minBound}" : "";
                return $"{s1}^n {s2}^m {s3}^k where {_threeRel}{boundSuffix}";
            }

            var rhsMul = _multiplier == 1 ? "m" : $"{_multiplier}m";
            var rhsOff = _offset switch
            {
                > 0 => $" + {_offset}",
                < 0 => $" - {System.Math.Abs(_offset)}",
                _ => ""
            };

            if (_template == "count")
            {
                var cRhs = _multiplier == 1 ? $"#{s2}" : $"{_multiplier}*#{s2}";
                return syms.Count > 2
                    ? $"{{ w in {{{string.Join(",", syms)}}}* | #{s1}(w) {_op} {cRhs}{rhsOff} }}"
                    : $"#{s1} {_op} {cRhs}{rhsOff}";
            }

            var minPart = _minBound > 0 ? $", n, m >= {_minBound}" : "";
            return $"{s1}^n {s2}^m where n {_op} {rhsMul}{rhsOff}{minPart}";
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.Equals(_lastSyncedSavedId, ActiveSavedId, StringComparison.Ordinal))
        {
            _lastSyncedSavedId = ActiveSavedId;
            if (!string.IsNullOrWhiteSpace(ActiveSavedName))
            {
                _saveName = ActiveSavedName;
            }
        }
    }

    private async Task SwitchMode(string next)
    {
        if (_mode == next) return;
        if (next == "text" && _mode == "visual")
        {
            await SpecTextChanged.InvokeAsync(ComposedSpec);
        }
        _mode = next;
    }

    private void SetTemplate(string template)
    {
        _template = template;
        var syms = (_symbols ?? string.Empty).Where(char.IsLetterOrDigit).Distinct().ToList();
        if (template == "3block" && syms.Count < 3)
        {
            _symbols = syms.Count == 2 && syms[0] == 'x' && syms[1] == 'y' ? "x,y,z" : "a,b,c";
        }
        else if (template != "3block" && syms.Count >= 3)
        {
            _symbols = $"{syms[0]},{syms[1]}";
        }
    }

    private Task OnSpecInput(ChangeEventArgs e) =>
        SpecTextChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task OnAlphabetInput(ChangeEventArgs e) =>
        AlphabetTextChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private async Task OnInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await TriggerSynthesizeAsync();
        }
    }

    private async Task TriggerSynthesizeAsync()
    {
        if (_mode == "visual")
        {
            await SpecTextChanged.InvokeAsync(ComposedSpec);
        }
        await OnSynthesize.InvokeAsync();
    }

    private async Task TriggerSaveAsync()
    {
        var activeSpec = _mode == "visual" ? ComposedSpec : SpecText;
        if (_mode == "visual")
        {
            await SpecTextChanged.InvokeAsync(activeSpec);
        }
        var name = string.IsNullOrWhiteSpace(_saveName)
            ? (activeSpec.Length <= 34 ? activeSpec : activeSpec[..31].TrimEnd() + "…")
            : _saveName.Trim();
        _saveName = name;
        await OnSave.InvokeAsync(name);

        _justSaved = true;
        StateHasChanged();
        await Task.Delay(1600);
        _justSaved = false;
    }

    private async Task TriggerDeleteSavedAsync()
    {
        if (string.IsNullOrWhiteSpace(ActiveSavedId)) return;
        await OnDeleteSaved.InvokeAsync(ActiveSavedId);
        _saveName = string.Empty;
    }
}
