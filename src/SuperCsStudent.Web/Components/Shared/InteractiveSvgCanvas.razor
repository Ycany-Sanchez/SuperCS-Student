@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="relative w-full h-full overflow-hidden bp-well-grid @Class">
    <div @ref="_host" class="w-full h-full"></div>

    @if (!string.IsNullOrWhiteSpace(Scene?.OverlayTag))
    {
        <div class="absolute top-3 left-3 bp-pill bp-pill-accent font-mono text-[11px] pointer-events-none">
            @Scene.OverlayTag
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorBanner))
    {
        <div role="alert"
             class="absolute top-3 left-3 right-28 rounded-lg px-3 py-1.5 text-xs font-medium flex items-center gap-2"
             style="background: var(--pill-negative-bg); color: var(--pill-negative-ink); border: 1px solid var(--negative);">
            <span>Syntax error (showing last valid diagram): @ErrorBanner</span>
        </div>
    }

    @if (ActiveEdgeId is not null)
    {
        var edgeDisplay = !string.IsNullOrWhiteSpace(_inspectedEdgeLabel)
            ? _inspectedEdgeLabel
            : (!string.IsNullOrWhiteSpace(SelectedLabel) ? SelectedLabel : ActiveEdgeId);
        <div class="absolute top-3 right-3 z-20 flex flex-wrap items-center gap-1.5 px-2.5 py-1 rounded-xl bp-floating text-xs">
            <span class="font-mono font-semibold" style="color: var(--accent);">@edgeDisplay</span>
            <span class="w-px h-4" style="background: var(--border);"></span>
            <div class="bp-seg" role="group" aria-label="Arrow routing style">
                <button type="button"
                        class="bp-seg-btn !h-5 !px-2 !text-[11px]"
                        data-active="@(_inspectedEdgeStyle == "classic" ? "true" : "false")"
                        @onclick='() => SetSelectedEdgeStyle("classic")'>
                    Classic
                </button>
                <button type="button"
                        class="bp-seg-btn !h-5 !px-2 !text-[11px]"
                        data-active="@(_inspectedEdgeStyle == "blocky" ? "true" : "false")"
                        @onclick='() => SetSelectedEdgeStyle("blocky")'>
                    Blocky
                </button>
            </div>
            <button type="button"
                    class="bp-btn-ghost !h-6 !px-1.5 text-[11px]"
                    title="Pin a bend-point on this arrow (or drag anywhere on the arrow / + handle)"
                    @onclick="AddBendToSelectedEdge">
                + Pin
            </button>
            @if (_inspectedWaypointCount > 0)
            {
                <button type="button"
                        class="bp-btn-ghost !h-6 !px-1.5 text-[11px]"
                        title="Remove all pinned bend-points on this arrow"
                        @onclick="ClearBendsOnSelectedEdge">
                    Clear (@_inspectedWaypointCount)
                </button>
            }
            @if (OnDeleteSelected.HasDelegate)
            {
                <button type="button"
                        class="bp-btn-ghost !h-6 !px-1.5 text-[11px]"
                        style="color: var(--negative);"
                        title="@(_inspectedWaypointIndex >= 0 ? "Remove selected pin (Backspace)" : "Delete edge (Backspace)")"
                        @onclick='() => TriggerDeleteSelected("edge", ActiveEdgeId)'>
                    Delete <kbd class="bp-kbd !h-4 !min-w-0 !px-1 !text-[9.5px] ml-0.5">⌫</kbd>
                </button>
            }
            <button type="button"
                    class="daa-tab-close"
                    title="Clear selection"
                    aria-label="Clear selection"
                    @onclick="ClearSelection">
                ×
            </button>
        </div>
    }
    else if (EnableSelection && !string.IsNullOrEmpty(SelectedNodeId))
    {
        var selDisplay = !string.IsNullOrWhiteSpace(SelectedLabel) ? SelectedLabel : SelectedNodeId;
        <div class="absolute top-3 right-3 z-20 flex items-center gap-1.5 px-2.5 py-1 rounded-xl bp-floating text-xs">
            <span class="font-mono font-semibold" style="color: var(--accent);">@selDisplay</span>
            <span class="hidden sm:inline text-[11px]" style="color: var(--muted);">·</span>
            <button type="button"
                    class="bp-btn-ghost !h-6 !px-1.5 text-[11px]"
                    style="color: var(--negative);"
                    title="Delete selected (Backspace)"
                    @onclick='() => TriggerDeleteSelected("node", SelectedNodeId!)'>
                Delete <kbd class="bp-kbd !h-4 !min-w-0 !px-1 !text-[9.5px] ml-0.5">⌫</kbd>
            </button>
            <button type="button"
                    class="daa-tab-close"
                    title="Clear selection"
                    aria-label="Clear selection"
                    @onclick="ClearSelection">
                ×
            </button>
        </div>
    }

    <div class="absolute bottom-3 right-3 flex items-center gap-0.5 p-1 rounded-xl bp-floating">
        <button type="button" class="bp-btn-ghost !h-7 !w-7 !p-0 text-xs font-mono" title="Zoom out" aria-label="Zoom out" @onclick="() => Zoom(0.85)">-</button>
        <button type="button" class="bp-btn-ghost !h-7 !px-2 text-xs" title="Fit diagram" aria-label="Fit diagram to canvas" @onclick="Fit">Fit</button>
        <button type="button" class="bp-btn-ghost !h-7 !w-7 !p-0 text-xs font-mono" title="Zoom in" aria-label="Zoom in" @onclick="() => Zoom(1.18)">+</button>
        <span class="w-px h-4 mx-0.5" style="background: var(--border);"></span>
        <button type="button" class="bp-btn-ghost !h-7 !px-2 text-xs" title="Reset node positions and custom arrows" aria-label="Reset node positions" @onclick="ResetLayout">Reset</button>
        <button type="button" class="bp-btn-ghost !h-7 !px-2 text-xs" title="Export SVG" aria-label="Export diagram as SVG" @onclick="ExportSvg">SVG</button>
        <button type="button" class="bp-btn-ghost !h-7 !px-2 text-xs" title="Export PNG" aria-label="Export diagram as PNG" @onclick="ExportPng">PNG</button>
    </div>
</div>

@code {
    private ElementReference _host;
    private DotNetObjectReference<InteractiveSvgCanvas>? _selfRef;
    private bool _mounted;
    private DiagramScene? _lastScene;
    private string? _lastOptionsKey;

    private string? _inspectedEdgeId;
    private string? _inspectedEdgeLabel;
    private string _inspectedEdgeStyle = "classic";
    private int _inspectedWaypointCount;
    private int _inspectedWaypointIndex = -1;

    private string? ActiveEdgeId =>
        !string.IsNullOrEmpty(SelectedEdgeId)
            ? SelectedEdgeId
            : (!string.IsNullOrEmpty(_inspectedEdgeId) ? _inspectedEdgeId : null);

    [Parameter] public DiagramScene? Scene { get; set; }
    [Parameter] public bool SnapMotion { get; set; }
    [Parameter] public string? ErrorBanner { get; set; }
    [Parameter] public string ExportFileName { get; set; } = "diagram.svg";
    [Parameter] public string? Class { get; set; }

    [Parameter] public bool EnableConnectHandles { get; set; }
    [Parameter] public bool EnableSelection { get; set; }
    [Parameter] public bool EnableDoubleClickAdd { get; set; }
    [Parameter] public bool IsDirectedGraph { get; set; } = true;
    [Parameter] public string? SelectedNodeId { get; set; }
    [Parameter] public string? SelectedEdgeId { get; set; }
    [Parameter] public string? SelectedLabel { get; set; }

    [Parameter] public EventCallback<string> OnNodeClicked { get; set; }
    [Parameter] public EventCallback<(double X, double Y)> OnCanvasClicked { get; set; }
    [Parameter] public EventCallback<(string FromNodeId, string ToNodeId)> OnEdgeConnected { get; set; }
    [Parameter] public EventCallback<(string Kind, string Id)> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<(string Kind, string Id)> OnDeleteSelected { get; set; }
    [Parameter] public EventCallback<(double X, double Y)> OnCanvasDoubleClicked { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("SuperCs.svg.mountSvgCanvas", _host, _selfRef);
            _mounted = true;
        }

        if (_mounted)
        {
            var canDeleteEdges = OnDeleteSelected.HasDelegate;
            var optionsKey = $"{EnableConnectHandles}|{EnableSelection}|{EnableDoubleClickAdd}|{canDeleteEdges}|{IsDirectedGraph}|{SelectedNodeId}|{SelectedEdgeId}";
            if (_lastOptionsKey != optionsKey)
            {
                _lastOptionsKey = optionsKey;
                await JS.InvokeVoidAsync("SuperCs.svg.configureCanvas", _host, new
                {
                    enableConnectHandles = EnableConnectHandles,
                    enableSelection = EnableSelection,
                    enableDoubleClickAdd = EnableDoubleClickAdd,
                    canDeleteEdges,
                    isDirected = IsDirectedGraph,
                    selectedNodeId = SelectedNodeId,
                    selectedEdgeId = SelectedEdgeId
                });
            }

            if (Scene is not null && !ReferenceEquals(_lastScene, Scene))
            {
                _lastScene = Scene;
                await JS.InvokeVoidAsync("SuperCs.svg.renderScene", _host, Scene, SnapMotion);
            }
        }
    }

    [JSInvokable]
    public Task HandleNodeClick(string nodeId) =>
        OnNodeClicked.HasDelegate ? OnNodeClicked.InvokeAsync(nodeId) : Task.CompletedTask;

    [JSInvokable]
    public Task HandleCanvasClick(double x, double y) =>
        OnCanvasClicked.HasDelegate ? OnCanvasClicked.InvokeAsync((x, y)) : Task.CompletedTask;

    [JSInvokable]
    public Task HandleEdgeConnected(string fromNodeId, string toNodeId) =>
        OnEdgeConnected.HasDelegate ? OnEdgeConnected.InvokeAsync((fromNodeId, toNodeId)) : Task.CompletedTask;

    [JSInvokable]
    public Task HandleSelectionChanged(string kind, string id) =>
        OnSelectionChanged.HasDelegate ? OnSelectionChanged.InvokeAsync((kind, id)) : Task.CompletedTask;

    [JSInvokable]
    public Task HandleDeleteSelected(string kind, string id) =>
        OnDeleteSelected.HasDelegate ? OnDeleteSelected.InvokeAsync((kind, id)) : Task.CompletedTask;

    [JSInvokable]
    public Task HandleCanvasDoubleClick(double x, double y) =>
        OnCanvasDoubleClicked.HasDelegate ? OnCanvasDoubleClicked.InvokeAsync((x, y)) : Task.CompletedTask;

    [JSInvokable]
    public Task HandleEdgeInspectState(string edgeId, string displayLabel, string style, int waypointCount, int selectedWaypointIndex)
    {
        _inspectedEdgeId = string.IsNullOrEmpty(edgeId) ? null : edgeId;
        _inspectedEdgeLabel = string.IsNullOrEmpty(displayLabel) ? null : displayLabel;
        _inspectedEdgeStyle = string.Equals(style, "blocky", StringComparison.OrdinalIgnoreCase) ? "blocky" : "classic";
        _inspectedWaypointCount = waypointCount;
        _inspectedWaypointIndex = selectedWaypointIndex;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SetSelectedEdgeStyle(string style)
    {
        if (!_mounted || ActiveEdgeId is null) return;
        _inspectedEdgeStyle = style;
        await JS.InvokeVoidAsync("SuperCs.svg.setEdgeStyle", _host, ActiveEdgeId, style);
    }

    private async Task AddBendToSelectedEdge()
    {
        if (!_mounted || ActiveEdgeId is null) return;
        await JS.InvokeVoidAsync("SuperCs.svg.addEdgeWaypoint", _host, ActiveEdgeId);
    }

    private async Task ClearBendsOnSelectedEdge()
    {
        if (!_mounted || ActiveEdgeId is null) return;
        await JS.InvokeVoidAsync("SuperCs.svg.clearEdgeWaypoints", _host, ActiveEdgeId);
    }

    public async Task SeedNodePositionAsync(string nodeId, double x, double y)
    {
        if (_mounted)
        {
            await JS.InvokeVoidAsync("SuperCs.svg.seedNodePosition", _host, nodeId, x, y);
        }
    }

    private async Task TriggerDeleteSelected(string kind, string id)
    {
        if (kind == "edge")
        {
            _inspectedEdgeId = null;
            _inspectedEdgeLabel = null;
            _inspectedWaypointCount = 0;
            _inspectedWaypointIndex = -1;
        }
        if (OnDeleteSelected.HasDelegate)
        {
            await OnDeleteSelected.InvokeAsync((kind, id));
        }
    }

    private async Task ClearSelection()
    {
        _inspectedEdgeId = null;
        _inspectedEdgeLabel = null;
        _inspectedWaypointCount = 0;
        _inspectedWaypointIndex = -1;
        if (_mounted)
        {
            await JS.InvokeVoidAsync("SuperCs.svg.clearEdgeSelection", _host);
        }
        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(("none", ""));
        }
    }

    public async Task Zoom(double factor)
    {
        if (_mounted) await JS.InvokeVoidAsync("SuperCs.svg.zoomCanvas", _host, factor);
    }

    public async Task Fit()
    {
        if (_mounted) await JS.InvokeVoidAsync("SuperCs.svg.fitCanvas", _host);
    }

    public async Task ResetLayout()
    {
        if (_mounted) await JS.InvokeVoidAsync("SuperCs.svg.resetNodeOffsets", _host);
    }

    private async Task ExportSvg()
    {
        if (!_mounted) return;
        var markup = await JS.InvokeAsync<string>("SuperCs.svg.exportSvgMarkup", _host);
        if (!string.IsNullOrWhiteSpace(markup))
        {
            await JS.InvokeVoidAsync("SuperCs.storage.downloadTextFile", ExportFileName, markup, "image/svg+xml;charset=utf-8");
        }
    }

    private async Task ExportPng()
    {
        if (!_mounted) return;
        var pngName = ExportFileName.EndsWith(".svg", StringComparison.OrdinalIgnoreCase)
            ? ExportFileName[..^4] + ".png"
            : ExportFileName + ".png";
        await JS.InvokeAsync<bool>("SuperCs.svg.exportPngFile", _host, pngName, 2);
    }

    public async ValueTask DisposeAsync()
    {
        if (_mounted)
        {
            try { await JS.InvokeVoidAsync("SuperCs.svg.disposeCanvas", _host); } catch { }
            _mounted = false;
        }
        _selfRef?.Dispose();
    }
}
