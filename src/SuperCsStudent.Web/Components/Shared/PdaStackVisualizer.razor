@using SuperCsStudent.Automata
@using SuperCsStudent.Automata.Pda
@using SuperCsStudent.Core.Tracing

@if (CurrentStep is not null)
{
    var st = CurrentStep.State;
    var popped = st.PoppedFrames ?? Array.Empty<string>();
    var pushed = st.PushedFrames ?? Array.Empty<string>();
    var frames = st.StackFrames;
    var totalSteps = Trace?.Timeline.Steps.Count ?? 0;
    var peakDepth = Trace?.Timeline.Steps.Max(s => s.State.StackFrames.Count) ?? frames.Count;

    <div class="h-full min-h-0 flex flex-col gap-3">
        @* 1. Top Control Strip: State + Operation Badge + Depth Metrics + Optional Compact Stepper *@
        <div class="flex flex-wrap items-center justify-between gap-2 shrink-0">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="bp-pill font-mono text-[11px] @StatePillClass(st.IsAccepted)">
                    @if (!string.IsNullOrEmpty(st.PreviousState) && st.PreviousState != st.CurrentState)
                    {
                        <span>@st.PreviousState → @st.CurrentState</span>
                    }
                    else
                    {
                        <span>q = @st.CurrentState</span>
                    }
                </span>

                <span class="bp-pill font-mono text-[10.5px] @OpPillClass(st.OperationKind)">
                    @FormatOpLabel(st.OperationKind)
                </span>

                <span class="text-[11px] font-mono tnum" style="color: var(--muted);">
                    depth @frames.Count · peak @peakDepth
                </span>
            </div>

            @if (ShowCompactStepControls && totalSteps > 0)
            {
                <div class="flex items-center gap-1">
                    <button type="button"
                            class="bp-btn-ghost !h-7 !px-2 font-mono text-xs"
                            disabled="@(CurrentStepIndex <= 0)"
                            title="Previous stack step"
                            @onclick="StepPrev">
                        ‹
                    </button>
                    <span class="text-xs font-mono tnum px-1" style="color: var(--muted);">
                        @(CurrentStepIndex + 1)/@totalSteps
                    </span>
                    <button type="button"
                            class="bp-btn-ghost !h-7 !px-2 font-mono text-xs"
                            disabled="@(CurrentStepIndex >= totalSteps - 1)"
                            title="Next stack step"
                            @onclick="StepNext">
                        ›
                    </button>
                </div>
            }
        </div>

        @* 2. Spacious Scrollable Input Tape Ribbon with Read Head *@
        <div class="rounded-lg px-3 py-2.5 shrink-0" style="background: var(--raised); border: 1px solid var(--border);">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10.5px] font-semibold uppercase tracking-wider" style="color: var(--faint);">
                    Input Tape (@st.InputIndex/@st.FullInput.Length read)
                </span>
                <span class="text-[11px] font-mono" style="color: var(--muted);">
                    @if (!string.IsNullOrEmpty(st.ReadSymbols))
                    {
                        <span>read <strong style="color: var(--accent);">'@st.ReadSymbols'</strong> · rem @st.RemainingInput</span>
                    }
                    else
                    {
                        <span>rem @st.RemainingInput</span>
                    }
                </span>
            </div>

            <div class="flex items-center gap-1.5 overflow-x-auto pb-1">
                @if (st.FullInput.Length == 0)
                {
                    <div class="px-3 h-[34px] rounded-md flex items-center font-mono text-xs font-semibold shrink-0"
                         style="background: var(--surface); border: 1.5px solid @(st.IsAccepted == true ? "var(--positive)" : "var(--accent)"); color: var(--text);">
                        e (empty)
                    </div>
                }
                else
                {
                    var justReadStart = System.Math.Max(0, st.InputIndex - st.ReadSymbols.Length);
                    @for (var idx = 0; idx < st.FullInput.Length; idx++)
                    {
                        var ch = st.FullInput[idx];
                        var isJustRead = st.ReadSymbols.Length > 0 && idx >= justReadStart && idx < st.InputIndex;
                        var isConsumed = idx < justReadStart;
                        var isHead = idx == st.InputIndex;

                        <div class="flex flex-col items-center shrink-0">
                            <div class="pda-tape-cell transition-colors"
                                 style="@TapeCellStyle(isConsumed, isJustRead, isHead)">
                                @ch
                            </div>
                            <span class="text-[10px] leading-none mt-1 font-mono"
                                  style="color: @(isHead ? "var(--accent)" : isJustRead ? "var(--positive)" : "transparent");">
                                @(isHead ? "▲" : isJustRead ? "✓" : "·")
                            </span>
                        </div>
                    }
                }

                @{
                    var atEnd = st.InputIndex >= st.FullInput.Length;
                }
                <div class="flex flex-col items-center shrink-0">
                    <div class="pda-tape-cell"
                         style="@(atEnd
                             ? (st.IsAccepted == true
                                 ? "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);"
                                 : "background: var(--accent-soft); color: var(--accent); border: 1.5px solid var(--accent);")
                             : "background: var(--surface); color: var(--faint); border: 1px dashed var(--control);")">
                        ⊣
                    </div>
                    <span class="text-[10px] leading-none mt-1 font-mono"
                          style="color: @(atEnd ? (st.IsAccepted == true ? "var(--positive)" : "var(--accent)") : "transparent");">
                        @(atEnd ? "▲" : "·")
                    </span>
                </div>
            </div>
        </div>

        @* 3. Full-Height Architectural LIFO Stack Stage *@
        <div class="flex-1 min-h-[240px] bp-well-grid p-4 flex flex-col items-center justify-between gap-3 overflow-y-auto">
            @* Active Transition Delta Banner *@
            <div class="w-full flex flex-wrap items-center justify-between gap-2 text-xs shrink-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                    @if (popped.Count > 0)
                    {
                        <span class="bp-pill bp-pill-warning font-mono text-[11px]">
                            ↑ Pop @string.Concat(popped)
                        </span>
                    }
                    @if (pushed.Count > 0)
                    {
                        <span class="bp-pill bp-pill-positive font-mono text-[11px]">
                            ↓ Push @string.Concat(pushed)
                        </span>
                    }
                    @if (popped.Count == 0 && pushed.Count == 0)
                    {
                        <span class="text-xs" style="color: var(--muted);">@st.CurrentRow.Remarks</span>
                    }
                </div>
                @if (st.CurrentRow.TransitionUsed != "—")
                {
                    <span class="font-mono text-[11px] px-2 py-0.5 rounded-md"
                          style="background: var(--surface); border: 1px solid var(--border); color: var(--muted);">
                        @st.CurrentRow.TransitionUsed
                    </span>
                }
            </div>

            @* Spacious Popped Ghost Zone + Tall U-Shaped LIFO Vessel *@
            <div class="w-full max-w-[268px] flex-1 flex flex-col justify-center items-center py-2">
                <div class="w-full min-h-[34px] flex items-end justify-center gap-1.5 pb-2">
                    @if (popped.Count > 0)
                    {
                        <div @key="@($"pop-{CurrentStepIndex}-{string.Concat(popped)}")"
                             class="flex items-center gap-1.5 @(SnapMotion ? "" : "pda-anim-pop")">
                            <span class="text-[10px] font-mono uppercase font-semibold" style="color: var(--warning);">↑ popped</span>
                            @foreach (var pSym in popped)
                            {
                                <span class="px-2.5 py-0.5 rounded-md font-mono text-xs font-semibold line-through"
                                      style="background: var(--pill-warning-bg); color: var(--pill-warning-ink); border: 1px dashed var(--warning);">
                                    @pSym
                                </span>
                            }
                        </div>
                    }
                </div>

                <div class="w-full flex items-center justify-between px-1.5 mb-1 text-[10px] font-mono uppercase tracking-wider"
                     style="color: var(--faint);">
                    <span>open top</span>
                    <span>LIFO stack</span>
                </div>

                <div class="pda-vessel max-h-[340px] p-2.5 flex flex-col justify-end gap-1.5 overflow-y-auto">
                    @if (frames.Count > 0)
                    {
                        @for (var f = 0; f < frames.Count; f++)
                        {
                            var isTop = f == 0;
                            var isNewPush = pushed.Count > 0 && f < pushed.Count;
                            var stackIdx = frames.Count - 1 - f;
                            var frameSym = frames[f];

                            <div @key="@(isNewPush ? $"push-{CurrentStepIndex}-{f}-{frameSym}" : $"keep-{stackIdx}-{frameSym}")"
                                 class="w-full px-3 py-2 rounded-md flex items-center justify-between gap-2 font-mono text-xs font-semibold shrink-0 @(isNewPush && !SnapMotion ? "pda-anim-push" : "")"
                                 style="@StackFrameStyle(isTop, isNewPush)">
                                <span class="text-[10px] tnum opacity-65 w-5">@stackIdx</span>
                                <span class="text-sm font-bold tracking-wide">@frameSym</span>
                                <span class="text-[9.5px] font-sans uppercase tracking-wider w-12 text-right">
                                    @if (isNewPush)
                                    {
                                        <span>+ push</span>
                                    }
                                    else if (isTop)
                                    {
                                        <span>TOP</span>
                                    }
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="w-full py-6 px-3 rounded-md text-center font-mono text-xs font-medium"
                             style="@(st.IsAccepted == true
                                 ? "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);"
                                 : st.IsAccepted == false
                                     ? "background: var(--pill-negative-bg); color: var(--pill-negative-ink); border: 1px dashed var(--negative);"
                                     : "background: var(--raised); color: var(--faint); border: 1px dashed var(--control);")">
                            @(st.IsAccepted == true ? "e · Empty & Accepted ✓" : "e (empty stack)")
                        </div>
                    }
                </div>

                <div class="w-full text-center pt-1.5 text-[10.5px] font-mono tracking-wider" style="color: var(--faint);">
                    ⊥ bottom
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="h-full bp-well-grid flex items-center justify-center p-4 text-xs" style="color: var(--muted);">
        Run a PDA trace to inspect the live LIFO stack.
    </div>
}

@code {
    [Parameter] public PdaTraceResult? Trace { get; set; }
    [Parameter] public int CurrentStepIndex { get; set; }
    [Parameter] public EventCallback<int> CurrentStepIndexChanged { get; set; }
    [Parameter] public bool ShowCompactStepControls { get; set; }
    [Parameter] public bool SnapMotion { get; set; }

    private TraceStep<PdaStepState>? CurrentStep =>
        Trace?.Timeline.Steps is { Count: > 0 } steps
            ? steps[System.Math.Clamp(CurrentStepIndex, 0, steps.Count - 1)]
            : null;

    private Task StepPrev() => CurrentStepIndexChanged.InvokeAsync(System.Math.Max(0, CurrentStepIndex - 1));

    private Task StepNext()
    {
        var max = (Trace?.Timeline.Steps.Count ?? 1) - 1;
        return CurrentStepIndexChanged.InvokeAsync(System.Math.Min(max, CurrentStepIndex + 1));
    }

    private static string StatePillClass(bool? verdict) => verdict switch
    {
        true => "bp-pill-positive",
        false => "bp-pill-negative",
        _ => "bp-pill-accent"
    };

    private static string OpPillClass(string opKind) => opKind switch
    {
        "PUSH" => "bp-pill-positive",
        "REPLACE" => "bp-pill-accent",
        "POP" or "MATCH" => "bp-pill-warning",
        "ACCEPT" => "bp-pill-positive",
        "REJECT" => "bp-pill-negative",
        _ => "bp-pill-neutral"
    };

    private static string FormatOpLabel(string opKind) => opKind switch
    {
        "INIT" => "START",
        "EPSILON" => "ε-MOVE",
        "REPLACE" => "POP → PUSH",
        "MATCH" => "READ & POP",
        _ => opKind
    };

    private static string TapeCellStyle(bool isConsumed, bool isJustRead, bool isHead)
    {
        if (isJustRead)
            return "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);";
        if (isHead)
            return "background: var(--accent-soft); color: var(--accent); border: 1.5px solid var(--accent);";
        if (isConsumed)
            return "background: var(--raised); color: var(--faint); border: 1px solid var(--border); opacity: 0.65;";
        return "background: var(--surface); color: var(--text); border: 1px solid var(--control);";
    }

    private static string StackFrameStyle(bool isTop, bool isNewPush)
    {
        if (isNewPush)
            return "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);";
        if (isTop)
            return "background: var(--accent-soft); color: var(--accent); border: 1.5px solid var(--accent);";
        return "background: var(--raised); color: var(--text); border: 1px solid var(--border);";
    }
}
