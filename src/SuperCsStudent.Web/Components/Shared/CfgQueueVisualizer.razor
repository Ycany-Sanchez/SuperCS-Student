@using SuperCsStudent.Automata
@using SuperCsStudent.Automata.Grammars

@if (Result is { Accepted: true } && CurrentStep is not null)
{
    var step = CurrentStep;
    var totalSteps = Result.QueueSteps?.Count ?? 0;
    var targetWord = Result.Input == AutomataSymbols.Empty ? string.Empty : Result.Input;
    var resolvedCount = step.ResolvedOutput.Count;
    var newlyResolvedStart = System.Math.Max(0, resolvedCount - step.NewlyResolvedCount);

    <div class="h-full min-h-0 flex flex-col gap-3">
        @* 1. Top Control Strip *@
        <div class="flex flex-wrap items-center justify-between gap-2 shrink-0">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="bp-pill font-mono text-[11px] @(step.IsComplete ? "bp-pill-positive" : step.StepIndex == 0 ? "bp-pill-neutral" : "bp-pill-accent")">
                    @StepStatusLabel(step)
                </span>

                @if (!string.IsNullOrEmpty(step.AppliedRule))
                {
                    <span class="bp-pill bp-pill-neutral font-mono text-[11px]">
                        @step.AppliedRule
                    </span>
                }

                <span class="text-[11px] font-mono tnum" style="color: var(--muted);">
                    queued @step.QueueSymbols.Count · matched @resolvedCount
                </span>
            </div>

            @if (ShowCompactStepControls && totalSteps > 0)
            {
                <div class="flex items-center gap-1">
                    <button type="button"
                            class="bp-btn-ghost !h-7 !px-2 font-mono text-xs"
                            disabled="@(CurrentStepIndex <= 0)"
                            title="Previous derivation step"
                            @onclick="StepPrev">
                        ‹
                    </button>
                    <span class="text-xs font-mono tnum px-1" style="color: var(--muted);">
                        @(CurrentStepIndex + 1)/@totalSteps
                    </span>
                    <button type="button"
                            class="bp-btn-ghost !h-7 !px-2 font-mono text-xs"
                            disabled="@(CurrentStepIndex >= totalSteps - 1)"
                            title="Next derivation step"
                            @onclick="StepNext">
                        ›
                    </button>
                </div>
            }
        </div>

        @* 2. Target String Progress Strip *@
        <div class="rounded-lg px-3 py-2.5 shrink-0" style="background: var(--raised); border: 1px solid var(--border);">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-[10.5px] font-semibold uppercase tracking-wider" style="color: var(--faint);">
                    Target Output w
                </span>
                <span class="text-[11px] font-mono" style="color: var(--muted);">
                    Sentential form: <strong style="color: var(--text);">@step.SententialForm</strong>
                </span>
            </div>

            <div class="flex items-center gap-1.5 overflow-x-auto pb-0.5">
                @if (targetWord.Length == 0)
                {
                    <div class="px-3 h-[34px] rounded-md flex items-center font-mono text-xs font-semibold shrink-0"
                         style="@(step.IsComplete
                             ? "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);"
                             : "background: var(--surface); color: var(--text); border: 1px solid var(--control);")">
                        e (empty string)
                    </div>
                }
                else
                {
                    var resolvedJoined = string.Concat(step.ResolvedOutput);
                    var matchedLen = System.Math.Min(resolvedJoined.Length, targetWord.Length);
                    @for (var i = 0; i < targetWord.Length; i++)
                    {
                        var isMatched = i < matchedLen;
                        <div class="pda-tape-cell transition-colors"
                             style="@(isMatched
                                 ? "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);"
                                 : "background: var(--surface); color: var(--muted); border: 1px solid var(--control);")">
                            @targetWord[i]
                        </div>
                    }
                }
            </div>
        </div>

        @* 3. Horizontal FIFO Derivation Queue Stage *@
        <div class="flex-1 min-h-[240px] bp-well-grid p-4 flex flex-col justify-between gap-4 overflow-y-auto">
            @* Active Rule Callout *@
            <div class="w-full flex flex-wrap items-center justify-between gap-2 text-xs shrink-0">
                <div class="flex items-center gap-1.5 flex-wrap">
                    @if (!string.IsNullOrEmpty(step.ExpandedNonTerminal))
                    {
                        <span @key="@($"exp-{CurrentStepIndex}-{step.ExpandedNonTerminal}")"
                              class="bp-pill bp-pill-warning font-mono text-[11px] @(SnapMotion ? "" : "pda-anim-pop")">
                            ↑ Expand @step.ExpandedNonTerminal
                        </span>
                        @if (step.ProducedSymbols.Count > 0)
                        {
                            <span class="bp-pill bp-pill-positive font-mono text-[11px]">
                                → Enqueue @string.Join(" ", step.ProducedSymbols)
                            </span>
                        }
                        else
                        {
                            <span class="bp-pill bp-pill-neutral font-mono text-[11px]">
                                → e (erased)
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-xs" style="color: var(--muted);">
                            Start symbol seeded at FRONT of the derivation queue.
                        </span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(step.AppliedRule))
                {
                    <span class="font-mono text-[11px] px-2 py-0.5 rounded-md"
                          style="background: var(--surface); border: 1px solid var(--border); color: var(--muted);">
                        Rule: @step.AppliedRule
                    </span>
                }
            </div>

            @* Horizontal Pipeline: Matched Output Stream ←←← [ FRONT | Queue Track | BACK ] *@
            <div class="w-full flex-1 flex flex-col justify-center gap-3">
                @* Matched Output Strip (Dequeued Terminals) *@
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-[10px] font-mono uppercase tracking-wider" style="color: var(--faint);">
                        <span>Dequeued Output (Matched Terminals)</span>
                        <span>@step.ResolvedOutput.Count emitted</span>
                    </div>
                    <div class="rounded-lg px-3 py-2 flex items-center gap-1.5 overflow-x-auto min-h-[48px]"
                         style="background: var(--surface); border: 1px solid var(--border);">
                        @if (step.ResolvedOutput.Count == 0)
                        {
                            <span class="text-xs font-mono" style="color: var(--faint);">
                                @(step.IsComplete ? "e (empty derivation complete)" : "No terminals emitted yet…")
                            </span>
                        }
                        else
                        {
                            @for (var k = 0; k < step.ResolvedOutput.Count; k++)
                            {
                                var isFreshOut = k >= newlyResolvedStart && step.NewlyResolvedCount > 0;
                                var tok = step.ResolvedOutput[k];
                                <span @key="@(isFreshOut ? $"out-{CurrentStepIndex}-{k}-{tok}" : $"out-keep-{k}-{tok}")"
                                      class="px-2.5 py-1 rounded-md font-mono text-xs font-semibold shrink-0 @(isFreshOut && !SnapMotion ? "cfg-anim-enqueue" : "")"
                                      style="@(isFreshOut
                                          ? "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);"
                                          : "background: var(--raised); color: var(--text); border: 1px solid var(--border);")">
                                    @tok
                                </span>
                            }
                        }
                    </div>
                </div>

                @* Open-Ended Horizontal FIFO Queue Pipe *@
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between px-1 text-[10px] font-mono uppercase tracking-wider" style="color: var(--faint);">
                        <span>← FRONT (Leftmost Expand Head)</span>
                        <span>FIFO Derivation Queue</span>
                        <span>BACK →</span>
                    </div>

                    <div class="cfg-queue-track rounded-lg">
                        @if (step.QueueSymbols.Count == 0)
                        {
                            <div class="w-full text-center py-2 font-mono text-xs font-semibold rounded-md"
                                 style="background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);">
                                ∅ Queue Empty — Derived '@Result.Input' ✓
                            </div>
                        }
                        else
                        {
                            @for (var q = 0; q < step.QueueSymbols.Count; q++)
                            {
                                var item = step.QueueSymbols[q];
                                <div @key="@(item.IsNewlyProduced ? $"qnew-{CurrentStepIndex}-{q}-{item.Symbol}" : $"qkeep-{q}-{item.Symbol}")"
                                     class="cfg-queue-cell @(item.IsNewlyProduced && !SnapMotion ? "cfg-anim-enqueue" : "")"
                                     style="@QueueCellStyle(item)">
                                    <span class="text-sm font-bold leading-tight">@item.Symbol</span>
                                    <span class="text-[8.5px] font-sans uppercase tracking-wider leading-none mt-0.5 opacity-80">
                                        @(item.IsExpandHead ? "FRONT" : item.IsTerminal ? "term" : "NT")
                                    </span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="w-full text-center text-[10.5px] font-mono" style="color: var(--faint);">
                Leftmost non-terminal at FRONT expands in-place; leading terminals flow out to Dequeued Output.
            </div>
        </div>
    </div>
}
else if (Result is { Accepted: false })
{
    <div class="h-full bp-well-grid flex flex-col items-center justify-center p-6 gap-2.5 text-center">
        <span class="bp-pill bp-pill-negative font-mono text-xs">Rejected</span>
        <div class="text-sm font-semibold">No Leftmost Derivation for '@Result.Input'</div>
        <div class="text-xs max-w-md" style="color: var(--muted);">@Result.Summary</div>
    </div>
}
else
{
    <div class="h-full bp-well-grid flex items-center justify-center p-4 text-xs" style="color: var(--muted);">
        Enter a grammar and string to trace the CFG derivation queue.
    </div>
}

@code {
    [Parameter] public CfgParseResult? Result { get; set; }
    [Parameter] public int CurrentStepIndex { get; set; }
    [Parameter] public EventCallback<int> CurrentStepIndexChanged { get; set; }
    [Parameter] public bool ShowCompactStepControls { get; set; }
    [Parameter] public bool SnapMotion { get; set; }

    private CfgDerivationQueueStep? CurrentStep =>
        Result?.QueueSteps is { Count: > 0 } steps
            ? steps[System.Math.Clamp(CurrentStepIndex, 0, steps.Count - 1)]
            : null;

    private Task StepPrev() => CurrentStepIndexChanged.InvokeAsync(System.Math.Max(0, CurrentStepIndex - 1));

    private Task StepNext()
    {
        var max = (Result?.QueueSteps?.Count ?? 1) - 1;
        return CurrentStepIndexChanged.InvokeAsync(System.Math.Min(max, CurrentStepIndex + 1));
    }

    private static string StepStatusLabel(CfgDerivationQueueStep step)
    {
        if (step.IsComplete) return "DERIVED ✓";
        if (step.StepIndex == 0) return "START";
        return step.ProducedSymbols.Count == 0 ? "ε-ERASE" : "EXPAND";
    }

    private static string QueueCellStyle(CfgQueueSymbol item)
    {
        if (item.IsExpandHead)
            return "background: var(--accent-soft); color: var(--accent); border: 1.5px solid var(--accent);";
        if (item.IsNewlyProduced)
            return "background: var(--pill-positive-bg); color: var(--pill-positive-ink); border: 1.5px solid var(--positive);";
        if (!item.IsTerminal)
            return "background: var(--raised); color: var(--text); border: 1.5px solid var(--control);";
        return "background: var(--surface); color: var(--muted); border: 1px solid var(--border);";
    }
}
