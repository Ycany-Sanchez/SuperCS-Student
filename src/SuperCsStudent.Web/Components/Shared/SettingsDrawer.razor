@implements IDisposable
@inject AppStateService AppState
@inject IJSRuntime JS

@if (AppState.SettingsOpen)
{
    <div class="fixed inset-0 z-50 flex justify-end"
         style="background: rgba(0, 0, 0, 0.38);"
         role="dialog"
         aria-modal="true"
         aria-label="Workspace settings"
         @onkeydown="HandleKeyDown"
         @onclick="Close">
        <div class="w-full max-w-sm h-full flex flex-col bp-floating !rounded-none !rounded-l-2xl"
             @onclick:stopPropagation="true">
            <div class="flex items-center justify-between px-5 h-14" style="border-bottom: 1px solid var(--border);">
                <h2 class="text-base font-semibold">Workspace settings</h2>
                <button type="button" class="bp-btn-ghost !h-8 !px-2" @onclick="Close">Close</button>
            </div>

            <div class="flex-1 overflow-y-auto p-5 space-y-6">
                <section class="space-y-2.5">
                    <div class="text-sm font-medium">Appearance</div>
                    <p class="text-xs" style="color: var(--muted);">Switch between Framed Blueprint light mode and True-Black dark mode.</p>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button"
                                class="bp-btn-secondary !h-9"
                                style="@(!AppState.IsDark ? "border-color: var(--accent); background: var(--accent-soft); color: var(--accent);" : "")"
                                @onclick='() => SetTheme("light")'>
                            Light sheet
                        </button>
                        <button type="button"
                                class="bp-btn-secondary !h-9"
                                style="@(AppState.IsDark ? "border-color: var(--accent); background: var(--accent-soft); color: var(--accent);" : "")"
                                @onclick='() => SetTheme("dark")'>
                            True black
                        </button>
                    </div>
                </section>

                <hr style="border-color: var(--border);" />

                <section class="space-y-3">
                    <div class="text-sm font-medium">Formal notation defaults</div>

                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <div class="text-xs font-medium">Empty string display</div>
                            <div class="text-xs" style="color: var(--muted);">Aliases e, ε, λ are always accepted on input.</div>
                        </div>
                        <select class="bp-input !h-8 font-mono text-xs"
                                @bind="AppState.EmptyStringSymbol"
                                @bind:after="AppState.Notify">
                            <option value="e">e</option>
                            <option value="ε">ε</option>
                            <option value="λ">λ</option>
                        </select>
                    </div>

                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <div class="text-xs font-medium">Tape blank symbol</div>
                            <div class="text-xs" style="color: var(--muted);">Used in Turing Machine tape views.</div>
                        </div>
                        <select class="bp-input !h-8 font-mono text-xs"
                                @bind="AppState.BlankTapeSymbol"
                                @bind:after="AppState.Notify">
                            <option value="#">#</option>
                            <option value="␣">␣</option>
                            <option value="_">_</option>
                        </select>
                    </div>
                </section>

                <hr style="border-color: var(--border);" />

                <section class="space-y-2.5">
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-sm font-medium">Instant step transitions</div>
                            <div class="text-xs" style="color: var(--muted);">Skip tween animations during diagram stepping.</div>
                        </div>
                        <input type="checkbox" class="w-4 h-4 accent-[var(--accent)] cursor-pointer"
                               @bind="AppState.SnapMotion"
                               @bind:after="AppState.Notify" />
                    </div>
                </section>
                <hr style="border-color: var(--border);" />

                <section class="space-y-2.5">
                    <div class="text-sm font-medium">Local workspace backup</div>
                    <p class="text-xs" style="color: var(--muted);">
                        Export or restore your local preferences and recent session history as JSON.
                    </p>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" class="bp-btn-secondary !h-8 text-xs whitespace-nowrap" @onclick="ExportWorkspaceJson">
                            Export JSON
                        </button>
                        <label class="bp-btn-secondary !h-8 text-xs whitespace-nowrap cursor-pointer">
                            <span>Import JSON</span>
                            <InputFile OnChange="ImportWorkspaceJson" accept=".json,application/json" class="hidden" />
                        </label>
                    </div>
                    <button type="button" class="bp-btn-ghost w-full !h-8 text-xs" style="border: 1px dashed var(--control);" @onclick="ResetWorkspace">
                        Reset Workspace Defaults
                    </button>
                    @if (!string.IsNullOrWhiteSpace(_workspaceStatus))
                    {
                        <div class="text-xs px-2.5 py-1.5 rounded-md"
                             style="@(_workspaceError ? "background: var(--pill-negative-bg); color: var(--pill-negative-ink);" : "background: var(--pill-positive-bg); color: var(--pill-positive-ink);")">
                            @_workspaceStatus
                        </div>
                    }
                </section>
            </div>

            <div class="px-5 py-3 text-xs" style="border-top: 1px solid var(--border); color: var(--muted);">
                All computation runs 100% locally in .NET 8 with zero external network calls.
            </div>
        </div>
    </div>
}

@code {
    private string? _workspaceStatus;
    private bool _workspaceError;

    protected override void OnInitialized()
    {
        AppState.OnChange += OnAppStateChanged;
    }

    private void OnAppStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AppState.OnChange -= OnAppStateChanged;
    }

    private async Task SetTheme(string theme)
    {
        AppState.SetTheme(theme);
        await JS.InvokeVoidAsync("SuperCs.storage.applyTheme", theme);
    }

    private async Task ExportWorkspaceJson()
    {
        _workspaceError = false;
        var json = AppState.ExportSnapshotJson();
        await JS.InvokeVoidAsync("SuperCs.storage.downloadTextFile", "super-cs-workspace.json", json, "application/json;charset=utf-8");
        _workspaceStatus = $"Exported {AppState.RecentWorkspaces.Count} recent session(s).";
    }

    private async Task ImportWorkspaceJson(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            using var reader = new StreamReader(file.OpenReadStream(maxAllowedSize: 1024 * 1024));
            var json = await reader.ReadToEndAsync();
            if (AppState.TryImportSnapshotJson(json, out var count, out var error))
            {
                await JS.InvokeVoidAsync("SuperCs.storage.applyTheme", AppState.Theme);
                _workspaceError = false;
                _workspaceStatus = $"Restored workspace ({count} session(s)).";
            }
            else
            {
                _workspaceError = true;
                _workspaceStatus = error ?? "Invalid JSON file.";
            }
        }
        catch (Exception ex)
        {
            _workspaceError = true;
            _workspaceStatus = $"Import failed: {ex.Message}";
        }
    }

    private async Task ResetWorkspace()
    {
        AppState.ResetWorkspace();
        await JS.InvokeVoidAsync("SuperCs.storage.removeItem", AppStateService.StorageKey);
        await JS.InvokeVoidAsync("SuperCs.storage.applyTheme", "light");
        _workspaceError = false;
        _workspaceStatus = "Workspace reset to defaults.";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Close();
    }

    private void Close() => AppState.SetSettingsOpen(false);
}
